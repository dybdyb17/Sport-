{% extends 'base.html.twig' %}

{% block title %}Mon profil — SPORT+{% endblock %}

{% block body %}
<div class="container profile-page">

  {# ── HERO PROFIL ── #}
  <div class="profile-hero" data-animate="fade-up">
    <div class="profile-hero-avatar">
      {% if app.user.photoSrc %}
        <img src="{{ app.user.photoSrc }}" alt="{{ app.user.nomComplet }}"
             style="width:100%;height:100%;object-fit:cover;border-radius:inherit;display:block;">
      {% else %}
        {%- set words = app.user.nomComplet|split(' ') -%}
        {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
      {% endif %}
    </div>
    <div class="profile-hero-info">
      <div class="profile-hero-name">{{ app.user.nomComplet }}</div>
      <div class="profile-hero-email">{{ app.user.email }}</div>
      <div class="profile-hero-stats">
        <div class="profile-hero-stat">
          <i class="ti ti-calendar"></i>
          <span>Membre depuis <strong>{{ app.user.createdAt|format_datetime('none', 'none', "MMMM y", locale='fr') }}</strong></span>
        </div>
        {% if app.user.bookings|length > 0 %}
          <div class="profile-hero-stat">
            <i class="ti ti-flame"></i>
            <span><strong>{{ app.user.bookings|length }}</strong> réservation{{ app.user.bookings|length > 1 ? 's' : '' }}</span>
          </div>
        {% endif %}
        {% if app.user.foundingClaim %}
          <div class="profile-hero-stat profile-hero-stat-founding">
            <i class="ti ti-crown"></i>
            <span>{{ app.user.foundingClaim.foundingLabel }}</span>
          </div>
        {% endif %}
      </div>
    </div>
    <a href="{{ path('app_espace_client') }}" class="btn btn-secondary btn-sm profile-hero-back">
      <i class="ti ti-arrow-left"></i> Mon espace
    </a>
  </div>

  {# ── TABS NAV ── #}
  <nav class="profile-tabs">
    <a href="#informations" class="profile-tab">
      <i class="ti ti-user"></i> Informations
    </a>
    <a href="#preferences" class="profile-tab">
      <i class="ti ti-moon-stars"></i> Préférences nocturnes
    </a>
    <a href="#securite" class="profile-tab">
      <i class="ti ti-lock"></i> Sécurité
    </a>
  </nav>

  {# ── SECTION 1 : INFORMATIONS ── #}
  <section id="informations" class="profile-section" data-animate="fade-up">
    <div class="form-card">
      <div class="profile-section-head">
        <i class="ti ti-user profile-section-icon"></i>
        <div>
          <h2 class="profile-section-title">Mes informations</h2>
          <p class="profile-section-sub">Tes données de contact, mises à jour quand tu veux.</p>
        </div>
      </div>

      {{ form_start(profilForm, {'attr': {'enctype': 'multipart/form-data'}}) }}

        {# Bloc avatar — rendering manuel des inputs pour bypass le style
           form-theme (labels Barlow gold uppercase) qui rendait la case
           "retirer" moche et mal placée. On garde les noms générés par
           Symfony via vars.full_name pour que la validation reste OK. #}
        <div class="form-field profile-avatar-block">
          <label class="form-label" for="{{ profilForm.avatar.vars.id }}">Photo de profil</label>
          <div class="profile-avatar-editor">
            <div class="profile-avatar-preview" data-avatar-preview>
              {% if app.user.photoSrc %}
                <img src="{{ app.user.photoSrc }}" alt="Photo actuelle">
              {% else %}
                <span class="profile-avatar-initial">{{ app.user.initial }}</span>
              {% endif %}
            </div>
            <div class="profile-avatar-controls">
              <input type="file"
                     id="{{ profilForm.avatar.vars.id }}"
                     name="{{ profilForm.avatar.vars.full_name }}"
                     accept="image/jpeg,image/png,image/webp"
                     data-avatar-input>
              <p class="profile-avatar-help">JPG, PNG ou WebP · 5 Mo max · redimensionnée à 400×400.</p>
              {{ form_errors(profilForm.avatar) }}
              {% if app.user.photoSrc %}
                <label class="profile-avatar-remove" for="{{ profilForm.removeAvatar.vars.id }}">
                  <input type="checkbox"
                         id="{{ profilForm.removeAvatar.vars.id }}"
                         name="{{ profilForm.removeAvatar.vars.full_name }}"
                         value="1">
                  <span>Retirer ma photo actuelle</span>
                </label>
              {% endif %}
            </div>
          </div>
          {# Marque avatar + removeAvatar comme rendus pour que form_end() ne
             les ré-affiche pas en double à la fin du form. #}
          {% do profilForm.avatar.setRendered %}
          {% do profilForm.removeAvatar.setRendered %}
        </div>

        <div class="form-field">
          {{ form_label(profilForm.nomComplet) }}
          {{ form_widget(profilForm.nomComplet) }}
          {{ form_errors(profilForm.nomComplet) }}
        </div>
        <div class="form-field">
          {{ form_label(profilForm.email) }}
          {{ form_widget(profilForm.email) }}
          {{ form_errors(profilForm.email) }}
        </div>
        <div class="form-field">
          {{ form_label(profilForm.phone) }}
          {{ form_widget(profilForm.phone) }}
          {{ form_errors(profilForm.phone) }}
        </div>
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-device-floppy"></i> Enregistrer mes infos
        </button>
      {{ form_end(profilForm) }}

      {# Modale de recadrage — s'ouvre au changement du champ file, permet
         de choisir la zone visible et de zoomer. Sortie forcée en carré
         400x400 pour matcher le resize serveur. #}
      <div id="avatar-crop-modal" class="avatar-crop-modal" hidden aria-hidden="true">
        <div class="avatar-crop-backdrop" data-crop-close></div>
        <div class="avatar-crop-card" role="dialog" aria-modal="true" aria-labelledby="avatar-crop-title">
          <div class="avatar-crop-head">
            <h3 id="avatar-crop-title">Recadre ta photo</h3>
            <button type="button" class="avatar-crop-close" data-crop-close aria-label="Fermer">
              <i class="ti ti-x"></i>
            </button>
          </div>
          <div class="avatar-crop-body">
            <div class="avatar-crop-stage">
              <img id="avatar-crop-target" alt="">
            </div>
            <p class="avatar-crop-hint">
              <i class="ti ti-info-circle"></i>
              Déplace l'image, pinche ou utilise la molette pour zoomer. La zone dorée sera ta photo finale.
            </p>
          </div>
          <div class="avatar-crop-actions">
            <button type="button" class="btn btn-secondary" data-crop-close>Annuler</button>
            <button type="button" class="btn btn-primary" data-crop-apply>
              <i class="ti ti-check"></i> Valider le recadrage
            </button>
          </div>
        </div>
      </div>

      {# Cropper.js chargé UNIQUEMENT si on est sur la page profil (pas dans
         la base) — évite de polluer les autres pages avec 30 KB de JS. #}
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">
      <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js" defer></script>
      <script defer>
        (function() {
          var input   = document.querySelector('[data-avatar-input]');
          var preview = document.querySelector('[data-avatar-preview]');
          var modal   = document.getElementById('avatar-crop-modal');
          var target  = document.getElementById('avatar-crop-target');
          if (!input || !preview || !modal || !target) return;

          var cropper = null;
          var pendingFileName = 'avatar.webp';

          function openModal() {
            modal.hidden = false;
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
          function closeModal() {
            modal.hidden = true;
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (cropper) { cropper.destroy(); cropper = null; }
          }

          input.addEventListener('change', function(e) {
            var file = e.target.files && e.target.files[0];
            if (!file) return;
            pendingFileName = file.name || 'avatar';
            var reader = new FileReader();
            reader.onload = function(ev) {
              target.src = ev.target.result;
              openModal();
              // Attendre que Cropper soit chargé (defer)
              var initCropper = function() {
                if (typeof Cropper === 'undefined') { setTimeout(initCropper, 50); return; }
                if (cropper) cropper.destroy();
                cropper = new Cropper(target, {
                  aspectRatio: 1,
                  viewMode: 1,
                  autoCropArea: 0.9,
                  responsive: true,
                  background: false,
                  guides: false,
                  dragMode: 'move',
                  cropBoxResizable: false,
                  cropBoxMovable: false,
                });
              };
              initCropper();
            };
            reader.readAsDataURL(file);
          });

          modal.addEventListener('click', function(e) {
            if (e.target.closest('[data-crop-close]')) {
              closeModal();
              input.value = ''; // reset au cas où l'utilisateur annule
            }
            if (e.target.closest('[data-crop-apply]')) {
              if (!cropper) return;
              cropper.getCroppedCanvas({
                width: 400,
                height: 400,
                imageSmoothingQuality: 'high',
              }).toBlob(function(blob) {
                if (!blob) { closeModal(); return; }
                var croppedName = pendingFileName.replace(/\.[^.]+$/, '') + '.webp';
                var file = new File([blob], croppedName, { type: 'image/webp' });
                var dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                // Update preview visible dans le form
                var url = URL.createObjectURL(blob);
                preview.innerHTML = '<img src="' + url + '" alt="Aperçu">';
                closeModal();
              }, 'image/webp', 0.9);
            }
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && !modal.hidden) {
              closeModal();
              input.value = '';
            }
          });
        })();
      </script>
    </div>
  </section>

  {# ── SECTION 2 : PRÉFÉRENCES NOCTURNES ── #}
  <section id="preferences" class="profile-section" data-animate="fade-up">
    <div class="form-card profile-card-night">
      <div class="profile-section-head">
        <i class="ti ti-moon-stars profile-section-icon profile-section-icon-green"></i>
        <div>
          <h2 class="profile-section-title">Préférences nocturnes</h2>
          <p class="profile-section-sub">Aide-nous à personnaliser ton expérience. Ces infos sont visibles par tes coachs.</p>
        </div>
      </div>

      {% import '_macros/form_dropdown.html.twig' as ui %}
      {{ form_start(preferencesForm) }}
        <div class="profile-pref-grid">
          <div class="form-field">
            {{ form_label(preferencesForm.preferredTimeSlot) }}
            {{ ui.formSelect(preferencesForm.preferredTimeSlot) }}
            {{ form_errors(preferencesForm.preferredTimeSlot) }}
          </div>
          <div class="form-field">
            {{ form_label(preferencesForm.preferredCoach) }}
            {{ ui.formSelect(preferencesForm.preferredCoach) }}
            {{ form_errors(preferencesForm.preferredCoach) }}
          </div>
          <div class="form-field">
            {{ form_label(preferencesForm.goal) }}
            {{ ui.formSelect(preferencesForm.goal) }}
            {{ form_errors(preferencesForm.goal) }}
          </div>
        </div>
        <div class="form-field" style="margin-top:8px;">
          {{ form_label(preferencesForm.coachNotes) }}
          {{ form_widget(preferencesForm.coachNotes) }}
          {{ form_errors(preferencesForm.coachNotes) }}
        </div>
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-moon"></i> Enregistrer mes préférences
        </button>
      {{ form_end(preferencesForm) }}
    </div>
  </section>

  {# ── SECTION 3 : SÉCURITÉ ── #}
  <section id="securite" class="profile-section" data-animate="fade-up">
    <div class="form-card">
      <div class="profile-section-head">
        <i class="ti ti-lock profile-section-icon"></i>
        <div>
          <h2 class="profile-section-title">Mot de passe</h2>
          <p class="profile-section-sub">Pour ta sécurité, modifie ton mot de passe régulièrement.</p>
        </div>
      </div>

      {{ form_start(passwordForm) }}
        <div class="form-field">
          {{ form_label(passwordForm.currentPassword) }}
          {{ form_widget(passwordForm.currentPassword) }}
          {{ form_errors(passwordForm.currentPassword) }}
        </div>
        <div class="form-field">
          {{ form_label(passwordForm.newPassword.first) }}
          {{ form_widget(passwordForm.newPassword.first) }}
          {{ form_errors(passwordForm.newPassword.first) }}
        </div>
        <div class="form-field">
          {{ form_label(passwordForm.newPassword.second) }}
          {{ form_widget(passwordForm.newPassword.second) }}
          {{ form_errors(passwordForm.newPassword.second) }}
        </div>
        {{ form_errors(passwordForm.newPassword) }}
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-key"></i> Changer le mot de passe
        </button>
      {{ form_end(passwordForm) }}
    </div>
  </section>

</div>
{% endblock %}
