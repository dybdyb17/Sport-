{% extends 'base.html.twig' %}
{% import '_macros/admin_shortcut.html.twig' as adm %}

{% block title %}Mon RDV — {{ booking.reference }} — SPORT+{% endblock %}

{% block body %}
{{ adm.floating(path('app_admin_booking_peek', {ref: booking.reference}), 'Voir ce booking en admin', 'ti-eye-bolt') }}
<div class="container" style="padding-top:32px;padding-bottom:80px;max-width:560px;">

  <a href="{{ path('app_espace_client') }}" class="btn btn-ghost btn-sm" style="margin-bottom:20px;">
    <i class="ti ti-arrow-left"></i> Mon espace
  </a>

  <div class="rdv-card" data-animate="fade-up">
    <div class="rdv-head">
      <span class="status-badge {{ booking.status }}"><i class="ti {{ booking.statutIcon }}"></i>{{ booking.statutLabel }}</span>
      <div class="rdv-ref">{{ booking.reference }}</div>
    </div>

    <h1 class="rdv-title">Mon rendez-vous</h1>

    {# Logique d'affichage du QR centralisée dans Booking::isQrUnlocked() #}
    {% set qrUnlocked = booking.isQrUnlocked %}

    {% if booking.status == 'pending' %}
      <p class="rdv-sub">En attente de validation par le coach. Tu recevras une notification dès qu'il aura confirmé.</p>
      <div class="rdv-qr-blocked">
        <i class="ti ti-hourglass" style="font-size:48px;color:var(--gold);"></i>
        <div class="rdv-qr-blocked-title">QR en attente</div>
        <div class="rdv-qr-blocked-sub">Le QR de check-in apparaîtra ici une fois ta séance confirmée par le coach.</div>
      </div>
    {% elseif booking.status in ['refused', 'cancelled'] %}
      <p class="rdv-sub">Cette séance n'aura pas lieu — aucun QR à présenter.</p>
    {% elseif qrUnlocked %}
      <p class="rdv-sub">Présente cet écran à l'accueil quand tu arrives à la salle.</p>
      <div class="rdv-qr-wrap">
        <div id="rdv-qr" data-checkin-url="{{ url('app_admin_checkin_validate', {reference: booking.reference}) }}"></div>
      </div>
      <p class="rdv-qr-help">L'accueil scanne ce code pour valider ton arrivée.</p>
    {% else %}
      {# Confirmed + Stripe + non payé : QR bloqué jusqu'au paiement #}
      <p class="rdv-sub">Ton QR sera débloqué dès que ton paiement en ligne sera vérifié.</p>
      <div class="rdv-qr-blocked">
        <i class="ti ti-lock" style="font-size:48px;color:var(--green);"></i>
        <div class="rdv-qr-blocked-title">QR verrouillé — Paiement requis</div>
        <div class="rdv-qr-blocked-sub">
          Tu as choisi de <strong>régler en ligne</strong>. Lance le paiement Stripe ci-dessous — ton QR de check-in se débloquera automatiquement dès validation.
        </div>
        <form method="post" action="{{ path('app_booking_checkout_stripe', {ref: booking.reference}) }}" style="margin:0;">
          <input type="hidden" name="_token" value="{{ csrf_token('booking-stripe-' ~ booking.id) }}">
          <button type="submit" class="rdv-qr-blocked-cta">
            <i class="ti ti-credit-card-pay"></i> Régler {{ booking.prixFormatted }} en ligne
          </button>
        </form>
        <p style="margin-top:14px;font-size:12px;color:var(--text-dim);line-height:1.5;">
          <i class="ti ti-info-circle" style="vertical-align:middle;"></i>
          Paiement sécurisé Stripe. Tu peux aussi régler au coach sur place si tu préfères.
        </p>
      </div>
    {% endif %}

    <div class="rdv-details">
      <div class="rdv-detail">
        <div class="rdv-detail-label"><i class="ti ti-user-circle"></i> Coach</div>
        <div class="rdv-detail-value">{{ booking.coach.nomComplet }}</div>
      </div>
      <div class="rdv-detail">
        <div class="rdv-detail-label"><i class="ti ti-calendar"></i> Date</div>
        <div class="rdv-detail-value">
          {{ booking.startAt|date('d/m/Y') }}
          <div style="font-size:13px;color:var(--text-dim);margin-top:2px;">
            <i class="ti ti-clock" style="font-size:13px;color:var(--gold-dim);"></i>
            {{ booking.timeRangeFormatted }} <span style="color:var(--gold);">· {{ booking.durationFormatted }}</span>
          </div>
        </div>
      </div>
      <div class="rdv-detail">
        <div class="rdv-detail-label"><i class="ti ti-clock"></i> Format</div>
        <div class="rdv-detail-value">{{ booking.offerLabel }}</div>
      </div>
      <div class="rdv-detail rdv-detail-price">
        {% if booking.coveredBy == 'founding' %}
          <div class="rdv-detail-label"><i class="ti ti-crown"></i> Couverture</div>
          <div class="rdv-detail-value" style="color:var(--gold);">Incluse — Fondateur</div>
        {% elseif booking.coveredBy == 'subscription' and booking.subscription %}
          <div class="rdv-detail-label"><i class="ti ti-check"></i> Couverture</div>
          <div class="rdv-detail-value" style="color:var(--green);">Incluse — {{ booking.subscription.packType.label }}</div>
        {% else %}
          <div class="rdv-detail-label"><i class="ti ti-cash"></i> À régler</div>
          <div class="rdv-detail-value">{{ booking.prixFormatted }}</div>
        {% endif %}
      </div>
    </div>

    {# ── Confirmation paiement par le client (anti-fraude) ── #}
    {% if booking.isPaymentAwaitingClientConfirmation %}
      <div class="rdv-payment-check" style="margin-top:24px;padding:18px;border:1px solid var(--gold);
                                            border-radius:var(--radius);background:rgba(212,175,55,.06);">
        <div style="display:flex;align-items:flex-start;gap:12px;">
          <i class="ti ti-alert-triangle" style="color:var(--gold);font-size:24px;flex-shrink:0;margin-top:2px;"></i>
          <div style="flex:1;">
            <strong style="display:block;color:var(--white);font-family:'Barlow Condensed',sans-serif;
                           font-size:16px;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">
              Confirme ton paiement
            </strong>
            <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:var(--text-soft);">
              Le coach a déclaré que tu as réglé cette séance
              <strong style="color:var(--white);">{{ booking.paymentMethod == 'cash' ? 'en espèces' : 'par carte bancaire' }}</strong>
              pour un montant de <strong style="color:var(--gold);">{{ booking.prixFormatted }}</strong>.
              Confirme ou conteste pour qu'on garde une trace claire.
            </p>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
              <form method="post" action="{{ path('app_booking_payment_confirm', {ref: booking.reference}) }}" style="margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('payment_confirm_' ~ booking.id) }}">
                <button type="submit" class="btn btn-primary btn-sm"
                        data-confirm-title="Confirmer ton paiement ?"
                        data-confirm="Tu confirmes avoir réglé {{ booking.prixFormatted }} en {{ booking.paymentMethod == 'cash' ? 'espèces' : 'carte bancaire' }} pour cette séance."
                        data-confirm-button="Oui, je confirme">
                  <i class="ti ti-check"></i> J'ai bien payé
                </button>
              </form>
              <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('dispute-form-{{ booking.id }}').hidden = false; this.hidden = true;">
                <i class="ti ti-x"></i> Je n'ai pas payé / désaccord
              </button>
            </div>
            <form method="post" action="{{ path('app_booking_payment_dispute', {ref: booking.reference}) }}"
                  id="dispute-form-{{ booking.id }}" hidden style="margin-top:14px;">
              <input type="hidden" name="_token" value="{{ csrf_token('payment_dispute_' ~ booking.id) }}">
              <label style="display:block;font-size:12px;color:var(--text-dim);margin-bottom:6px;">
                Explique pourquoi (l'admin SPORT+ va te recontacter)
              </label>
              <textarea name="reason" rows="3" minlength="8" maxlength="2000" required
                        class="form-control" style="width:100%;"
                        placeholder="Ex : je n'ai pas réglé cette séance / le montant ne correspond pas..."></textarea>
              <div style="display:flex;gap:8px;margin-top:10px;">
                <button type="submit" class="btn btn-danger btn-sm"
                        data-confirm-title="Envoyer ta contestation ?"
                        data-confirm="Ta contestation sera transmise immédiatement à l'admin SPORT+. Tu seras recontacté sous 24 h."
                        data-confirm-button="Envoyer ma contestation"
                        data-confirm-danger="true">
                  <i class="ti ti-send"></i> Envoyer
                </button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="this.closest('form').hidden = true; this.closest('form').previousElementSibling.querySelector('button[type=button]').hidden = false;">
                  Annuler
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    {% elseif booking.isPaymentConfirmedByClient %}
      <div class="rdv-payment-ok" style="margin-top:16px;padding:12px 16px;border:1px solid rgba(46,204,113,.35);
                                         border-radius:var(--radius);background:rgba(46,204,113,.08);
                                         color:var(--green);font-size:13px;">
        <i class="ti ti-shield-check"></i> Paiement confirmé le {{ booking.paymentClientConfirmedAt|date('d/m/Y à H\\hi') }} — merci.
      </div>
    {% elseif booking.isPaymentDisputed %}
      <div class="rdv-payment-disputed" style="margin-top:16px;padding:12px 16px;border:1px solid #ff6b6b;
                                               border-radius:var(--radius);background:rgba(255,80,80,.08);
                                               color:#ff8a8a;font-size:13px;">
        <i class="ti ti-alert-octagon"></i> Contestation enregistrée le {{ booking.paymentClientDisputedAt|date('d/m/Y à H\\hi') }} — un admin va te recontacter.
      </div>
    {% endif %}

    {# ── Statut paiement ── #}
    {% set intent = booking.intendedPaymentMethod %}
    {% set declared = booking.paymentMethod %}
    {% set methodLabels = {
      'cash':   {'icon': 'ti-cash',        'name': 'Espèces',        'color': 'gold'},
      'card':   {'icon': 'ti-credit-card', 'name': 'Carte bancaire', 'color': 'gold'},
      'stripe': {'icon': 'ti-lock',        'name': 'En ligne (Stripe)', 'color': 'green'}
    } %}

    {% set isPending   = booking.status == 'pending' %}
    {% set isConfirmed = booking.status == 'confirmed' %}
    {% set isRefused   = booking.status == 'refused' or booking.status == 'cancelled' %}

    <div class="rdv-pay">
      <div class="rdv-pay-head">
        <span class="rdv-pay-eyebrow"><i class="ti ti-credit-card"></i> Paiement</span>
        {% if booking.isPaid %}
          {% set paidLabel = declared == 'stripe' ? 'Payé en ligne' : 'Confirmé par le coach' %}
          <span class="rdv-pay-status rdv-pay-status-ok"><i class="ti ti-check"></i> {{ paidLabel }}</span>
        {% elseif isRefused %}
          <span class="rdv-pay-status rdv-pay-status-wait"><i class="ti ti-x"></i> Séance annulée</span>
        {% elseif isPending %}
          <span class="rdv-pay-status rdv-pay-status-todo"><i class="ti ti-hourglass"></i> Bloqué — en attente du coach</span>
        {% elseif booking.startAt < date() %}
          <span class="rdv-pay-status rdv-pay-status-wait"><i class="ti ti-clock"></i> En attente de validation</span>
        {% else %}
          <span class="rdv-pay-status rdv-pay-status-todo"><i class="ti ti-hourglass"></i> À régler le jour J</span>
        {% endif %}
      </div>

      {# ── État terminal "PAYÉ" : on l'isole en premier pour ne pas mélanger
            avec les branches "à régler". S'applique aussi bien à un paiement
            Stripe automatique (webhook) qu'à un encaissement cash/CB déclaré
            par le coach. Aucun bouton ici — la séance est réglée. ── #}
      {% if booking.isPaid %}
        {% set paidLabel = methodLabels[declared] ?? null %}
        <div class="rdv-pay-chip rdv-pay-chip-green">
          <i class="ti ti-check"></i>
          <div>
            <div class="rdv-pay-chip-name">
              {{ booking.prixFormatted }} — Payé{% if paidLabel %} {{ declared == 'stripe' ? 'en ligne (Stripe)' : ('en ' ~ paidLabel.name|lower) }}{% endif %}
            </div>
            <div class="rdv-pay-chip-sub">
              {% if booking.paymentDeclaredAt %}
                Confirmé le {{ booking.paymentDeclaredAt|date('d/m/Y \\à H\\hi') }}
              {% else %}
                Paiement enregistré
              {% endif %}
            </div>
          </div>
        </div>
        {% if declared == 'stripe' %}
          <p class="rdv-pay-help" style="color:var(--green);font-size:13px;">
            <i class="ti ti-shield-check" style="color:var(--green);"></i>
            Ton QR de check-in est débloqué — présente-le à l'accueil le jour J.
          </p>
        {% endif %}

      {% elseif intent %}
        {% set lbl = methodLabels[intent] %}
        <div class="rdv-pay-chip rdv-pay-chip-{{ lbl.color }}">
          <i class="ti {{ lbl.icon }}"></i>
          <div>
            <div class="rdv-pay-chip-name">{{ lbl.name }}</div>
            <div class="rdv-pay-chip-sub">
              {% if intent == 'stripe' %}Paiement en ligne via Stripe (carte bancaire){% else %}Sur place, au coach{% endif %}
            </div>
          </div>
        </div>

        {# ── Tant que le coach n'a pas validé, on n'autorise PAS le paiement ── #}
        {% if isPending %}
          <p class="rdv-pay-help" style="background:rgba(200,169,81,.06);border:1px dashed rgba(200,169,81,.3);border-radius:var(--radius);padding:12px 14px;margin-top:12px;">
            <i class="ti ti-lock" style="color:var(--gold);"></i>
            <strong>Le paiement sera disponible une fois ton coach aura confirmé la séance.</strong> Tu recevras une notification dès validation et tu pourras
            {% if intent == 'stripe' %}régler en ligne via Stripe en quelques secondes{% else %}{{ intent == 'cash' ? 'prévoir ton paiement en espèces' : 'préparer ton paiement par carte' }}{% endif %}.
          </p>
        {% elseif isRefused %}
          {% if booking.refusalReason and booking.status == 'refused' %}
            <div class="rdv-refusal">
              <div class="rdv-refusal-head">
                <i class="ti ti-message-circle-2"></i>
                <strong>Message de {{ booking.coach.nomComplet }}</strong>
              </div>
              <p class="rdv-refusal-msg">« {{ booking.refusalReason }} »</p>
              <a href="{{ path('app_booking_new') }}" class="rdv-refusal-cta">
                <i class="ti ti-calendar-plus"></i> Proposer un autre créneau
              </a>
            </div>
          {% else %}
            <p class="rdv-pay-help" style="color:var(--text-dim);">
              <i class="ti ti-info-circle"></i>
              La séance a été {{ booking.status == 'refused' ? 'refusée par le coach' : 'annulée' }}, aucun paiement n'est attendu.
            </p>
          {% endif %}
        {% elseif booking.isAwaitingOnlinePayment %}
          {# Confirmed + Stripe + pas encore payé → CTA paiement en ligne #}
          <form method="post" action="{{ path('app_booking_checkout_stripe', {ref: booking.reference}) }}" style="margin:0;">
            <input type="hidden" name="_token" value="{{ csrf_token('booking-stripe-' ~ booking.id) }}">
            <button type="submit" class="rdv-pay-link">
              <i class="ti ti-credit-card-pay"></i> Régler {{ booking.prixFormatted }} en ligne via Stripe
            </button>
          </form>
          <p class="rdv-pay-help">Paiement sécurisé Stripe. Tu peux aussi régler au coach sur place si tu préfères (espèces ou CB).</p>
        {% elseif booking.coveredBy in ['subscription', 'founding'] %}
          {# Séance couverte (pack ou Fondateur) — pas de paiement à prévoir #}
          <p class="rdv-pay-help" style="color:var(--green);">
            <i class="ti ti-check" style="color:var(--green);"></i>
            Cette séance est <strong style="color:var(--white);">déjà couverte</strong> par
            {{ booking.coveredBy == 'founding' ? 'ton offre Fondateur' : 'ton pack ' ~ booking.subscription.packType.label }} — aucun paiement à prévoir le jour J.
          </p>
        {% else %}
          {# Confirmed + cash/card → instructions sur place #}
          <p class="rdv-pay-help">
            <i class="ti ti-info-circle"></i>
            Prévois <strong>{{ booking.prixFormatted }}</strong> {{ intent == 'cash' ? 'en espèces' : 'par carte' }} pour ton coach.
          </p>
        {% endif %}
      {% else %}
        <p class="rdv-pay-help">
          <i class="ti ti-info-circle"></i>
          3 modes possibles : <strong>Espèces</strong>, <strong>CB</strong> (sur place avec le coach) ou <strong>Stripe</strong> (en ligne, carte bancaire).
          {% if isPending %}<br>Le paiement sera ouvert une fois la séance confirmée.{% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js"></script>
<script>
  (function() {
    const wrap = document.getElementById('rdv-qr');
    if (!wrap) return;
    const url = wrap.dataset.checkinUrl;
    const qr = qrcode(0, 'M');
    qr.addData(url);
    qr.make();
    wrap.innerHTML = qr.createImgTag(6, 8);
    const img = wrap.querySelector('img');
    if (img) {
      img.style.background = '#fff';
      img.style.padding = '12px';
      img.style.borderRadius = '12px';
      img.style.display = 'block';
      img.style.margin = '0 auto';
      img.style.width = '100%';
      img.style.height = 'auto';
    }
  })();
</script>

{% endblock %}
