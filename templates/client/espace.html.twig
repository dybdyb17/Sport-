{% extends 'base.html.twig' %}

{% block title %}Mon espace — SPORT+{% endblock %}

{% block body %}
{% set phoneMissing = app.user.phone is empty %}
{% set hasAction = actionAttente or phoneMissing %}

<div class="container espace-page">

  {# ── DÉCOR LINE ART LATÉRAL ANIMÉ — ≥1100px ──
     Structure double-<g> : l'extérieur (.deco-anim-N) porte l'animation
     CSS (translateY relatif), l'intérieur garde le translate de position. #}
  <div class="espace-deco" aria-hidden="true">
    <svg class="espace-deco-svg espace-deco-svg--left" viewBox="0 0 200 1100" preserveAspectRatio="xMidYMid meet">
      {# Haltère stylisé — flottement haut #}
      <g class="deco-anim-1">
        <g transform="translate(100 180)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linecap="round">
          <rect x="-44" y="-5" width="88" height="10" rx="3"/>
          <rect x="-62" y="-22" width="14" height="44" rx="3"/>
          <rect x="48"  y="-22" width="14" height="44" rx="3"/>
          <rect x="-78" y="-30" width="14" height="60" rx="3"/>
          <rect x="64"  y="-30" width="14" height="60" rx="3"/>
        </g>
      </g>

      {# Petit cercle décoratif — spawn fade #}
      <g class="deco-anim-2">
        <g transform="translate(60 330)" fill="none" stroke="#C8A951" stroke-width="1.4">
          <circle cx="0" cy="0" r="14"/>
          <circle cx="0" cy="0" r="5"/>
        </g>
      </g>

      {# Cible / target — spawn fade #}
      <g class="deco-anim-3">
        <g transform="translate(100 460)" fill="none" stroke="#C8A951" stroke-width="1.5">
          <circle cx="0" cy="0" r="50"/>
          <circle cx="0" cy="0" r="34"/>
          <circle cx="0" cy="0" r="18"/>
          <line x1="-62" y1="0" x2="-54" y2="0" stroke-linecap="round"/>
          <line x1="54"  y1="0" x2="62"  y2="0" stroke-linecap="round"/>
          <line x1="0" y1="-62" x2="0" y2="-54" stroke-linecap="round"/>
          <line x1="0" y1="54"  x2="0" y2="62"  stroke-linecap="round"/>
        </g>
      </g>

      {# Disques empilés — flottement bas #}
      <g class="deco-anim-4">
        <g transform="translate(100 740)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linecap="round">
          <ellipse cx="0" cy="0"  rx="46" ry="10"/>
          <ellipse cx="0" cy="18" rx="46" ry="10"/>
          <ellipse cx="0" cy="36" rx="46" ry="10"/>
          <line x1="-46" y1="0" x2="-46" y2="36"/>
          <line x1="46"  y1="0" x2="46"  y2="36"/>
        </g>
      </g>

      {# Triangle bas — flottement haut #}
      <g class="deco-anim-5">
        <g transform="translate(100 980)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linejoin="round">
          <polygon points="0,-22 22,18 -22,18"/>
        </g>
      </g>
    </svg>

    <svg class="espace-deco-svg espace-deco-svg--right" viewBox="0 0 200 1100" preserveAspectRatio="xMidYMid meet">
      {# Kettlebell — flottement bas #}
      <g class="deco-anim-6">
        <g transform="translate(100 200)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M -22,-30 Q -22,-44 0,-44 Q 22,-44 22,-30 L 22,-22 L 30,-15 Q 38,-5 38,15 Q 38,42 0,42 Q -38,42 -38,15 Q -38,-5 -30,-15 L -22,-22 Z"/>
          <ellipse cx="0" cy="-30" rx="16" ry="3"/>
        </g>
      </g>

      {# Croix décorative — spawn fade #}
      <g class="deco-anim-7">
        <g transform="translate(140 360)" fill="none" stroke="#C8A951" stroke-width="1.4" stroke-linecap="round">
          <line x1="-10" y1="-10" x2="10" y2="10"/>
          <line x1="10"  y1="-10" x2="-10" y2="10"/>
          <circle cx="0" cy="0" r="16"/>
        </g>
      </g>

      {# Pulse / heartbeat — spawn fade #}
      <g class="deco-anim-8">
        <g transform="translate(20 500)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="0,0 50,0 70,-36 90,40 110,-24 130,18 150,0 200,0"/>
        </g>
      </g>

      {# Chrono — flottement haut #}
      <g class="deco-anim-9">
        <g transform="translate(100 760)" fill="none" stroke="#C8A951" stroke-width="1.5" stroke-linecap="round">
          <circle cx="0" cy="0" r="36"/>
          <rect x="-9" y="-50" width="18" height="6" rx="1"/>
          <line x1="0" y1="0" x2="0" y2="-24"/>
          <circle cx="0" cy="0" r="2.5" fill="#C8A951"/>
        </g>
      </g>

      {# Cercle final — flottement bas #}
      <g class="deco-anim-10">
        <g transform="translate(100 990)" fill="none" stroke="#C8A951" stroke-width="1.5">
          <circle cx="0" cy="0" r="26"/>
          <circle cx="0" cy="0" r="10"/>
        </g>
      </g>
    </svg>
  </div>

  {# ══════════════════════════════════════════════════════════════════════
     A. BANNIÈRE D'ACTION CONTEXTUELLE — n'apparaît QUE si action à faire
     ══════════════════════════════════════════════════════════════════════ #}
  {% if actionAttente %}
    {% set coachPrenomBan = actionAttente.coach.nomComplet|split(' ')|first %}
    <a href="{{ path('app_espace_client_rdv', {reference: actionAttente.reference}) }}" class="action-banner action-banner--payment" data-animate="fade-down">
      <div class="action-banner-icon"><i class="ti ti-credit-card-pay"></i></div>
      <div class="action-banner-body">
        <strong>Une séance attend ton paiement</strong>
        <span>Ta séance avec {{ coachPrenomBan }} le {{ actionAttente.startAt|date('d/m') }} à {{ actionAttente.startAt|date('H\\hi') }} — règle en ligne pour débloquer ton QR.</span>
      </div>
      <i class="ti ti-chevron-right action-banner-chevron"></i>
    </a>
  {% elseif phoneMissing %}
    <a href="{{ path('app_espace_client_profil') }}" class="action-banner action-banner--profile" data-animate="fade-down">
      <div class="action-banner-icon"><i class="ti ti-phone-plus"></i></div>
      <div class="action-banner-body">
        <strong>Complète ton profil</strong>
        <span>Ajoute ton numéro de téléphone pour que ton coach puisse te joindre.</span>
      </div>
      <i class="ti ti-chevron-right action-banner-chevron"></i>
    </a>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════════════
     HERO — message adaptatif selon l'état
     ══════════════════════════════════════════════════════════════════════ #}
  <div class="espace-hero" data-animate="fade-up">
    <div class="espace-hero-text">
      <h1 class="espace-hero-title">
        {{ greeting }} {{ app.user.nomComplet|split(' ')|first }}
        <span class="espace-hero-wave" aria-hidden="true"><i class="ti ti-hand-three-fingers"></i></span>
      </h1>
      <p class="espace-hero-message">
        <i class="ti {{ heroIcon }} espace-hero-icon" aria-hidden="true"></i>
        {{ heroMessage }}
      </p>
    </div>
    <div class="espace-hero-actions">
      <a href="{{ path('app_booking_new') }}" class="btn btn-primary">
        <i class="ti ti-calendar-plus"></i> Réserver une séance
      </a>
      <a href="{{ path('app_espace_client_profil') }}" class="btn btn-secondary">
        <i class="ti ti-user-cog"></i> Mon profil
      </a>
    </div>
  </div>

  {# Raccourcis tactiles — visibles surtout sur mobile, sans remplacer la structure existante. #}
  <nav class="client-quick-actions" aria-label="Raccourcis de mon espace" data-animate="fade-up">
    <a href="{{ path('app_booking_new') }}" class="client-quick-action">
      <i class="ti ti-calendar-plus"></i>
      <span>Réserver</span>
    </a>
    {% if prochaine %}
      <a href="{{ path('app_espace_client_rdv', {reference: prochaine.reference}) }}" class="client-quick-action">
        <i class="ti ti-ticket"></i>
        <span>Mon RDV</span>
      </a>
    {% endif %}
    <a href="{{ path('app_espace_client_packs') }}" class="client-quick-action">
      <i class="ti ti-barbell"></i>
      <span>Mes packs</span>
    </a>
    <a href="{{ path('app_espace_client_history') }}" class="client-quick-action">
      <i class="ti ti-history"></i>
      <span>Historique</span>
    </a>
    <a href="{{ path('app_espace_client_profil') }}" class="client-quick-action">
      <i class="ti ti-user-cog"></i>
      <span>Profil</span>
    </a>
  </nav>

  {# ══════════════════════════════════════════════════════════════════════
     TICKET PROCHAINE SÉANCE — 3 états : en attente / à régler / prête
     ══════════════════════════════════════════════════════════════════════ #}
  {% if prochaine %}
    {% set coachPhoto = prochaine.coach.photoSrc %}
    {% set coachPrenom = prochaine.coach.nomComplet|split(' ')|first %}
    {% set isPending = prochaine.status == 'pending' %}
    {% set isAwaitingPayment = prochaine.isAwaitingOnlinePayment %}
    {% set isCheckedIn = prochaine.checkinAt is not null %}
    {# isReady = QR à afficher UNIQUEMENT si pas encore scanné à l'accueil.
       Une fois le check-in fait, l'état "checked-in" prime : le QR n'a plus
       d'utilité, on montre à la place "Arrivée validée ✓". #}
    {% set isReady = prochaine.isQrUnlocked and not isCheckedIn %}

    <div class="session-ticket {{ isPending ? 'state-pending' : (isAwaitingPayment ? 'state-payment' : (isCheckedIn ? 'state-checked-in' : 'state-ready')) }}"
         data-animate="fade-up" data-start="{{ prochaine.startAt|date('c') }}">
      <div class="session-ticket-glow" aria-hidden="true"></div>

      {# Header ticket : coach + countdown #}
      <div class="session-ticket-header">
        <div class="session-ticket-coach">
          {% if coachPhoto %}
            <img src="{{ coachPhoto }}" alt="{{ prochaine.coach.nomComplet }}" class="session-ticket-photo">
          {% else %}
            <div class="session-ticket-photo session-ticket-initials">
              {%- set cw = prochaine.coach.nomComplet|split(' ') -%}
              {{- cw[0]|first|upper -}}{%- if cw|length > 1 -%}{{- cw[1]|first|upper -}}{%- endif -%}
            </div>
          {% endif %}
          <div class="session-ticket-coach-label">
            <span class="session-ticket-coach-with">Ta séance avec</span>
            <span class="session-ticket-coach-name">{{ coachPrenom }}</span>
          </div>
        </div>

        <div class="session-ticket-meta-top">
          {% if isPending %}
            <span class="session-ticket-status is-pending"><span class="status-dot pending"></span> En attente de {{ coachPrenom }}</span>
          {% elseif isAwaitingPayment %}
            <span class="session-ticket-status is-confirmed"><span class="status-dot"></span> Confirmée par ton coach</span>
          {% else %}
            <span class="session-ticket-status is-confirmed"><span class="status-dot"></span> Payée · prête</span>
          {% endif %}
          <span class="session-ticket-countdown" id="ticket-countdown"><i class="ti ti-hourglass"></i> ...</span>
        </div>
      </div>

      {# Infos de la séance #}
      <div class="session-ticket-info">
        <div class="session-ticket-title">{{ prochaine.offerLabel }}</div>
        <div class="session-ticket-meta">
          <span><i class="ti ti-calendar"></i> {{ prochaine.startAt|date('d/m/Y') }}</span>
          <span><i class="ti ti-clock"></i> {{ prochaine.timeRangeFormatted }} <span class="meta-dim">· {{ prochaine.durationFormatted }}</span></span>
          {% if prochaine.coveredBy == 'founding' %}
            <span class="session-ticket-price session-ticket-price--covered">
              <i class="ti ti-crown"></i> Incluse — Fondateur
            </span>
          {% elseif prochaine.coveredBy == 'subscription' and prochaine.subscription %}
            <span class="session-ticket-price session-ticket-price--covered">
              <i class="ti ti-check"></i> Incluse — {{ prochaine.subscription.packType.label }}
            </span>
          {% else %}
            <span class="session-ticket-price">{{ prochaine.prixFormatted }}</span>
          {% endif %}
        </div>
      </div>

      {# Bloc central adaptatif selon l'état #}
      {% if isPending %}
        <div class="session-ticket-state-block state-pending-block">
          <div class="state-block-icon"><i class="ti ti-hourglass-high"></i></div>
          <div class="state-block-text">
            <strong>Ta demande est partie</strong>
            <p>{{ coachPrenom }} va confirmer ta séance très vite. Tu recevras un email dès que c'est bon.</p>
          </div>
          {% if prochaine.conversation %}
            <a href="{{ path('app_conversation_show', {id: prochaine.conversation.id}) }}" class="btn btn-ghost btn-sm">
              <i class="ti ti-message"></i> Écrire à {{ coachPrenom }}
            </a>
          {% endif %}
        </div>

      {% elseif isAwaitingPayment %}
        <div class="session-ticket-state-block state-payment-block">
          <div class="state-block-eyebrow">PLUS QU'UNE ÉTAPE</div>
          <h3 class="state-block-title">Règle ta séance en ligne</h3>
          <p class="state-block-sub">
            Paiement sécurisé par carte via Stripe. Ton QR de check-in se débloque ici
            tout seul dès validation.
          </p>
          <form method="post" action="{{ path('app_booking_checkout_stripe', {ref: prochaine.reference}) }}" style="margin:0;">
            <input type="hidden" name="_token" value="{{ csrf_token('booking-stripe-' ~ prochaine.id) }}">
            <button type="submit" class="state-block-cta">
              <i class="ti ti-credit-card-pay"></i> Régler {{ prochaine.prixFormatted }} via Stripe
            </button>
          </form>
          <p class="state-block-locked">
            <i class="ti ti-lock"></i> Ton QR est prêt, il attend juste le paiement
          </p>
        </div>

      {% elseif isCheckedIn %}
        {# État terminal : arrivée validée par le coach (via scan QR).
           Prime sur isReady : plus la peine de montrer le QR. #}
        <div class="session-ticket-state-block state-checked-in-block">
          <div class="state-block-check-wrap">
            <i class="ti ti-user-check"></i>
          </div>
          <div class="state-block-check-title">Arrivée validée à {{ prochaine.checkinAt|date('H\\hi') }}</div>
          <div class="state-block-check-sub">
            {{ prochaine.checkinAt|date('d/m/Y') }}
            {%- if prochaine.checkinBy %} · par {{ prochaine.checkinBy.nomComplet }}{% endif -%}
          </div>
          {% if prochaine.paymentMethod %}
            {% set methodLabels = {'cash': 'espèces', 'card': 'carte bancaire', 'stripe': 'en ligne'} %}
            <div class="state-block-check-payment state-block-check-payment--ok">
              <i class="ti ti-check"></i>
              Réglé — {{ methodLabels[prochaine.paymentMethod] ?? prochaine.paymentMethod }}
            </div>
          {% elseif prochaine.coveredBy in ['founding', 'subscription'] %}
            <div class="state-block-check-payment state-block-check-payment--ok">
              <i class="ti ti-check"></i>
              {{ prochaine.coveredBy == 'founding' ? 'Séance Fondateur' : 'Couverte par ton pack' }}
            </div>
          {% else %}
            <div class="state-block-check-payment state-block-check-payment--wait">
              <i class="ti ti-clock"></i>
              À régler avec le coach
            </div>
          {% endif %}
        </div>

      {% elseif isReady %}
        <div class="session-ticket-state-block state-ready-block">
          <div class="state-block-qr-wrap">
            <div id="ticket-qr" data-checkin-url="{{ url('app_admin_checkin_validate', {reference: prochaine.reference}) }}"></div>
          </div>
          <p class="state-block-qr-text">
            <i class="ti ti-scan"></i>
            Présente ce QR à l'accueil — l'équipe le scanne pour valider ton arrivée.
          </p>
          <div class="session-ticket-actions">
            {% if prochaine.conversation %}
              <a href="{{ path('app_conversation_show', {id: prochaine.conversation.id}) }}" class="btn btn-ghost btn-sm">
                <i class="ti ti-message"></i> Écrire à {{ coachPrenom }}
              </a>
            {% endif %}
            <a href="{{ path('app_espace_client_rdv', {reference: prochaine.reference}) }}" class="btn btn-ghost btn-sm">
              <i class="ti ti-file-text"></i> Détail du RDV
            </a>
          </div>
        </div>
      {% endif %}
    </div>

    {# Countdown doux (réutilise le script existant) #}
    <script>
      (function() {
        const el = document.getElementById('ticket-countdown');
        const ticket = document.querySelector('.session-ticket');
        if (!el || !ticket) return;
        const target = new Date(ticket.dataset.start).getTime();

        function render() {
          const diff = target - Date.now();
          if (diff <= 0) {
            el.innerHTML = `<i class="ti ti-flame"></i> C'est l'heure !`;
            ticket.classList.add('imminent');
            return;
          }
          const totalMin = Math.floor(diff / 60000);
          const j = Math.floor(totalMin / 1440);
          const h = Math.floor((totalMin % 1440) / 60);
          const m = totalMin % 60;

          if (diff < 3600000) {
            el.innerHTML = `<i class="ti ti-flame"></i> Dans ${m} min !`;
            ticket.classList.add('imminent');
          } else if (j === 0) {
            const heureSeance = new Date(target).getHours();
            el.innerHTML = `<i class="ti ti-flame"></i> C'est ${heureSeance >= 18 ? 'ce soir' : "aujourd'hui"} — dans ${h}h${String(m).padStart(2,'0')}`;
            ticket.classList.add('soon');
          } else if (j === 1) {
            el.innerHTML = `<i class="ti ti-hourglass"></i> Demain — dans ${j}j ${h}h`;
          } else {
            el.innerHTML = `<i class="ti ti-hourglass"></i> Dans ${j} jours`;
          }
        }
        render();
        setInterval(render, 30000);
      })();
    </script>

    {# Rendu QR : seulement si on est dans l'état "prête" #}
    {% if isReady %}
      <script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js"></script>
      <script>
        (function() {
          const wrap = document.getElementById('ticket-qr');
          if (!wrap) return;
          const url = wrap.dataset.checkinUrl;
          const qr = qrcode(0, 'M');
          qr.addData(url);
          qr.make();
          wrap.innerHTML = qr.createImgTag(5, 6);
          const img = wrap.querySelector('img');
          if (img) {
            img.style.background = '#fff';
            img.style.padding = '10px';
            img.style.borderRadius = '10px';
            img.style.display = 'block';
            img.style.margin = '0 auto';
            img.style.width = '100%';
            img.style.maxWidth = '220px';
            img.style.height = 'auto';
          }
        })();
      </script>
    {% endif %}

  {% else %}
    {# ════════════════════════════════════════════════════════════════════
       ÉTAT VIDE — aucune séance à venir
       ════════════════════════════════════════════════════════════════════ #}
    <div class="empty-state" data-animate="fade-up">
      <div class="empty-state-icon"><i class="ti ti-calendar-plus"></i></div>
      <h2 class="empty-state-title">Aucune séance prévue</h2>
      <p class="empty-state-text">
        Réserve ta prochaine séance avec un coach et reprends ton rythme quand tu veux,
        jour comme nuit.
      </p>
      <a href="{{ path('app_booking_new') }}" class="btn btn-primary">
        <i class="ti ti-calendar-plus"></i> Réserver une séance
      </a>
    </div>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════════════
     B. AUTRES SÉANCES À VENIR — n'apparaît QUE si >1 séance à venir
     ══════════════════════════════════════════════════════════════════════ #}
  {% if autresSeances|length > 0 %}
    <div class="upcoming-list" data-animate="fade-up">
      <div class="upcoming-list-eyebrow">TES AUTRES SÉANCES À VENIR</div>
      <div class="upcoming-list-items">
        {% for b in autresSeances %}
          {% set bCoachPrenom = b.coach.nomComplet|split(' ')|first %}
          <a href="{{ path('app_espace_client_rdv', {reference: b.reference}) }}" class="upcoming-item">
            <div class="upcoming-item-date">
              <span class="upcoming-item-day">{{ b.startAt|date('d') }}</span>
              <span class="upcoming-item-month">{{ b.startAt|format_datetime('none', 'none', 'MMM', locale='fr')|upper|replace({'.': ''}) }}</span>
            </div>
            <div class="upcoming-item-body">
              <div class="upcoming-item-line">
                <i class="ti ti-clock"></i> {{ b.timeRangeFormatted }}
                <span class="upcoming-item-coach">· avec {{ bCoachPrenom }}</span>
              </div>
              <div class="upcoming-item-sub">{{ b.offerLabel }}</div>
            </div>
            <div class="upcoming-item-status">
              {% if b.status == 'confirmed' %}
                <span class="upcoming-item-pill is-confirmed"><i class="ti ti-check"></i> Confirmée</span>
              {% else %}
                <span class="upcoming-item-pill is-pending"><i class="ti ti-hourglass"></i> En attente</span>
              {% endif %}
            </div>
            <i class="ti ti-chevron-right upcoming-item-chevron"></i>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════════════
     Barre compacte "Mes packs" — n'apparaît QUE si ≥1 pack actif.
     Cliquable → page dédiée /mon-espace/mes-packs avec le détail.
     Accent or si au moins un pack arrive à expiration bientôt.
     ══════════════════════════════════════════════════════════════════════ #}
  {% if packsStrip.count > 0 or packsStrip.pendingCount > 0 %}
    <a href="{{ path('app_espace_client_packs') }}"
       class="packs-strip {{ packsStrip.anyExpiring ? 'packs-strip--warn' : '' }}"
       data-animate="fade-up">
      <div class="packs-strip-emblem"><i class="ti ti-barbell"></i></div>
      <div class="packs-strip-body">
        <div class="packs-strip-title">Mes packs</div>
        <div class="packs-strip-sub">
          {% if packsStrip.count > 0 %}
            {{ packsStrip.count }} pack{{ packsStrip.count > 1 ? 's' : '' }} actif{{ packsStrip.count > 1 ? 's' : '' }}
            · {{ packsStrip.totalSessions }} séance{{ packsStrip.totalSessions > 1 ? 's' : '' }} restante{{ packsStrip.totalSessions > 1 ? 's' : '' }}
            {% if packsStrip.pendingCount > 0 %}
              · <strong>{{ packsStrip.pendingCount }} en attente</strong>
            {% endif %}
          {% else %}
            {{ packsStrip.pendingCount }} pack{{ packsStrip.pendingCount > 1 ? 's' : '' }} en attente de validation
          {% endif %}
        </div>
      </div>
      <i class="ti ti-chevron-right packs-strip-chevron"></i>
    </a>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════════════
     Founding thanks card — gardée telle quelle
     ══════════════════════════════════════════════════════════════════════ #}
  {% if app.user.foundingClaim %}
    {% set fc = app.user.foundingClaim %}
    <div class="founding-thanks-card" data-animate="fade-up">
      <div class="founding-thanks-emblem"><i class="ti ti-crown"></i></div>
      <div class="founding-thanks-body">
        <div class="founding-thanks-label">{{ fc.foundingLabel }}</div>
        <p class="founding-thanks-text">Tu fais partie des tout premiers à nous avoir fait confiance. Ça, on ne l'oubliera pas. <i class="ti ti-heart-filled" style="color:#ff6b6b;vertical-align:middle;font-size:14px;"></i></p>
        <div class="founding-thanks-meta">
          <span class="founding-thanks-pill"><i class="ti ti-barbell"></i> {{ fc.sessionsRemaining }}/{{ fc.offer.sessionsIncluded }} séances offertes restantes</span>
          {% if fc.isBilanDone %}
            <span class="founding-thanks-pill is-done"><i class="ti ti-check"></i> Bilan forme effectué</span>
          {% else %}
            <span class="founding-thanks-pill"><i class="ti ti-clipboard-heart"></i> Bilan forme à programmer à ta 1ère séance</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════════════
     Encart Deciplus — gardé
     ══════════════════════════════════════════════════════════════════════ #}
  <div class="deciplus-strip">
    <div class="deciplus-strip-body">
      <div class="deciplus-strip-icon"><i class="ti ti-qrcode"></i></div>
      <div class="deciplus-strip-text">
        <div class="deciplus-strip-title">Mon abonnement &amp; accès salle — Deciplus</div>
        <div class="deciplus-strip-sub">Abonnement mensuel, planning, QR d'accès &amp; paiement <strong>Paylib</strong>.</div>
      </div>
    </div>
    <a href="{{ path('app_deciplus') }}" class="btn btn-secondary btn-sm">
      <i class="ti ti-external-link"></i> Mon espace Deciplus
    </a>
  </div>

  {# ══════════════════════════════════════════════════════════════════════
     D. LIEN HISTORIQUE — discret, en bas
     ══════════════════════════════════════════════════════════════════════ #}
  <div class="history-link-wrap">
    <a href="{{ path('app_espace_client_history') }}" class="history-link">
      <i class="ti ti-history"></i>
      Voir mes séances passées
      <i class="ti ti-arrow-right"></i>
    </a>
  </div>

</div>
{% endblock %}
