{% extends 'base.html.twig' %}

{% block title %}Mon espace — SPORT+{% endblock %}

{% block body %}
<div class="container">

  <div class="page-header">
    <div>
      <h1>Mon <span style="color:var(--gold)">Espace</span></h1>
      <p class="page-subtitle">Bienvenue, {{ app.user.nomComplet }}</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <a href="{{ path('app_booking_new') }}" class="btn btn-primary">
        <i class="ti ti-calendar-plus"></i> Nouvelle réservation
      </a>
      <a href="{{ path('app_espace_client_profil') }}" class="btn btn-secondary">
        <i class="ti ti-user-cog"></i> Modifier mon profil
      </a>
    </div>
  </div>

  {# ── Founding Member card ── #}
  {% if app.user.foundingClaim %}
    {% set fc = app.user.foundingClaim %}
    <div class="founding-member-card" style="margin-bottom:32px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
        <div>
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:900;color:var(--gold);letter-spacing:-0.5px;margin-bottom:4px;">{{ fc.foundingLabel }}</div>
          <div style="font-family:'Cormorant Garamond',serif;font-style:italic;color:var(--text-dim);font-size:15px;">Merci d'être parmi les premiers à nous faire confiance.</div>
        </div>
        <div style="text-align:right;">
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;color:var(--green);">{{ fc.sessionsRemaining }}/{{ fc.offer.sessionsIncluded }}</div>
          <div style="font-size:13px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;">séances restantes</div>
        </div>
      </div>
      <div style="margin-top:12px;font-size:14px;color:var(--text-dim);">
        Bilan forme :
        {% if fc.isBilanDone %}
          <span style="color:var(--green);">Effectué</span>
        {% else %}
          <span style="color:var(--gold);">À programmer lors de ta première séance</span>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {# ── Stat cards ── #}
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Total réservations</span>
      <span class="stat-value">{{ total }}</span>
    </div>
    <div class="stat-card success">
      <span class="stat-label">Confirmées</span>
      <span class="stat-value">{{ nbConfirmees }}</span>
    </div>
    <div class="stat-card warning">
      <span class="stat-label">En attente</span>
      <span class="stat-value">{{ nbEnAttente }}</span>
    </div>
  </div>

  {# ── Encart Deciplus ── #}
  <div style="background:var(--bg-card);border:1px solid rgba(61,255,20,.3);
              border-left:3px solid var(--green);border-radius:var(--radius-lg);
              padding:20px 24px;margin-bottom:32px;
              display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
    <div style="display:flex;align-items:center;gap:14px;">
      <div style="width:42px;height:42px;background:rgba(61,255,20,.1);border-radius:10px;
                  display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="ti ti-qrcode" style="font-size:20px;color:var(--green);"></i>
      </div>
      <div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:15px;
                    text-transform:uppercase;letter-spacing:1px;color:var(--white);">
          Accès salle 24h/24 — Deciplus
        </div>
        <div style="font-size:13px;color:var(--text-dim);margin-top:2px;">
          Planning, réservations et QR code d'accès via l'app Xplor Active.
        </div>
      </div>
    </div>
    <a href="{{ path('app_deciplus') }}" class="btn btn-secondary btn-sm" style="flex-shrink:0;">
      <i class="ti ti-external-link"></i> Mon espace Deciplus
    </a>
  </div>

  {% if total == 0 %}
    <div class="empty-placeholder">
      <i class="ti ti-barbell" style="font-size:48px;display:block;margin-bottom:16px;opacity:.3;"></i>
      Aucune séance pour l'instant.<br>
      <a href="{{ path('app_booking_new') }}" class="btn btn-primary" style="margin-top:24px;display:inline-flex;">
        <i class="ti ti-calendar-plus"></i> Réserver ma première séance
      </a>
    </div>
  {% else %}

    {# ── Info messagerie (si aucune conversation) ── #}
    {% if nbConfirmees == 0 %}
      <div class="info-box" style="margin-bottom:28px;">
        <i class="ti ti-message-dots"></i>
        <p>
          <strong style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">Messagerie</strong><br>
          La messagerie s'ouvre automatiquement dès qu'un coach accepte votre réservation. Vous pouvez alors échanger directement avec lui.
        </p>
      </div>
    {% endif %}

    {# ── Séances à venir ── #}
    <div class="section-label">Mes séances à venir</div>

    {% if reservationsAVenir is empty %}
      <p style="color:var(--text-dim);margin-bottom:32px;">
        Aucune séance à venir.
        <a href="{{ path('app_booking_new') }}" class="link-gold">Réserver un créneau →</a>
      </p>
    {% else %}
      <div class="cards-grid" style="margin-bottom:40px;">
        {% for booking in reservationsAVenir %}
          <div class="coach-card" style="align-items:flex-start;text-align:left;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;width:100%;margin-bottom:16px;">
              <div>
                <div class="coach-name" style="font-size:18px;">{{ booking.offerLabel }}</div>
                <div style="font-size:13px;color:var(--text-dim);margin-top:2px;">Réf. {{ booking.reference }}</div>
              </div>
              <span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span>
            </div>
            <div style="width:100%;display:flex;flex-direction:column;gap:8px;margin-bottom:20px;">
              <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
                <i class="ti ti-calendar" style="color:var(--gold-dim);"></i>
                {{ booking.startAt|date('d/m/Y à H:i') }}
              </div>
              <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
                <i class="ti ti-user" style="color:var(--gold-dim);"></i>
                {{ booking.coach.nomComplet }}
              </div>
              <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:18px;">
                <i class="ti ti-coins" style="color:var(--gold-dim);font-size:14px;"></i>
                {{ booking.prixFormatted }}
              </div>
            </div>
            <div class="booking-card-actions">
              {% if booking.canBeCancelled %}
                <form
                  action="{{ path('app_booking_cancel', {ref: booking.reference}) }}"
                  method="post"
                  onsubmit="return confirm('Confirmer l\'annulation de cette séance ?')"
                >
                  <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ booking.id) }}">
                  <button type="submit" class="action-btn action-btn--danger">
                    <i class="ti ti-x"></i> Annuler
                  </button>
                </form>
              {% endif %}
              {% if booking.conversation %}
                <a href="{{ path('app_conversation_show', {id: booking.conversation.id}) }}" class="action-btn">
                  <i class="ti ti-message"></i> Messagerie
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Historique ── #}
    {% if reservationsPassees is not empty %}
      <div class="section-label">Historique</div>
      <div class="data-table-card">
        <table>
          <thead>
            <tr>
              <th>Prestation</th>
              <th>Date</th>
              <th>Coach</th>
              <th>Prix</th>
              <th>Statut</th>
            </tr>
          </thead>
          <tbody>
            {% for booking in reservationsPassees %}
              <tr>
                <td style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.offerLabel }}</td>
                <td style="color:var(--text-dim);">{{ booking.startAt|date('d/m/Y') }}</td>
                <td style="color:var(--text-dim);">{{ booking.coach.nomComplet }}</td>
                <td style="color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.prixFormatted }}</td>
                <td><span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

  {% endif %}

</div>
{% endblock %}
