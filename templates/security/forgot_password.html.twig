{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — SPORT+{% endblock %}

{% block body %}
<div class="auth-layout">
  <!-- Form panel -->
  <div class="auth-panel">
    <div class="auth-form-box">
      <div class="auth-title">Mot de passe oublié</div>
      <p class="auth-sub">Saisis ton email, on t'envoie un lien pour le réinitialiser</p>

      {% if submitted %}
        <div class="alert alert-success">
          <i class="ti ti-mail-check"></i>
          <div>
            Si un compte SPORT+ existe avec cette adresse email, un lien vient d'être envoyé.
            <br><small style="opacity:.85;">Pense à vérifier tes spams. Le lien expire dans 1 heure.</small>
          </div>
        </div>
        <div class="auth-link" style="margin-top:20px;">
          <a href="{{ path('app_login') }}"><i class="ti ti-arrow-left"></i> Retour à la connexion</a>
        </div>
      {% else %}
        {% for label, messages in app.flashes(['error']) %}
          {% for message in messages %}
            <div class="alert alert-error">
              <i class="ti ti-alert-circle"></i> {{ message }}
            </div>
          {% endfor %}
        {% endfor %}

        <form method="post">
          <input type="hidden" name="_token" value="{{ csrf_token('forgot-password') }}">

          <div class="form-field">
            <label for="inputEmail">Email du compte</label>
            <input type="email" name="email" id="inputEmail" autocomplete="email" required autofocus placeholder="ton@email.com">
          </div>

          <button class="btn btn-primary btn-full btn-lg" type="submit">
            <i class="ti ti-send"></i> M'envoyer le lien
          </button>
        </form>

        <div class="auth-link">
          <a href="{{ path('app_login') }}"><i class="ti ti-arrow-left"></i> Retour à la connexion</a>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Visual panel -->
  <div class="auth-visual" style="background-image:url('{{ asset('img/club-photos/cours-collectif-1.jpg') }}');">
    <div class="auth-quote">
      <div class="auth-quote-eyebrow">Sécurité</div>
      <blockquote>"Ton compte est protégé. On t'envoie un lien à usage unique valable 1 heure."</blockquote>
      <cite>— SPORT+ Marseille</cite>

      <div class="auth-quote-features">
        <div class="auth-quote-feature">
          <i class="ti ti-shield-lock"></i>
          <span>Lien signé, à usage unique</span>
        </div>
        <div class="auth-quote-feature">
          <i class="ti ti-clock"></i>
          <span>Expire automatiquement après 1h</span>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
