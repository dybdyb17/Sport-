{% extends 'base.html.twig' %}

{% block title %}Inscription — SPORT+{% endblock %}

{% block body %}
<div class="auth-layout">
  <!-- Form panel -->
  <div class="auth-panel">
    <div class="auth-form-box">
      <div class="auth-title">Créer mon compte</div>
      <p class="auth-sub">Rejoins la communauté SPORT+ Marseille</p>

      {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.nomComplet) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.phone) }}
        {{ form_row(registrationForm.plainPassword) }}

        <button class="btn btn-primary btn-full btn-lg" type="submit">
          <i class="ti ti-user-plus"></i> M'inscrire gratuitement
        </button>
      {{ form_end(registrationForm) }}

      <div class="auth-link">
        Déjà inscrit ? <a href="{{ path('app_login') }}">Connexion</a>
      </div>
    </div>
  </div>

  <!-- Visual panel : photo immersive + texte en bas -->
  <div class="auth-visual" style="background-image:url('{{ asset('img/club-photos/portrait-souriante.jpg') }}');">
    <div class="auth-quote">
      <div class="auth-quote-eyebrow">Rejoins-nous</div>
      <blockquote>"Chaque séance est un pas vers la meilleure version de toi-même."</blockquote>
      <cite>— L'équipe SPORT+</cite>

      <div class="auth-quote-features">
        <div class="auth-quote-feature">
          <i class="ti ti-circle-check"></i>
          <span>Sans engagement — annulation libre 2h avant</span>
        </div>
        <div class="auth-quote-feature">
          <i class="ti ti-circle-check"></i>
          <span>Coachs certifiés disponibles 24h/24</span>
        </div>
        <div class="auth-quote-feature">
          <i class="ti ti-circle-check"></i>
          <span>Paiement uniquement si le coach confirme</span>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
