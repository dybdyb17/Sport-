{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — SPORT+{% endblock %}

{% block body %}
<div class="auth-layout">
  <!-- Form panel -->
  <div class="auth-panel">
    <div class="auth-form-box">
      <div class="auth-title">Nouveau mot de passe</div>
      <p class="auth-sub">
        Compte : <strong style="color:var(--gold);">{{ user.email }}</strong>
      </p>

      {% for label, messages in app.flashes(['error']) %}
        {% for message in messages %}
          <div class="alert alert-error">
            <i class="ti ti-alert-circle"></i> {{ message }}
          </div>
        {% endfor %}
      {% endfor %}

      <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('reset-password-' ~ user.id) }}">

        <div class="form-field">
          <label for="inputPassword">Nouveau mot de passe</label>
          <input type="password" name="password" id="inputPassword" autocomplete="new-password" required minlength="8" placeholder="8 caractères minimum">
          <div style="font-size:12px;color:var(--text-dim);margin-top:6px;">
            <i class="ti ti-info-circle"></i> 8 caractères minimum.
          </div>
        </div>

        <div class="form-field">
          <label for="inputPasswordConfirm">Confirmation</label>
          <input type="password" name="password_confirm" id="inputPasswordConfirm" autocomplete="new-password" required minlength="8" placeholder="Re-tape ton mot de passe">
        </div>

        <button class="btn btn-primary btn-full btn-lg" type="submit">
          <i class="ti ti-shield-check"></i> Enregistrer le nouveau mot de passe
        </button>
      </form>

      <div class="auth-link">
        <a href="{{ path('app_login') }}"><i class="ti ti-arrow-left"></i> Retour à la connexion</a>
      </div>
    </div>
  </div>

  <!-- Visual panel -->
  <div class="auth-visual" style="background-image:url('{{ asset('img/club-photos/cours-collectif-1.jpg') }}');">
    <div class="auth-quote">
      <div class="auth-quote-eyebrow">Sécurité</div>
      <blockquote>"Choisis un mot de passe d'au moins 8 caractères. Idéalement mélange lettres, chiffres et symboles."</blockquote>
      <cite>— SPORT+ Marseille</cite>

      <div class="auth-quote-features">
        <div class="auth-quote-feature">
          <i class="ti ti-shield-lock"></i>
          <span>8 caractères minimum</span>
        </div>
        <div class="auth-quote-feature">
          <i class="ti ti-lock-check"></i>
          <span>Tous les liens précédents seront invalidés</span>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
