{% extends 'base.html.twig' %}

{% block title %}Connexion — SPORT+{% endblock %}

{% block body %}
<div class="auth-layout">
  <!-- Form panel -->
  <div class="auth-panel">
    <div class="auth-form-box">
      <div class="auth-title">Connexion</div>
      <p class="auth-sub">Accède à ton espace coaching</p>

      {% if error %}
        <div class="alert alert-error">
          <i class="ti ti-alert-circle"></i>
          {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
      {% endif %}

      <form method="post">
        <div class="form-field">
          <label for="inputEmail">Email</label>
          <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" autocomplete="email" required autofocus placeholder="ton@email.com">
        </div>

        <div class="form-field">
          <label for="inputPassword">Mot de passe</label>
          <input type="password" name="_password" id="inputPassword" autocomplete="current-password" required placeholder="••••••••">
          <div style="text-align:right;margin-top:8px;">
            <a href="{{ path('app_forgot_password') }}" style="font-size:13px;color:var(--gold);text-decoration:none;">
              Mot de passe oublié ?
            </a>
          </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div style="margin-bottom:24px;">
          <label class="chip">
            <input type="checkbox" name="_remember_me">
            <span class="chip-text">Se souvenir de moi</span>
          </label>
        </div>

        <button class="btn btn-primary btn-full btn-lg" type="submit">
          <i class="ti ti-login"></i> Se connecter
        </button>
      </form>

      <div class="auth-link">
        Pas encore de compte ? <a href="{{ path('app_register') }}">Inscription gratuite</a>
      </div>
    </div>
  </div>

  <!-- Visual panel : photo immersive + citation -->
  <div class="auth-visual" style="background-image:url('{{ asset('img/club-photos/cours-collectif-1.jpg') }}');">
    <div class="auth-quote">
      <div class="auth-quote-eyebrow">Bon retour</div>
      <blockquote>"Le seul mauvais entraînement est celui qu'on n'a pas fait."</blockquote>
      <cite>— SPORT+ Marseille</cite>

      <div class="auth-quote-features">
        <div class="auth-quote-feature">
          <i class="ti ti-bolt"></i>
          <span>Ouvert 24h/24, 7j/7</span>
        </div>
        <div class="auth-quote-feature">
          <i class="ti ti-shield-check"></i>
          <span>Ton compte, tes coachs, ta messagerie</span>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
