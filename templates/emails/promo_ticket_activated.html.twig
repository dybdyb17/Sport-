{% extends 'emails/base.html.twig' %}
{% import 'emails/_macros.html.twig' as m %}

{% block subject %}✅ Paiement confirmé — {{ offer.title }}{% endblock %}

{% block content %}
<p style="margin:0 0 20px;font-size:16px;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;">
  Salut <strong style="color:#F4EFE6;">{{ purchase.buyerName|split(' ')|first }}</strong>,
</p>

<p style="margin:0 0 24px;font-size:15px;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;line-height:1.65;">
  Ton paiement pour <strong style="color:#C8A951;">{{ offer.title }}</strong> est confirmé.
  {% if offer.isUnlimitedAccess %}
    Tu as désormais accès illimité à SPORT+, à vie — passe quand tu veux, on t'accueille.
  {% else %}
    Ton QR est prêt : présente-le à l'accueil du club pour valider ton entrée.
  {% endif %}
</p>

{# Bloc récap confirmation #}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#161620;border:1px solid #2ECC71;border-radius:10px;margin:0 0 24px;">
  <tr>
    <td style="padding:22px 24px;">
      <div style="font-weight:700;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#2ECC71;margin-bottom:14px;font-family:Arial,Helvetica,sans-serif;">Paiement validé</div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#ECECEC;line-height:2;">
        <span style="color:#9A8F7A;">Référence :</span> <strong style="color:#C8A951;letter-spacing:1px;">{{ purchase.reference }}</strong><br>
        <span style="color:#9A8F7A;">Offre :</span> <strong style="color:#F4EFE6;">{{ offer.title }}</strong><br>
        <span style="color:#9A8F7A;">Montant :</span> <strong style="color:#F4EFE6;">{{ purchase.amountFormatted }}</strong><br>
        <span style="color:#9A8F7A;">Confirmé le :</span> <strong style="color:#F4EFE6;">{{ purchase.paidAt|date('d/m/Y à H\\hi') }}</strong>
      </div>
    </td>
  </tr>
</table>

{% if offer.isUnlimitedAccess %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:linear-gradient(135deg,rgba(200,169,81,.10),rgba(46,204,113,.08));border:1px solid #C8A951;border-radius:6px;margin:0 0 24px;">
  <tr>
    <td style="padding:18px 20px;text-align:center;">
      <div style="font-weight:700;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C8A951;margin-bottom:6px;font-family:Arial,Helvetica,sans-serif;">Accès à vie</div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:#ECECEC;line-height:1.55;">
        Un scan à l'accueil pour activer, puis tu entres librement à SPORT+ à vie.
      </div>
    </td>
  </tr>
</table>
{% endif %}

{{ m.button(ticketUrl, 'Voir mon ticket QR') }}

{{ m.divider() }}

<p style="margin:0;font-size:13px;color:#9A8F7A;font-family:Arial,Helvetica,sans-serif;text-align:center;">
  Garde cet email — le lien vers ton ticket QR reste actif.<br>
  À très vite au club.
</p>
{% endblock %}
