{% extends 'emails/base.html.twig' %}
{% import 'emails/_macros.html.twig' as m %}

{% block subject %}🏆 Bienvenue parmi les Membres Fondateurs #{{ '%02d'|format(claim.claimNumber) }}{% endblock %}

{% block content %}
<p style="margin:0 0 20px;font-size:16px;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;">
  Félicitations <strong style="color:#F4EFE6;">{{ user.nomComplet|split(' ')|first }}</strong> !
</p>

{# Hero bloc numéro fondateur #}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:linear-gradient(135deg,#161620,#1A1A10);border:1px solid #C8A951;border-radius:10px;margin:0 0 24px;">
  <tr>
    <td align="center" style="padding:32px 24px;">
      <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;letter-spacing:4px;text-transform:uppercase;color:#7A6228;margin-bottom:10px;">Membre Fondateur</div>
      <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:56px;font-weight:900;color:#C8A951;letter-spacing:-2px;line-height:1;">#{{ '%02d'|format(claim.claimNumber) }}</div>
      <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#9A8F7A;margin-top:8px;">sur {{ offer.totalPlaces }} fondateurs</div>
    </td>
  </tr>
</table>

<p style="margin:0 0 20px;font-size:15px;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;line-height:1.65;">
  Tu fais partie des premiers à rejoindre SPORT+ Marseille. Ce statut <strong style="color:#C8A951;">Membre Fondateur</strong> te donne accès à des avantages exclusifs à vie.
</p>

{# Avantages #}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#161620;border-left:3px solid #2ECC71;border-radius:6px;margin:0 0 24px;">
  <tr>
    <td style="padding:18px 20px;">
      <div style="font-weight:700;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#2ECC71;margin-bottom:12px;font-family:Arial,Helvetica,sans-serif;">Tes avantages fondateur</div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#ECECEC;line-height:1.8;">
        ✅ {{ offer.sessionsIncluded }} séances de coaching incluses<br>
        ✅ Bilan forme offert lors de ta 1ère séance<br>
        ✅ Badge Fondateur à vie sur ton profil<br>
        ✅ Priorité de réservation sur les créneaux Night Coach<br>
        ✅ Tarif de lancement : {{ offer.price }} € (au lieu de {{ offer.regularPrice ?? '175' }} €)
      </div>
    </td>
  </tr>
</table>

{{ m.button(bookingUrl, 'Réserver ma première séance') }}

{{ m.divider() }}

<p style="margin:0;font-size:13px;color:#9A8F7A;font-family:Arial,Helvetica,sans-serif;text-align:center;">
  Profite de ton bilan forme offert lors de ta première séance.<br>
  Mentionne-le en message lors de ta réservation.
</p>
{% endblock %}
