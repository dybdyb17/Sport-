{% extends 'emails/base.html.twig' %}
{% import 'emails/_macros.html.twig' as m %}

{% block subject %}Nouveau message de {{ name }} — SPORT+{% endblock %}

{% block content %}
<p style="margin:0 0 8px;font-size:18px;font-weight:700;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;">
  Nouveau message du formulaire de contact
</p>
<p style="margin:0 0 20px;font-size:14px;color:#9A9080;font-family:Arial,Helvetica,sans-serif;">
  Tu peux répondre directement à cet email — la réponse partira au visiteur.
</p>

{{ m.infoCard('Nom', name) }}
{{ m.infoCard('Email', '<a href="mailto:' ~ email ~ '" style="color:#C8A951;text-decoration:underline;">' ~ email ~ '</a>') }}
{% if phone %}
  {{ m.infoCard('Téléphone', '<a href="tel:' ~ phone|replace({' ': '', '.': '', '-': ''}) ~ '" style="color:#C8A951;text-decoration:underline;">' ~ phone ~ '</a>') }}
{% endif %}

{{ m.divider() }}

<div style="font-weight:700;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C8A951;margin-bottom:10px;font-family:Arial,Helvetica,sans-serif;">
  Message
</div>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#161620;border:1px solid #2A2720;border-radius:6px;">
  <tr>
    <td style="padding:18px 20px;">
      <div style="color:#ECECEC;font-size:15px;font-family:Arial,Helvetica,sans-serif;line-height:1.7;white-space:pre-wrap;">{{ message }}</div>
    </td>
  </tr>
</table>
{% endblock %}
