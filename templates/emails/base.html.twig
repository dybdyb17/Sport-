<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="fr">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% block subject %}SPORT+{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#060606;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#060606;">
    <tr>
      <td align="center" style="padding:40px 16px;">

        {# Container #}
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width:600px;width:100%;background-color:#12121A;border-radius:12px;border:1px solid #2A2720;">

          {# Header #}
          <tr>
            <td align="center" style="padding:32px 20px 24px;border-bottom:1px solid #2A2720;">
              <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:900;font-size:34px;letter-spacing:-1px;color:#F4EFE6;">
                SPORT<span style="color:#2ECC71;">+</span>
              </div>
              <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:11px;letter-spacing:4px;color:#7A6228;margin-top:6px;text-transform:uppercase;">
                Coaching Premium Marseille
              </div>
            </td>
          </tr>

          {# Body #}
          <tr>
            <td style="padding:36px 32px;color:#ECECEC;font-size:16px;line-height:1.65;">
              {% block content %}{% endblock %}
            </td>
          </tr>

          {# Footer #}
          <tr>
            <td align="center" style="padding:24px 20px 32px;border-top:1px solid #2A2720;">
              <div style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9A8F7A;">
                Pour le meilleur &amp; pour le <span style="color:#2ECC71;">+</span>
              </div>
              <div style="margin-top:14px;font-size:12px;color:#7A6228;font-family:Arial,Helvetica,sans-serif;line-height:1.7;">
                164 Chemin de Saint-Jean du Désert — 13005 Marseille<br>
                04 91 42 22 07 — Ouvert 24h/24, 7j/7
              </div>
              <div style="margin-top:14px;font-size:11px;color:#6A6050;font-family:Arial,Helvetica,sans-serif;">
                Vous recevez cet email car vous avez un compte sur SPORT+ Marseille.<br>
                <a href="{{ app_url ?? 'http://127.0.0.1:8001' }}" style="color:#7A6228;text-decoration:underline;">sport-plus-marseille.fr</a>
              </div>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
