{% extends 'emails/base.html.twig' %}
{% import 'emails/_macros.html.twig' as m %}

{% block subject %}🏆 Nouveau Membre Fondateur — #{{ '%02d'|format(claim.claimNumber) }}{% endblock %}

{% block content %}
<p style="margin:0 0 20px;font-size:16px;color:#ECECEC;font-family:Arial,Helvetica,sans-serif;">
  Un nouveau Membre Fondateur vient de rejoindre SPORT+.
</p>

{{ m.badge('#' ~ '%02d'|format(claim.claimNumber) ~ ' — ' ~ user.nomComplet) }}

<div style="margin-top:20px;"></div>

{{ m.infoCard('Nom', user.nomComplet) }}
{{ m.infoCard('Email', user.email) }}
{{ m.infoCard('N° Fondateur', '#' ~ '%02d'|format(claim.claimNumber)) }}
{{ m.infoCard('Inscrit le', claim.claimedAt|date('d/m/Y à H:i')) }}

<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#161620;border-left:3px solid #2ECC71;border-radius:6px;margin:16px 0;">
  <tr>
    <td style="padding:14px 18px;">
      <div style="font-weight:700;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#2ECC71;margin-bottom:6px;font-family:Arial,Helvetica,sans-serif;">Avancement de l'offre</div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:700;color:#C8A951;">
        {{ offer.placesTaken }} / {{ offer.totalPlaces }}
      </div>
      <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#9A8F7A;margin-top:4px;">
        {{ offer.placesRemaining }} place{{ offer.placesRemaining > 1 ? 's' : '' }} restante{{ offer.placesRemaining > 1 ? 's' : '' }}
      </div>
    </td>
  </tr>
</table>

{{ m.button(adminListUrl, 'Voir dans l\'admin') }}
{% endblock %}
