{% extends 'base.html.twig' %}

{% block title %}Réserver un coach — SPORT+{% endblock %}

{% block body %}
<div class="container" style="padding-top:40px;padding-bottom:60px;">

  <div class="page-header">
    <div>
      <h1>Réserver <span style="color:var(--gold)">ton coach</span></h1>
      <p class="page-subtitle">Choisis ta prestation et ton créneau</p>
    </div>
  </div>

  <div class="booking-form-layout">

    <!-- Form -->
    <div>
      {{ form_start(form, {'attr': {'class': 'booking-form'}}) }}
        <div class="form-field">{{ form_row(form.coach) }}</div>
        <div class="form-field">{{ form_row(form.format) }}</div>
        <div class="form-field">{{ form_row(form.timeSlot) }}</div>
        <div class="form-field" id="group-persons-field" style="display:none;">
          {{ form_row(form.personsCount) }}
        </div>
        <div class="form-field">{{ form_row(form.startAt) }}</div>
        <div class="form-field">{{ form_row(form.packType) }}</div>
        <div class="form-field">{{ form_row(form.fullAccess) }}</div>
        <div class="form-field">{{ form_row(form.message) }}</div>

        <div class="price-summary">
          Le prix est calculé selon le format et le créneau choisis. Paiement uniquement si le coach accepte.
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-full" style="margin-top:24px;">
          <i class="ti ti-send"></i> Envoyer la demande
        </button>
      {{ form_end(form) }}

      <script>
        // Afficher le champ "Nombre de participants" uniquement pour GROUP
        const formatField = document.querySelector('[name="booking[format]"]') ||
                            document.querySelector('#booking_format');
        const groupField  = document.getElementById('group-persons-field');
        function togglePersons() {
          const selected = document.querySelector('input[name="booking[format]"]:checked');
          if (groupField) groupField.style.display = selected && selected.value === 'group' ? '' : 'none';
        }
        document.querySelectorAll('input[name="booking[format]"]').forEach(r => r.addEventListener('change', togglePersons));
        togglePersons();
      </script>
    </div>

    <!-- Info panel -->
    <div class="booking-info-panel">
      <h3><i class="ti ti-info-circle" style="color:var(--gold-dim);margin-right:8px;"></i>Comment ça marche ?</h3>
      <div class="booking-info-item">
        <i class="ti ti-send"></i>
        <span>Ta demande est envoyée au coach immédiatement</span>
      </div>
      <div class="booking-info-item">
        <i class="ti ti-bell"></i>
        <span>Tu reçois une notification dès sa réponse</span>
      </div>
      <div class="booking-info-item">
        <i class="ti ti-coins"></i>
        <span>Paiement uniquement si le coach confirme</span>
      </div>
      <div class="booking-info-item">
        <i class="ti ti-x"></i>
        <span>Annulation gratuite jusqu'à 2h avant la séance</span>
      </div>
      <div style="margin-top:20px;padding:16px;background:rgba(200,169,81,.06);border:1px solid rgba(200,169,81,.15);border-radius:var(--radius);font-size:13px;color:var(--text-dim);">
        <i class="ti ti-shield-check" style="color:var(--gold);margin-right:6px;"></i>
        <strong style="color:var(--gold);">Sans engagement</strong> — Réserve, teste, avance.
      </div>
    </div>

  </div>

</div>
{% endblock %}
