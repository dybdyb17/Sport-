{% extends 'base.html.twig' %}

{% block title %}Présence confirmée — SPORT+{% endblock %}

{% block body %}
<div class="container" style="padding-top:80px;padding-bottom:80px;max-width:560px;text-align:center;">

  <div style="width:84px;height:84px;margin:0 auto 24px;border-radius:24px;background:rgba(46,204,113,.10);border:1px solid rgba(46,204,113,.4);display:flex;align-items:center;justify-content:center;">
    <i class="ti ti-circle-check" style="font-size:46px;color:var(--green);"></i>
  </div>

  <h1 style="font-family:'Barlow Condensed',sans-serif;font-size:38px;font-weight:900;color:var(--white);letter-spacing:-0.5px;margin:0 0 12px;">
    Merci, ta présence est <span style="color:var(--green);">confirmée</span>
  </h1>

  <p style="font-size:16px;color:var(--text-soft);line-height:1.6;margin:0 0 32px;">
    {{ booking.coach.nomComplet|split(' ')|first }} t'attend le
    <strong style="color:var(--white);">{{ booking.startAt|date('d/m/Y') }} à {{ booking.startAt|date('H\\hi') }}</strong>
    pour ta séance <strong style="color:var(--gold);">{{ booking.offerLabel }}</strong>.
  </p>

  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:18px 22px;margin-bottom:28px;text-align:left;font-size:14px;color:var(--text-soft);">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;font-size:12px;">
      <i class="ti ti-info-circle"></i> Un imprévu ?
    </div>
    Préviens ton coach au plus vite via la messagerie ou par téléphone.
    En cas d'absence non prévenue, des frais peuvent t'être facturés (selon CGV).
  </div>

  <a href="{{ path('app_espace_client') }}" class="btn btn-primary">
    <i class="ti ti-home"></i> Retour à mon espace
  </a>
</div>
{% endblock %}
