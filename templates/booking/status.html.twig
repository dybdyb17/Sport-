{% extends 'base.html.twig' %}

{% block title %}Suivi réservation {{ booking.reference }} — SPORT+{% endblock %}

{% block body %}
<div class="container" style="padding-top:40px;padding-bottom:60px;max-width:640px;">

  <div class="page-header">
    <div>
      <h1>Suivi de <span style="color:var(--gold)">ta demande</span></h1>
      <p class="page-subtitle">Référence : <span style="color:var(--gold);">{{ booking.reference }}</span></p>
    </div>
  </div>

  <div class="coach-card" style="align-items:flex-start;text-align:left;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;width:100%;margin-bottom:16px;">
      <div class="coach-name" style="font-size:20px;">{{ booking.offerLabel }}</div>
      <span class="status-badge {{ booking.status }}" id="status-badge"><i class="ti {{ booking.statutIcon }}"></i>{{ booking.statutLabel }}</span>
    </div>
    <div style="width:100%;display:flex;flex-direction:column;gap:8px;">
      <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
        <i class="ti ti-calendar" style="color:var(--gold-dim);"></i>
        {{ booking.startAt|date('d/m/Y à H:i') }}
      </div>
      <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
        <i class="ti ti-user" style="color:var(--gold-dim);"></i>
        {{ booking.coach.nomComplet }}
      </div>
      <div style="display:flex;align-items:center;gap:8px;font-size:18px;color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;">
        <i class="ti ti-coins" style="color:var(--gold-dim);font-size:14px;"></i>
        {{ booking.displayAmountFormatted }}
      </div>
      {% if booking.displayAmountLabel %}
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-dim);">
          <i class="ti ti-package" style="color:var(--gold-dim);"></i>
          {{ booking.displayAmountLabel }} · couvre {{ booking.subscription.packType.sessionsCount }} séances
        </div>
      {% endif %}
    </div>
  </div>

  <div style="margin-top:24px;display:flex;flex-direction:column;gap:12px;">
    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--text-dim);">
      <i class="ti ti-send" style="color:var(--gold-dim);"></i>
      Le coach a reçu ta demande
    </div>
    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--text-dim);">
      <i class="ti ti-refresh" style="color:var(--gold-dim);"></i>
      Cette page se met à jour automatiquement dès sa réponse
    </div>
    <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--text-dim);">
      <i class="ti ti-coins" style="color:var(--gold-dim);"></i>
      Paiement uniquement si le coach accepte
    </div>
  </div>

  <div style="margin-top:32px;">
    <a href="{{ path('app_espace_client') }}" class="btn btn-secondary">
      <i class="ti ti-arrow-left"></i> Retour à mon espace
    </a>
  </div>

</div>
{% endblock %}

{% block mercure %}
    <script>
        const es = new EventSource(
            "{{ mercure('client/' ~ app.user.id ~ '/stream')|escape('js') }}",
            { withCredentials: false }
        );

        es.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.type === 'booking_confirmed' && data.ref === '{{ booking.reference }}') {
                const badge = document.getElementById('status-badge');
                badge.textContent = 'Confirmée';
                badge.className = 'status-badge confirmed';
                location.reload();
            }
        };
    </script>
{% endblock %}
