{% extends 'base.html.twig' %}

{% block title %}Messagerie — SPORT+{% endblock %}

{% block body %}
<div class="conversation-layout">

  <!-- Sidebar -->
  <div class="conv-sidebar">
    {% if items is empty %}
      <div style="padding:32px 20px;color:var(--text-dim);font-size:14px;text-align:center;">
        <i class="ti ti-message-off" style="font-size:32px;display:block;margin-bottom:12px;opacity:.4;"></i>
        Aucune conversation
      </div>
    {% else %}
      {% for item in items %}
        {% set conv  = item.conversation %}
        {% set inter = item.interlocuteur %}
        {% set last  = item.lastMessage %}
        <a href="{{ path('app_conversation_show', {id: conv.id}) }}"
           class="conv-list-item {{ item.isUnread ? 'is-unread' : '' }}">
          <div class="conv-avatar-sm">
            {% if inter %}
              {%- set words = inter.nomComplet|split(' ') -%}
              {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
            {% else %}?{% endif %}
          </div>
          <div class="conv-body">
            <span class="conv-name">{{ inter ? inter.nomComplet : 'Inconnu' }}</span>
            <span class="conv-preview">
              {% if last %}{{ last.content }}{% else %}{{ conv.booking.serviceTypeLabel }}{% endif %}
            </span>
          </div>
          <div class="conv-meta">
            {% if last %}<span class="conv-time">{{ last.createdAt|date('H:i') }}</span>{% endif %}
            {% if item.isUnread %}<span class="unread-dot"></span>{% endif %}
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>

  <!-- Main area: welcome state -->
  <div class="chat-area">
    <div class="chat-welcome">
      <div>
        <i class="ti ti-message" style="font-size:48px;display:block;margin-bottom:16px;opacity:.2;"></i>
        Sélectionne une conversation
      </div>
    </div>
  </div>

</div>
{% endblock %}
