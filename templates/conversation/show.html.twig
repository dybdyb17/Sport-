{% extends 'base.html.twig' %}

{% block title %}
    Conversation avec {{ interlocuteur ? interlocuteur.nomComplet : 'Coach' }} — SPORT+
{% endblock %}

{% block body %}
<div class="conversation-layout">

  <!-- Sidebar -->
  <div class="conv-sidebar">
    {% if sidebarItems is defined and sidebarItems is not empty %}
      {% for item in sidebarItems %}
        {% set conv  = item.conversation %}
        {% set inter = item.interlocuteur %}
        {% set last  = item.lastMessage %}
        <a href="{{ path('app_conversation_show', {id: conv.id}) }}"
           class="conv-list-item {{ item.isUnread ? 'is-unread' : '' }} {{ conv.id == conversation.id ? 'is-active' : '' }}">
          <div class="conv-avatar-sm">
            {% if inter %}
              {%- set words = inter.nomComplet|split(' ') -%}
              {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
            {% else %}?{% endif %}
          </div>
          <div class="conv-body">
            <span class="conv-name">{{ inter ? inter.nomComplet : 'Inconnu' }}</span>
            <span class="conv-preview">
              {% if last %}{{ last.content }}{% else %}Aucun message{% endif %}
            </span>
          </div>
          <div class="conv-meta">
            {% if last %}<span class="conv-time">{{ last.createdAt|date('H:i') }}</span>{% endif %}
            {% if item.isUnread %}<span class="unread-dot"></span>{% endif %}
          </div>
        </a>
      {% endfor %}
    {% else %}
      <div style="padding:24px 20px;color:var(--text-dim);font-size:14px;">
        <a href="{{ path('app_conversation_inbox') }}" class="link-gold">← Messagerie</a>
      </div>
    {% endif %}
  </div>

  <!-- Chat area -->
  <div class="chat-area">
    {# ── BANDEAU SÉANCE ÉPINGLÉ ── #}
    {% set booking = conversation.booking %}
    <div class="chat-pinned-session {{ booking.status }}">
      <div class="chat-pinned-icon">
        {% if booking.timeSlot.value == 'astreinte' %}
          <i class="ti ti-moon"></i>
        {% elseif booking.timeSlot.value == 'night' %}
          <i class="ti ti-moon-stars"></i>
        {% else %}
          <i class="ti ti-sun"></i>
        {% endif %}
      </div>
      <div class="chat-pinned-body">
        <div class="chat-pinned-status">
          <span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span>
          <span class="chat-pinned-format">{{ booking.offerLabel }}</span>
        </div>
        <div class="chat-pinned-date">
          <i class="ti ti-calendar" style="font-size:14px;"></i>
          {{ booking.startAt|date('d/m/Y \\à H\\hi') }}
        </div>
      </div>
      <div class="chat-pinned-price">{{ booking.prixFormatted }}</div>
    </div>

    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header-avatar-wrap">
        <div class="chat-header-avatar">
          {% if interlocuteur %}
            {%- set words = interlocuteur.nomComplet|split(' ') -%}
            {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
          {% else %}?{% endif %}
        </div>
        {# ── INDICATEUR EN LIGNE ── #}
        {% if interlocuteur %}
          {% set lastSeen = interlocuteur.lastSeenAt %}
          {% set isOnline = lastSeen and lastSeen > date('-5 minutes') %}
          <span class="chat-header-presence {{ isOnline ? 'is-online' : 'is-offline' }}"
                title="{{ isOnline ? 'En ligne' : 'Hors ligne' }}"></span>
        {% endif %}
      </div>
      <div>
        <div class="chat-header-name">{{ interlocuteur ? interlocuteur.nomComplet : 'Coach' }}</div>
        <div class="chat-header-sub">
          {% if interlocuteur %}
            {% set lastSeen = interlocuteur.lastSeenAt %}
            {% if lastSeen and lastSeen > date('-5 minutes') %}
              <span style="color:var(--green);">● En ligne</span>
            {% elseif lastSeen %}
              Vu {{ lastSeen|date('d/m \\à H\\hi') }}
            {% else %}
              {{ conversation.booking.reference }}
            {% endif %}
          {% endif %}
        </div>
      </div>
      <a href="{{ path('app_conversation_inbox') }}" class="btn btn-ghost btn-sm" style="margin-left:auto;">
        <i class="ti ti-arrow-left"></i> Retour
      </a>
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chat-stream">
      {% if messages is empty %}
        <div style="text-align:center;padding:40px;color:var(--text-dim);font-style:italic;font-family:'Cormorant Garamond',serif;font-size:18px;">
          Aucun message pour l'instant. Soyez le premier à écrire !
        </div>
      {% else %}
        {% for message in messages %}
          {% set isMine = (message.author == app.user) %}
          <div class="msg {{ isMine ? 'msg--mine' : 'msg--theirs' }}">
            <div class="msg-bubble">
              {{- message.content|nl2br -}}
              <span class="msg-time">{{ message.createdAt|date('H:i') }}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {# ── QUICK REPLIES (coach uniquement) ── #}
    {% if is_granted('ROLE_COACH') %}
      <div class="chat-quick-replies">
        <span class="chat-quick-replies-label">Réponses rapides :</span>
        <button type="button" class="chat-quick-reply" data-text="Ça marche, à ce soir 💪">Ça marche 💪</button>
        <button type="button" class="chat-quick-reply" data-text="Petit retard de ~10 min, désolé !">Retard ~10 min</button>
        <button type="button" class="chat-quick-reply" data-text="On peut reprogrammer ? Donne-moi tes dispos.">Reprogrammer ?</button>
        <button type="button" class="chat-quick-reply" data-text="Pense à ramener une serviette et de l'eau.">Pense à tes affaires</button>
        <button type="button" class="chat-quick-reply" data-text="Séance confirmée. Hâte de te voir 🔥">Confirme + Hâte 🔥</button>
      </div>
    {% endif %}

    <!-- Input -->
    <form class="chat-input"
          method="post"
          action="{{ path('app_conversation_send', {id: conversation.id}) }}">
      <textarea
          id="chat-textarea"
          name="content"
          maxlength="2000"
          rows="1"
          placeholder="Votre message…"
          required></textarea>
      <input type="hidden" name="_token" value="{{ csrf_token('msg' ~ conversation.id) }}">
      <button type="submit" class="btn btn-primary">
        <i class="ti ti-send"></i>
      </button>
    </form>

    {# JS quick replies #}
    <script>
      document.querySelectorAll('.chat-quick-reply').forEach(btn => {
        btn.addEventListener('click', () => {
          const ta = document.getElementById('chat-textarea');
          ta.value = btn.dataset.text;
          ta.focus();
        });
      });
    </script>
  </div>

</div>

{# Scroll to bottom #}
<script>
  const stream = document.getElementById('chat-stream');
  if (stream) stream.scrollTop = stream.scrollHeight;
</script>
{% endblock %}

{% block mercure %}
    <script>
        const currentUserId = {{ app.user.id }};
        const chatStream = document.getElementById('chat-stream');

        const es = new EventSource(
            "{{ mercure('conversation/' ~ conversation.id)|escape('js') }}",
            { withCredentials: false }
        );

        es.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.type !== 'new_message' || data.author_id === currentUserId) {
                return;
            }

            const msg = document.createElement('div');
            msg.className = 'msg msg--theirs';

            const bubble = document.createElement('div');
            bubble.className = 'msg-bubble';

            const content = document.createElement('span');
            content.textContent = data.content;

            const time = document.createElement('span');
            time.className = 'msg-time';
            time.textContent = data.created_at;

            bubble.appendChild(content);
            bubble.appendChild(time);
            msg.appendChild(bubble);
            chatStream.appendChild(msg);

            chatStream.scrollTop = chatStream.scrollHeight;
        };
    </script>
{% endblock %}
