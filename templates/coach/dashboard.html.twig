{% extends 'base.html.twig' %}

{% block title %}Espace Coach — SPORT+{% endblock %}

{% block body %}
<div class="container">

  <div class="page-header">
    <div>
      <h1>Espace <span style="color:var(--gold)">Coach</span></h1>
      <p class="page-subtitle">{{ app.user.nomComplet }}</p>
    </div>
  </div>

  {# ── TOGGLE DISPONIBILITÉ NUIT ── #}
  {% set coach = app.user.coach %}
  {% if coach %}
    <div class="night-toggle-card {{ coach.isAvailableTonightNow ? 'is-on' : 'is-off' }}">
      <div class="night-toggle-icon">
        <i class="ti ti-moon-stars"></i>
      </div>
      <div class="night-toggle-body">
        <div class="night-toggle-title">Disponibilité cette nuit</div>
        {% if coach.isAvailableTonightNow %}
          <div class="night-toggle-status night-toggle-status-on">
            <span class="night-toggle-dot"></span>
            Tu es annoncé <strong>disponible cette nuit</strong> sur le site jusqu'à {{ coach.availableTonightSetAt|date_modify('+24 hours')|date('H:i') }} demain.
          </div>
        {% else %}
          <div class="night-toggle-status night-toggle-status-off">
            Active ce toggle pour annoncer aux clients que tu es dispo pour Night Coach / Astreinte cette nuit.
          </div>
        {% endif %}
      </div>
      <form method="post" action="{{ path('app_coach_toggle_tonight') }}" class="night-toggle-form">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle_tonight') }}">
        <button type="submit" class="night-toggle-switch" aria-label="Toggle disponibilité cette nuit">
          <span class="night-toggle-knob"></span>
        </button>
      </form>
    </div>
  {% endif %}

  {# ── Stat cards ── #}
  <div class="stats-grid">
    <div class="stat-card {{ nbPending > 0 ? 'success' : 'warning' }}">
      <span class="stat-label">En attente</span>
      <span class="stat-value">{{ nbPending }}</span>
    </div>
    <div class="stat-card warning">
      <span class="stat-label">Confirmées ce mois</span>
      <span class="stat-value">{{ nbConfirmedThisMonth }}</span>
    </div>
    <div class="stat-card warning">
      <span class="stat-label">Revenus du mois</span>
      <span class="stat-value" style="font-size:28px;">{{ revenueThisMonth|number_format(2, ',', ' ') }} €</span>
    </div>
    <div class="stat-card warning">
      <span class="stat-label">Revenus totaux</span>
      <span class="stat-value" style="font-size:28px;">{{ revenueAllTime|number_format(2, ',', ' ') }} €</span>
    </div>
  </div>

  {# ── DÉCLARATIONS DE PAIEMENT EN ATTENTE ──
     On exclut les séances couvertes par un pack mensuel ou l'offre Fondateur :
     le client a déjà payé en amont, il n'y a rien à déclarer comme mode d'encaissement. #}
  {% set sessionsAValider = [] %}
  {% for b in historyBookings ?? [] %}
    {% if b.status == 'confirmed' and b.startAt < date() and b.paymentMethod is null and b.coveredBy is null %}
      {% set sessionsAValider = sessionsAValider|merge([b]) %}
    {% endif %}
  {% endfor %}

  {% if sessionsAValider|length > 0 %}
    <div class="form-card" style="margin-top:32px;border-left:3px solid var(--gold);">
      <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--white);margin-bottom:8px;">
        <i class="ti ti-cash" style="color:var(--gold);"></i> Paiements à déclarer
      </h2>
      <p style="font-size:14px;color:var(--text-dim);margin-bottom:20px;">
        Pour chaque séance passée, indique comment le client t'a payé. Cette info est visible par l'administration.
      </p>
      {% for b in sessionsAValider %}
        {% set intent = b.intendedPaymentMethod %}
        {% set intentLabels = {'cash': 'Espèces', 'card': 'Carte bancaire', 'xplor': 'Xplor Active'} %}
        <div class="pay-decl-card">
          <div class="pay-decl-head">
            <div class="pay-decl-client">
              <i class="ti ti-user"></i> {{ b.client.nomComplet }}
            </div>
            <div class="pay-decl-amount">{{ b.displayAmountFormatted }}</div>
          </div>
          <div class="pay-decl-meta">
            <span><i class="ti ti-calendar"></i> {{ b.startAt|date('d/m/Y \\à H\\hi') }}</span>
            <span><i class="ti ti-tag"></i> {{ b.offerLabel }}</span>
            {% if intent %}
              <span class="pay-decl-intent"><i class="ti ti-flag"></i> Annoncé : <strong>{{ intentLabels[intent] }}</strong></span>
            {% endif %}
          </div>
          <form method="post" action="{{ path('app_coach_declare_payment', {id: b.id}) }}" class="pay-decl-form">
            <input type="hidden" name="_token" value="{{ csrf_token('declare_payment_' ~ b.id) }}">
            <div class="pay-decl-options">
              <label class="pay-decl-chip" data-method="cash">
                <input type="radio" name="method" value="cash" required {{ intent == 'cash' ? 'checked' : '' }}>
                <i class="ti ti-cash"></i>
                <span>Espèces</span>
              </label>
              <label class="pay-decl-chip" data-method="card">
                <input type="radio" name="method" value="card" required {{ intent == 'card' ? 'checked' : '' }}>
                <i class="ti ti-credit-card"></i>
                <span>Carte bancaire</span>
              </label>
              <label class="pay-decl-chip" data-method="xplor">
                <input type="radio" name="method" value="xplor" required {{ intent == 'xplor' ? 'checked' : '' }}>
                <i class="ti ti-leaf"></i>
                <span>Xplor Active</span>
              </label>
            </div>
            <button type="submit" class="pay-decl-submit">
              <i class="ti ti-check"></i> Confirmer l'encaissement
            </button>
          </form>

          {# ── Bouton "Pas venu" — séparé pour éviter clic accidentel ── #}
          <form method="post" action="{{ path('app_coach_mark_no_show', {id: b.id}) }}" class="no-show-form"
                data-confirm-title="Marquer le client absent ?"
                data-confirm="Le client {{ b.client.nomComplet }} n'est pas venu. Des frais de 30 % (soit {{ ((b.price ?? 0) * 0.30)|number_format(2, ',', ' ') }} €) seront notés à facturer."
                data-confirm-button="Oui, marquer absent"
                data-confirm-danger="true">
            <input type="hidden" name="_token" value="{{ csrf_token('no_show_' ~ b.id) }}">
            <button type="submit" class="no-show-btn">
              <i class="ti ti-user-x"></i> Client absent — facturer l'absence
            </button>
          </form>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# ── Demandes en attente ── #}
  <div class="section-label">
    <i class="ti ti-bell" style="margin-right:6px;"></i> Demandes en attente
  </div>

  {% if pendingBookings is empty %}
    <div style="padding:32px 0;color:var(--text-dim);display:flex;align-items:center;gap:10px;margin-bottom:40px;">
      <i class="ti ti-circle-check" style="color:var(--green);font-size:20px;"></i>
      Aucune demande en attente.
    </div>
  {% else %}
    <div class="cards-grid" style="margin-bottom:40px;">
      {% for booking in pendingBookings %}
        <div class="coach-card" style="align-items:flex-start;text-align:left;border-color:rgba(200,169,81,.3);">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;width:100%;margin-bottom:16px;">
            <div class="coach-name" style="font-size:18px;">{{ booking.offerLabel }}</div>
            <span class="status-badge pending"><i class="ti {{ booking.statutIcon }}"></i>{{ booking.statutLabel }}</span>
          </div>
          <div style="width:100%;display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
            <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
              <i class="ti ti-calendar" style="color:var(--gold-dim);"></i>
              {{ booking.startAt|date('d/m/Y à H:i') }}
              <span style="color:var(--border);">—</span>
              {{ booking.durationMinutes }} min
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text-dim);">
              <i class="ti ti-user" style="color:var(--gold-dim);"></i>
              {{ booking.client.nomComplet }}
              {% if booking.client.phone %}
                · {{ booking.client.phone }}
              {% endif %}
            </div>
            <div style="text-align:right;">
              <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;color:var(--gold);">
                {{ booking.displayAmountFormatted }}
              </div>
              {% if booking.coveredBy == 'founding' %}
                <div style="font-size:11px;color:var(--gold);letter-spacing:1px;text-transform:uppercase;margin-top:2px;"><i class="ti ti-crown"></i> Couvert Fondateur</div>
              {% elseif booking.coveredBy == 'subscription' and booking.subscription %}
                <div style="font-size:11px;color:var(--green);letter-spacing:1px;text-transform:uppercase;margin-top:2px;"><i class="ti ti-check"></i> Couvert {{ booking.subscription.packType.label }}</div>
              {% endif %}
            </div>
          </div>
          {% if booking.message %}
            <div style="background:var(--bg-3);border:1px solid var(--border);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;width:100%;font-size:14px;color:var(--text-dim);font-style:italic;">
              "{{ booking.message }}"
            </div>
          {% endif %}
          <div class="booking-card-actions">
            <form action="{{ path('app_coach_accept', {id: booking.id}) }}" method="post" style="display:inline;">
              <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ booking.id) }}">
              <button type="submit" class="action-btn action-btn--confirm">
                <i class="ti ti-check"></i> Accepter
              </button>
            </form>
            <button type="button" class="action-btn action-btn--danger" data-refuse-open="{{ booking.id }}">
              <i class="ti ti-x"></i> Refuser
            </button>
          </div>

          {# ── Modal "Pourquoi refuses-tu ?" ── #}
          <div class="refuse-modal" id="refuse-modal-{{ booking.id }}" hidden>
            <div class="refuse-modal-overlay" data-refuse-close="{{ booking.id }}"></div>
            <form action="{{ path('app_coach_refuse', {id: booking.id}) }}" method="post" class="refuse-modal-card">
              <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ booking.id) }}">
              <button type="button" class="refuse-modal-close" data-refuse-close="{{ booking.id }}" aria-label="Fermer">
                <i class="ti ti-x"></i>
              </button>
              <div class="refuse-modal-head">
                <div class="refuse-modal-icon"><i class="ti ti-mood-sad"></i></div>
                <h3 class="refuse-modal-title">Pourquoi refuses-tu ?</h3>
                <p class="refuse-modal-sub">
                  Le client <strong>{{ booking.client.nomComplet }}</strong> verra ton message sur sa page de suivi. Sois clair et bienveillant.
                </p>
              </div>

              <div class="refuse-modal-presets">
                <button type="button" class="refuse-preset" data-reason="Désolé, je ne suis pas disponible sur ce créneau.">
                  <i class="ti ti-calendar-x"></i> Indisponible sur ce créneau
                </button>
                <button type="button" class="refuse-preset" data-reason="Le créneau demandé est en dehors de mes horaires habituels.">
                  <i class="ti ti-clock-off"></i> Hors de mes horaires
                </button>
                <button type="button" class="refuse-preset" data-reason="Je ne prends plus de nouveaux clients pour le moment, je suis complet.">
                  <i class="ti ti-users-off"></i> Planning complet
                </button>
                <button type="button" class="refuse-preset" data-reason="Ce format de séance n'est pas dans mes spécialités. Je te conseille un autre coach.">
                  <i class="ti ti-bulb"></i> Pas mon format
                </button>
              </div>

              <label class="refuse-modal-label" for="refuse-reason-{{ booking.id }}">
                Ton message au client <span style="color:var(--text-dim);font-weight:400;">(optionnel mais recommandé)</span>
              </label>
              <textarea
                id="refuse-reason-{{ booking.id }}"
                name="reason"
                rows="3"
                maxlength="500"
                class="refuse-modal-textarea"
                placeholder="Ex : Désolé, je ne suis pas disponible ce jour-là. N'hésite pas à proposer un autre créneau."
              ></textarea>

              <div class="refuse-modal-actions">
                <button type="button" class="action-btn action-btn--ghost" data-refuse-close="{{ booking.id }}">
                  Annuler
                </button>
                <button type="submit" class="action-btn action-btn--danger">
                  <i class="ti ti-x"></i> Confirmer le refus
                </button>
              </div>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# ── Séances à venir ── #}
  <div class="section-label">
    <i class="ti ti-calendar-event" style="margin-right:6px;"></i> Mes séances à venir
  </div>

  {% if upcomingBookings is empty %}
    <p style="color:var(--text-dim);margin-bottom:40px;">Aucune séance confirmée à venir.</p>
  {% else %}
    <div class="data-table-card" style="margin-bottom:40px;">
      <table>
        <thead>
          <tr>
            <th>Prestation</th>
            <th>Date</th>
            <th>Client</th>
            <th>Prix</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for booking in upcomingBookings %}
            {# Séance prévue dans les 24 prochaines heures ? → on suggère la relance téléphone si non confirmé #}
            {% set isImminent = booking.startAt|date('U') - 'now'|date('U') < 86400 %}
            <tr>
              <td style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.offerLabel }}</td>
              <td style="color:var(--text-dim);">
                {{ booking.startAt|date('d/m/Y à H\\hi') }}
                <span style="color:var(--gold);font-size:11px;font-weight:600;">· {{ booking.durationFormatted }}</span>
              </td>
              <td style="color:var(--text-dim);">
                {{ booking.client.nomComplet }}
                {% if booking.client.phone %}
                  <a href="tel:{{ booking.client.phone|replace({' ': '', '.': '', '-': ''}) }}"
                     style="display:inline-flex;align-items:center;gap:4px;margin-top:4px;font-size:12px;color:var(--green);text-decoration:none;font-family:ui-monospace,'SF Mono',Menlo,monospace;">
                    <i class="ti ti-phone" style="font-size:13px;"></i> {{ booking.client.phone }}
                  </a>
                {% endif %}
                <div style="margin-top:8px;">
                  {% if booking.clientConfirmedAt %}
                    <span class="confirm-badge confirm-badge--confirmed">
                      <i class="ti ti-user-check"></i> Présence confirmée
                    </span>
                  {% else %}
                    <span class="confirm-badge confirm-badge--pending">
                      <i class="ti ti-clock-hour-4"></i> En attente de confirmation
                    </span>
                    {% if isImminent and booking.client.phone %}
                      <div class="confirm-badge-hint">
                        <i class="ti ti-phone-call"></i> À relancer rapidement
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              </td>
              <td style="color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;">
                {{ booking.displayAmountFormatted }}
                {% if booking.coveredBy == 'founding' %}<br><span style="font-size:10px;color:var(--gold);font-weight:600;letter-spacing:1px;">FONDATEUR</span>{% endif %}
                {% if booking.coveredBy == 'subscription' and booking.subscription %}<br><span style="font-size:10px;color:var(--green);font-weight:600;letter-spacing:1px;">VIA {{ booking.subscription.packType.label|upper }}</span>{% endif %}
              </td>
              <td>
                {% if booking.conversation %}
                  <a href="{{ path('app_conversation_show', {id: booking.conversation.id}) }}" class="action-btn">
                    <i class="ti ti-message"></i> Messagerie
                  </a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {# ── Historique récent ── #}
  <div class="section-label">
    <i class="ti ti-history" style="margin-right:6px;"></i> Historique récent
  </div>

  {% if historyBookings is empty %}
    <p style="color:var(--text-dim);margin-bottom:40px;">Aucun historique pour le moment.</p>
  {% else %}
    <div class="data-table-card" style="margin-bottom:40px;">
      <table>
        <thead>
          <tr>
            <th>Prestation</th>
            <th>Date</th>
            <th>Client</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          {% for booking in historyBookings %}
            <tr>
              <td style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.offerLabel }}</td>
              <td style="color:var(--text-dim);">
                {{ booking.startAt|date('d/m/Y à H\\hi') }}
                <span style="color:var(--gold);font-size:11px;font-weight:600;">· {{ booking.durationFormatted }}</span>
              </td>
              <td style="color:var(--text-dim);">
                {{ booking.client.nomComplet }}
                {% if booking.client.phone %}
                  <a href="tel:{{ booking.client.phone|replace({' ': '', '.': '', '-': ''}) }}"
                     style="display:inline-flex;align-items:center;gap:4px;margin-top:4px;font-size:12px;color:var(--green);text-decoration:none;font-family:ui-monospace,'SF Mono',Menlo,monospace;">
                    <i class="ti ti-phone" style="font-size:13px;"></i> {{ booking.client.phone }}
                  </a>
                {% endif %}
              </td>
              <td><span class="status-badge {{ booking.status }}"><i class="ti {{ booking.statutIcon }}"></i>{{ booking.statutLabel }}</span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>

{# Zone de toasts Mercure #}
<div class="toast-zone" id="toast-zone"></div>

{% endblock %}

{% block mercure %}
    <script>
        function showToast(text) {
            const zone = document.getElementById('toast-zone');
            const t = document.createElement('div');
            t.className = 'toast';
            t.textContent = text;
            zone.appendChild(t);
            requestAnimationFrame(() => requestAnimationFrame(() => t.classList.add('is-visible')));
            setTimeout(() => {
                t.classList.remove('is-visible');
                t.addEventListener('transitionend', () => location.reload(), { once: true });
            }, 4000);
        }

        const es = new EventSource(
            "{{ mercure('coach/' ~ app.user.id ~ '/stream')|escape('js') }}",
            { withCredentials: false }
        );

        es.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.type === 'new_booking') {
                if (data.sound) {
                    new Audio('/sounds/notification.mp3').play().catch(() => {});
                }
                showToast('Nouvelle demande de ' + data.client + ' pour le ' + data.start);
            }
        };

        // ── Modal refus : ouvre / ferme / presets ────────────────────────────
        // On déplace chaque refuse-modal en racine du body (au load) pour que
        // son position:fixed + z-index soient globaux. Sinon elle reste confinée
        // dans la card parente (qui a des transforms data-animate) et peut
        // passer sous le header/sidebar.
        document.querySelectorAll('.refuse-modal').forEach(modal => {
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
        });
        document.querySelectorAll('[data-refuse-open]').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.refuseOpen;
                const modal = document.getElementById('refuse-modal-' + id);
                if (!modal) return;
                modal.hidden = false;
                document.body.style.overflow = 'hidden';
                const ta = modal.querySelector('textarea[name="reason"]');
                if (ta) setTimeout(() => ta.focus(), 50);
            });
        });
        document.querySelectorAll('[data-refuse-close]').forEach(el => {
            el.addEventListener('click', () => {
                const id = el.dataset.refuseClose;
                const modal = document.getElementById('refuse-modal-' + id);
                if (!modal) return;
                modal.hidden = true;
                document.body.style.overflow = '';
            });
        });
        document.querySelectorAll('.refuse-preset').forEach(btn => {
            btn.addEventListener('click', () => {
                const ta = btn.closest('.refuse-modal-card').querySelector('textarea[name="reason"]');
                if (ta) {
                    ta.value = btn.dataset.reason;
                    ta.focus();
                    btn.closest('.refuse-modal-presets').querySelectorAll('.refuse-preset').forEach(b => b.classList.remove('is-selected'));
                    btn.classList.add('is-selected');
                }
            });
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                document.querySelectorAll('.refuse-modal:not([hidden])').forEach(m => {
                    m.hidden = true;
                    document.body.style.overflow = '';
                });
            }
        });
    </script>
{% endblock %}
