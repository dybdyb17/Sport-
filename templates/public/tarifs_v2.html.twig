{% extends 'base.html.twig' %}

{% block title %}Tarifs SPORT+ Marseille — Coaching, Night Coach, Pilates Reformer{% endblock %}
{% block meta_description %}<meta name="description" content="Tarifs SPORT+ Marseille : séances, packs mensuels et abonnements Solo/Duo/Groupe, Night Coach & Pilates Reformer dès 35€.">{% endblock %}

{% block body %}
{% set bookingPath = app.user ? path('app_booking_new') : path('app_register') %}

{% set tarifsUrl = app.request.schemeAndHttpHost ~ path('app_tarifs') %}
{% set homeUrl = app.request.schemeAndHttpHost ~ path('app_home') %}
{% set pilatesImageUrl = app.request.schemeAndHttpHost ~ asset('img/formules/PilateReformeur.jpeg') %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "{{ tarifsUrl }}#pilates-reformer-service",
  "name": "Pilates Reformer SPORT+ Marseille",
  "serviceType": "Coaching privé Pilates Reformer",
  "description": "Coaching privé Pilates Reformer à Marseille chez SPORT+ : accompagnement personnalisé, offre de lancement dès 35€ la séance et paiement sur place.",
  "image": "{{ pilatesImageUrl }}",
  "url": "{{ tarifsUrl }}#abonnements",
  "provider": {
    "@type": "SportsActivityLocation",
    "name": "SPORT+ Marseille",
    "url": "{{ homeUrl }}",
    "telephone": "+33491422207",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "164 Chemin de Saint-Jean du Désert",
      "postalCode": "13005",
      "addressLocality": "Marseille",
      "addressCountry": "FR"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Marseille"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Pilates Reformer — Vague 1",
      "price": "35",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/LimitedAvailability",
      "url": "{{ tarifsUrl }}#abonnements"
    },
    {
      "@type": "Offer",
      "name": "Pilates Reformer — Vague 2",
      "price": "45",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/LimitedAvailability",
      "url": "{{ tarifsUrl }}#abonnements"
    },
    {
      "@type": "Offer",
      "name": "Pilates Reformer — Tarif après lancement",
      "price": "60",
      "priceCurrency": "EUR",
      "url": "{{ tarifsUrl }}#abonnements"
    }
  ]
}
</script>

{# ── Hero : priorité au coaching #}
<section class="pub-hero-split pricing-hero">
  <div class="pricing-hero-orb pricing-hero-orb-gold" aria-hidden="true"></div>
  <div class="pricing-hero-orb pricing-hero-orb-green" aria-hidden="true"></div>
  <div class="container">
    <div class="pub-hero-split-grid pricing-hero-grid">
      <div class="pub-hero-split-text pricing-hero-copy" data-animate="fade-up">
        <div class="hero-badge">Coaching de jour comme de nuit</div>
        <h1 class="section-title">Ton coaching, <span class="pricing-accent">à ton rythme</span></h1>
        <p class="section-sub">Découvre en priorité le Night Coach SPORT+, puis nos séances, packs et abonnements pour accéder à la salle 24h/24.</p>
        <div class="pricing-hero-actions">
          <a href="#coaching" class="btn btn-primary btn-lg"><i class="ti ti-moon-stars"></i> Voir le coaching</a>
          <a href="#abonnements" class="btn btn-secondary btn-lg"><i class="ti ti-id-badge-2"></i> Voir les abonnements</a>
        </div>
      </div>
      <div class="pub-hero-split-photo pricing-hero-photo" data-animate="fade-left">
        <img src="{{ asset('img/club-photos/sport-nuit.jpeg') }}" alt="Night Coach SPORT+ Marseille" fetchpriority="high">
        <div class="pricing-hero-panel pricing-hero-panel-night" aria-label="Night Coach SPORT+">
          <span>La signature SPORT+</span>
          <strong>Night Coach</strong>
          <small>20h → minuit · dès 60€</small>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Offre Membre Fondateur #}
{% set fo = foundingOffer|default(null) %}
{% if fo and fo.isStillRunning %}
  {% include 'public/_founding_offer.html.twig' with {fo: fo} %}
{% endif %}

