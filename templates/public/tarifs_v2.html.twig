      </div>

      {# Panneau infos animé à droite #}
      <div class="formule-modal-info">
        <div class="formule-modal-tag" id="formule-modal-tag"></div>
        <h2 class="formule-modal-name" id="formule-modal-name"></h2>

        <div class="formule-modal-price-block">
          <div class="formule-modal-price">
            <span id="formule-modal-price-num">0</span><span class="euro">€</span>
          </div>
          <div class="formule-modal-period" id="formule-modal-period"></div>
        </div>

        <ul class="formule-modal-features" id="formule-modal-features"></ul>

        <div class="formule-modal-fees" id="formule-modal-fees"></div>

        <div class="formule-modal-contact-actions">
          <a href="tel:0491422207" class="btn btn-primary btn-lg formule-modal-cta">
            <i class="ti ti-phone"></i> Appeler la salle
          </a>
          <a href="mailto:ls.sportplus13@gmail.com?subject=Demande%20formule%20SPORT%2B"
             class="btn btn-outline btn-lg formule-modal-cta">
            <i class="ti ti-mail"></i> Envoyer un email
          </a>
        </div>

        <div class="formule-modal-hint">
          <i class="ti ti-map-pin"></i>
          Paiement et inscription directement <strong>sur place</strong> — SPORT+, 164 Chemin de Saint-Jean du Désert, Marseille.
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  var modal       = document.getElementById('formule-modal');
  var modalImg    = document.getElementById('formule-modal-img');
  var modalTag    = document.getElementById('formule-modal-tag');
  var modalName   = document.getElementById('formule-modal-name');
  var modalPrice  = document.getElementById('formule-modal-price-num');
  var modalPeriod = document.getElementById('formule-modal-period');
  var modalFees   = document.getElementById('formule-modal-fees');
  var modalFeat   = document.getElementById('formule-modal-features');

  // Déplace la modale en enfant direct de <body> pour la sortir de tout
  // stacking context d'un parent (transform / will-change / backdrop-filter
  // sur .tarifs-page ou .container). Sans ce move, le z-index: 5000 de la
  // modale reste local à son parent et le header sticky repasse au-dessus
  // sur mobile — bug visible sur iPhone.
  if (modal && modal.parentNode !== document.body) {
    document.body.appendChild(modal);
  }

  // Position de scroll sauvegardée à l'ouverture pour être restaurée au
  // close (technique iOS Safari — overflow: hidden est ignoré, on passe
  // par body en position: fixed avec top: -scrollY inline pour figer la
  // page derrière).
  var savedScrollY = 0;

  function animateNumber(el, target, duration) {
    var start    = 0;
    var startTs  = null;
    function step(ts) {
      if (!startTs) startTs = ts;
      var progress = Math.min((ts - startTs) / duration, 1);
      // ease-out cubic
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(start + (target - start) * eased);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  document.querySelectorAll('.formule-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var card = btn.closest('.formule-card');
      if (!card) return;

      var img      = card.getAttribute('data-img');
      var name     = card.getAttribute('data-name');
      var price    = parseInt(card.getAttribute('data-price'), 10) || 0;
      var period   = card.getAttribute('data-period') || '';
      var tag      = card.getAttribute('data-tag') || '';
      var fees     = card.getAttribute('data-fees') || '';
      var features = [];
      try { features = JSON.parse(card.getAttribute('data-features') || '[]'); } catch (e) {}
      modalImg.src    = img;
      modalImg.alt    = 'Formule ' + name + ' — SPORT+ Marseille';
      modalTag.textContent    = tag;
      modalName.innerHTML     = name.replace('+', '<span style="color:var(--green);">+</span>');
      modalPeriod.textContent = period;
      modalFees.textContent   = fees;

      modalFeat.innerHTML = '';
      features.forEach(function(f, i) {
        var li = document.createElement('li');
        li.style.animationDelay = (0.15 + i * 0.06) + 's';
        li.innerHTML = '<i class="ti ti-circle-check"></i><span>' + f + '</span>';
        modalFeat.appendChild(li);
      });

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      // Lock scroll iOS-compatible : on fige le body en position: fixed
      // (via la classe CSS) avec top: -scrollY inline pour préserver la
      // position visible. Sans ça, la page derrière scrollait sous la
      // modale sur iPhone (overflow: hidden est ignoré par Safari mobile).
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.top = '-' + savedScrollY + 'px';
      document.body.classList.add('formule-modal-open');

      // Anime le prix avec délai pour que ça apparaisse après l'entrée
      modalPrice.textContent = '0';
      setTimeout(function() { animateNumber(modalPrice, price, 600); }, 300);
    });
  });

  window.closeFormuleModal = function() {
    modal.classList.remove('is-open');
    modal.classList.remove('is-pilates');
    modal.setAttribute('aria-hidden', 'true');
    // Retire le lock body puis restaure la position de scroll exacte
    // (évite le "jump to top" qui arriverait sans window.scrollTo).
    document.body.classList.remove('formule-modal-open');
    document.body.style.top = '';
    window.scrollTo(0, savedScrollY);
    savedScrollY = 0;
    setTimeout(function() { modalImg.src = ''; }, 300);
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) {
      window.closeFormuleModal();
    }
  });
})();
</script>


{% endblock %}
