{% extends 'base.html.twig' %}

{% block title %}Contact — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Contactez SPORT+ Marseille — 164 Chemin de Saint-Jean du Désert, 13005. Tél. 04 91 42 22 07. Ouvert 24h/24, 7j/7.">{% endblock %}

{% block body %}

{# Mini hero #}
<section class="pub-hero" data-bg style="padding:80px 0 60px;text-align:center;--hero-bg:url('{{ asset('img/club-photos/duo-rire.jpg') }}');">
  <div class="container">
    <div class="hero-badge">Nous contacter</div>
    <h1 class="section-title" style="margin-top:16px;">Prenons <span style="color:var(--gold)">contact</span></h1>
    <p class="section-sub">Une question ? Une demande particulière ? On est là.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:48px;align-items:start;max-width:1000px;margin:0 auto;">

      <!-- Infos -->
      <div>
        <div class="section-label" style="margin-top:0;margin-bottom:20px;">Informations</div>
        <div class="feature-card" style="margin-bottom:16px;">
          <div class="feature-icon"><i class="ti ti-map-pin"></i></div>
          <div class="feature-title">Adresse</div>
          <p class="feature-text">164 Chemin de Saint-Jean du Désert<br>13005 Marseille</p>
        </div>
        <div class="feature-card" style="margin-bottom:16px;">
          <div class="feature-icon"><i class="ti ti-phone"></i></div>
          <div class="feature-title">Téléphone</div>
          <p class="feature-text"><a href="tel:0491422207" style="color:var(--gold);text-decoration:none;">04 91 42 22 07</a></p>
        </div>
        <div class="feature-card" style="margin-bottom:16px;">
          <div class="feature-icon"><i class="ti ti-clock-24"></i></div>
          <div class="feature-title">Horaires</div>
          <p class="feature-text">Ouvert 24h/24 — 7j/7<br>Night Coach disponible dès 20h<br>Sans engagement</p>
        </div>

        <div class="section-label" style="margin-top:24px;margin-bottom:16px;">Réseaux sociaux</div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <a href="https://www.facebook.com/sportplus13005/?locale=fr_FR" target="_blank" rel="noopener noreferrer" class="feature-card" style="flex-direction:row;align-items:center;gap:16px;padding:16px 20px;text-decoration:none;">
            <div style="width:40px;height:40px;border-radius:50%;background:rgba(200,169,81,.1);border:1px solid rgba(200,169,81,.2);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:18px;flex-shrink:0;">
              <i class="ti ti-brand-facebook"></i>
            </div>
            <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--white);">@sportplus13005</span>
          </a>
          <a href="https://www.instagram.com/sportplus13005?igsh=dGd2NmVsY2JzMDF4" target="_blank" rel="noopener noreferrer" class="feature-card" style="flex-direction:row;align-items:center;gap:16px;padding:16px 20px;text-decoration:none;">
            <div style="width:40px;height:40px;border-radius:50%;background:rgba(200,169,81,.1);border:1px solid rgba(200,169,81,.2);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:18px;flex-shrink:0;">
              <i class="ti ti-brand-instagram"></i>
            </div>
            <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--white);">@sportplus13005</span>
          </a>
          <a href="https://www.linkedin.com/company/sport-13/" target="_blank" rel="noopener noreferrer" class="feature-card" style="flex-direction:row;align-items:center;gap:16px;padding:16px 20px;text-decoration:none;">
            <div style="width:40px;height:40px;border-radius:50%;background:rgba(200,169,81,.1);border:1px solid rgba(200,169,81,.2);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:18px;flex-shrink:0;">
              <i class="ti ti-brand-linkedin"></i>
            </div>
            <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--white);">SPORT+ 13</span>
          </a>
          <a href="https://www.tiktok.com/@sizlo_personal_trainer" target="_blank" rel="noopener noreferrer" class="feature-card" style="flex-direction:row;align-items:center;gap:16px;padding:16px 20px;text-decoration:none;">
            <div style="width:40px;height:40px;border-radius:50%;background:rgba(200,169,81,.1);border:1px solid rgba(200,169,81,.2);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:18px;flex-shrink:0;">
              <i class="ti ti-brand-tiktok"></i>
            </div>
            <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;color:var(--white);">@sizlo_personal_trainer</span>
          </a>
        </div>
      </div>

      <!-- Map + formulaire -->
      <div>
        <div class="section-label" style="margin-top:0;margin-bottom:20px;">Nous trouver</div>

        {# OpenStreetMap embed — sans API key, sans cookie tiers #}
        <div style="border-radius:var(--radius-lg);overflow:hidden;margin-bottom:32px;border:1px solid var(--border);background:var(--bg-card);">
          <iframe
            src="https://www.openstreetmap.org/export/embed.html?bbox=5.4063%2C43.2926%2C5.4223%2C43.3006&layer=mapnik&marker=43.2966%2C5.4143"
            width="100%"
            height="320"
            style="border:0;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Carte de SPORT+ — 164 Chemin de Saint-Jean du Désert, 13005 Marseille"
          ></iframe>
          <div style="padding:12px 16px;background:var(--bg-3);font-size:13px;color:var(--text-soft);display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <span><i class="ti ti-map-pin" style="color:var(--gold);"></i> 164 Chemin de Saint-Jean du Désert, 13005 Marseille</span>
            <a href="https://www.openstreetmap.org/?mlat=43.2966&mlon=5.4143#map=16/43.2966/5.4143" target="_blank" rel="noopener noreferrer" style="color:var(--gold);text-decoration:none;white-space:nowrap;">
              Voir en grand →
            </a>
          </div>
        </div>

        <div class="section-label" style="margin-bottom:20px;">Envoyer un message</div>
        <form method="post" action="{{ path('app_contact') }}" style="display:flex;flex-direction:column;gap:16px;">
          <input type="hidden" name="_token" value="{{ csrf_token('contact-form') }}">
          <div class="form-field" style="margin-bottom:0;">
            <label for="contact_name">Nom complet *</label>
            <input type="text" id="contact_name" name="name" required placeholder="Votre nom et prénom">
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <label for="contact_email">Email *</label>
            <input type="email" id="contact_email" name="email" required placeholder="votre@email.fr">
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <label for="contact_phone">Téléphone <span style="color:var(--text-dim);font-weight:400;">(optionnel)</span></label>
            <input type="tel" id="contact_phone" name="phone" placeholder="06 12 34 56 78">
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <label for="contact_message">Message *</label>
            <textarea id="contact_message" name="message" required placeholder="Votre message..." style="min-height:140px;"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="align-self:flex-start;">
            <i class="ti ti-send"></i> Envoyer le message
          </button>
        </form>
      </div>

    </div>

    {# CTA #}
    <div style="text-align:center;margin-top:64px;">
      <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-lg">
        <i class="ti ti-calendar-plus"></i> Réserver une séance
      </a>
    </div>

  </div>
</section>

{% endblock %}
