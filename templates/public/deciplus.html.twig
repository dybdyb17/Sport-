{% extends 'base.html.twig' %}

{% block title %}Espace Membre Deciplus — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Accédez à votre espace membre SPORT+ Marseille via Deciplus : réservations, planning, abonnements et accès salle 24h/24.">{% endblock %}

{% block body %}

{# ── Hero ── #}
<section class="pub-hero" style="padding:60px 0 40px;text-align:center;">
  <div class="container">
    <div class="hero-badge">Espace Membre</div>
    <h1 class="section-title" style="margin-top:12px;">
      Votre espace <span style="color:var(--green)">Deciplus</span>
    </h1>
    <p class="section-sub" style="margin-bottom:0;">
      Réservations, planning, abonnements et accès salle 24h/24.
    </p>
  </div>
</section>

<section class="section" style="padding-top:32px;">
  <div class="container">

    {# ── Code Centre + Decipass — stacked sur mobile ── #}
    <div class="deciplus-info-grid">

      {# Code Centre #}
      <div class="deciplus-card deciplus-card-green">
        <div class="deciplus-card-header">
          <div class="deciplus-icon">
            <i class="ti ti-building"></i>
          </div>
          <div>
            <div class="deciplus-card-title">Code Centre</div>
            <div class="deciplus-card-sub">Pour rejoindre SPORT+ sur l'app</div>
          </div>
        </div>
        <div class="deciplus-code-box">
          <span class="deciplus-code-value">{{ codeCentre }}</span>
          <button class="deciplus-copy-btn"
                  onclick="navigator.clipboard.writeText('{{ codeCentre }}').then(()=>{this.textContent='✓ Copié';setTimeout(()=>{this.textContent='Copier';},1500)})"
                  aria-label="Copier le code centre">
            Copier
          </button>
        </div>
        <p class="deciplus-hint">
          Ouvre <strong>Xplor Active</strong>, entre ce code pour accéder à SPORT+.
        </p>
      </div>

      {# Decipass #}
      <div class="deciplus-card">
        <div class="deciplus-card-header">
          <div class="deciplus-icon">
            <i class="ti ti-qrcode"></i>
          </div>
          <div>
            <div class="deciplus-card-title">Decipass</div>
            <div class="deciplus-card-sub">Accès salle 24h/24 par QR code</div>
          </div>
        </div>
        <p class="deciplus-hint" style="margin-bottom:16px;">
          Ton <strong>Decipass</strong> est un QR code dans l'app qui remplace le badge physique. Présente-le devant le lecteur à l'entrée pour ouvrir la porte.
        </p>
        <div class="deciplus-app-links">
          <a href="https://apps.apple.com/fr/app/xplor-active/id1519197587"
             target="_blank" rel="noopener noreferrer" class="deciplus-app-btn">
            <i class="ti ti-brand-apple"></i> App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=com.lodecom.apps.deciplusmember&hl=fr"
             target="_blank" rel="noopener noreferrer" class="deciplus-app-btn">
            <i class="ti ti-brand-google-play"></i> Google Play
          </a>
        </div>
      </div>

    </div>

    {# ── Aide rapide ── #}
    <div class="deciplus-help">
      <div class="deciplus-help-title">
        <i class="ti ti-help-circle" style="color:var(--green);"></i> Comment ça marche
      </div>
      <div class="deciplus-steps">
        <div class="deciplus-step">
          <div class="deciplus-step-num">1</div>
          <div>
            <strong>Télécharge Xplor Active</strong><br>
            <span>App Store ou Google Play</span>
          </div>
        </div>
        <div class="deciplus-step">
          <div class="deciplus-step-num">2</div>
          <div>
            <strong>Entre le code <span style="color:var(--green)">{{ codeCentre }}</span></strong><br>
            <span>Pour rejoindre SPORT+</span>
          </div>
        </div>
        <div class="deciplus-step">
          <div class="deciplus-step-num">3</div>
          <div>
            <strong>Récupère ton Decipass</strong><br>
            <span>QR code → accès salle 24h/24</span>
          </div>
        </div>
      </div>
    </div>

    {# ── Iframe Deciplus ── #}
    <div class="deciplus-frame-section">

      <div class="section-label" style="margin-bottom:16px;">Planning & réservations</div>

      {# Tabs ── #}
      <div class="deciplus-tabs" role="tablist">
        <button class="deciplus-tab deciplus-tab-active"
                onclick="switchTab(this,'https://member-app.deciplus.pro/{{ slug }}/calendar')"
                role="tab" aria-selected="true">
          <i class="ti ti-calendar"></i><span>Planning</span>
        </button>
        <button class="deciplus-tab"
                onclick="switchTab(this,'https://member-app.deciplus.pro/{{ slug }}/tunnel')"
                role="tab" aria-selected="false">
          <i class="ti ti-user-plus"></i><span>Inscription</span>
        </button>
        <button class="deciplus-tab"
                onclick="switchTab(this,'https://member-app.deciplus.pro/{{ slug }}/shop')"
                role="tab" aria-selected="false">
          <i class="ti ti-shopping-cart"></i><span>Boutique</span>
        </button>
      </div>

      {# Iframe ── #}
      <div class="deciplus-frame-wrapper">
        <iframe
          id="deciplus-frame"
          src="https://member-app.deciplus.pro/{{ slug }}/calendar"
          width="100%"
          height="900"
          frameborder="0"
          allow="camera; microphone"
          loading="lazy"
          title="Espace membre SPORT+ — Deciplus"
          style="display:block;">
        </iframe>
      </div>

    </div>

  </div>
</section>

<script>
function switchTab(btn, url) {
  document.querySelectorAll('.deciplus-tab').forEach(t => {
    t.classList.remove('deciplus-tab-active');
    t.setAttribute('aria-selected', 'false');
  });
  btn.classList.add('deciplus-tab-active');
  btn.setAttribute('aria-selected', 'true');
  document.getElementById('deciplus-frame').src = url;
}
</script>

<style>
/* ── Grille info cards ── */
.deciplus-info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-bottom: 24px;
}
@media (min-width: 640px) {
  .deciplus-info-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
}

/* ── Cards ── */
.deciplus-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
}
.deciplus-card-green {
  border-color: rgba(61,255,20,.4);
  box-shadow: 0 0 24px rgba(61,255,20,.06);
}
.deciplus-card-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
}
.deciplus-icon {
  width: 48px;
  height: 48px;
  background: rgba(61,255,20,.12);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24px;
  color: var(--green);
}
.deciplus-card-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: 18px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--white);
}
.deciplus-card-sub {
  font-size: 14px;
  color: var(--text-soft);
  margin-top: 3px;
}
.deciplus-hint {
  font-size: 15px;
  color: var(--text);
  line-height: 1.7;
  margin: 0;
}

/* ── Code box ── */
.deciplus-code-box {
  background: var(--bg-3);
  border: 1px solid rgba(61,255,20,.25);
  border-radius: var(--radius);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}
.deciplus-code-value {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 32px;
  font-weight: 900;
  color: var(--green);
  letter-spacing: 4px;
}
.deciplus-copy-btn {
  background: rgba(61,255,20,.12);
  border: 1px solid rgba(61,255,20,.4);
  border-radius: var(--radius-sm);
  padding: 8px 16px;
  cursor: pointer;
  color: var(--green);
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
  transition: background .2s;
}
.deciplus-copy-btn:hover { background: rgba(61,255,20,.25); }

/* ── App links ── */
.deciplus-app-links {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.deciplus-app-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 18px;
  background: var(--bg-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--white);
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  transition: border-color .2s, background .2s;
}
.deciplus-app-btn:hover {
  border-color: rgba(61,255,20,.5);
  background: rgba(61,255,20,.06);
}

/* ── Aide rapide ── */
.deciplus-help {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 4px solid var(--green);
  border-radius: var(--radius-lg);
  padding: 22px 24px;
  margin-bottom: 32px;
}
.deciplus-help-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: 18px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--white);
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.deciplus-steps {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
@media (min-width: 640px) {
  .deciplus-steps { flex-direction: row; gap: 24px; }
}
.deciplus-step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 15px;
  color: var(--white);
  line-height: 1.6;
  flex: 1;
}
.deciplus-step strong { color: var(--white); display: block; font-size: 15px; margin-bottom: 2px; }
.deciplus-step span { color: var(--text-soft); font-size: 14px; }
.deciplus-step-num {
  width: 30px;
  height: 30px;
  background: rgba(61,255,20,.14);
  border: 1px solid rgba(61,255,20,.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 900;
  font-size: 15px;
  color: var(--green);
  flex-shrink: 0;
}

/* ── Tabs ── */
.deciplus-frame-section {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 40px;
}
.deciplus-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.deciplus-tabs::-webkit-scrollbar { display: none; }
.deciplus-tab {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 15px 22px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  border-right: 1px solid var(--border);
  cursor: pointer;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  white-space: nowrap;
  transition: color .2s, background .2s;
}
.deciplus-tab:hover { background: rgba(255,255,255,.04); }
.deciplus-tab-active {
  color: var(--green) !important;
  border-bottom-color: var(--green) !important;
  background: rgba(61,255,20,.05);
}
.deciplus-tab span { display: inline; }

/* ── Iframe ── */
.deciplus-frame-wrapper { overflow: hidden; }
.deciplus-frame-wrapper iframe {
  width: 100%;
  min-height: 600px;
  height: 900px;
  display: block;
}

/* ── Mobile ── */
@media (max-width: 640px) {
  .deciplus-card { padding: 18px; }
  .deciplus-card-title { font-size: 16px; }
  .deciplus-hint { font-size: 14px; }
  .deciplus-code-value { font-size: 26px; letter-spacing: 3px; }
  .deciplus-copy-btn { font-size: 13px; padding: 7px 12px; }
  .deciplus-app-btn { font-size: 14px; padding: 10px 14px; }
  .deciplus-step { font-size: 14px; }
  .deciplus-tab { padding: 13px 16px; font-size: 14px; }
  .deciplus-tab span { display: none; }
  .deciplus-tab i { font-size: 20px; }
  .deciplus-frame-wrapper iframe {
    height: 80vh;
    min-height: 500px;
  }
}
</style>

{% endblock %}
