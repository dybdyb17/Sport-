{% extends 'base.html.twig' %}

{% block title %}Espace Membre Deciplus — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Accédez à votre espace membre SPORT+ Marseille via Deciplus : réservations, planning, abonnements et accès salle 24h/24.">{% endblock %}

{% block body %}

{# ── Hero ── #}
<section class="pub-hero" style="padding:80px 0 60px;text-align:center;">
  <div class="container">
    <div class="hero-badge">Espace Membre</div>
    <h1 class="section-title" style="margin-top:16px;">
      Votre espace <span style="color:var(--green)">Deciplus</span>
    </h1>
    <p class="section-sub">Réservations, planning, abonnements — tout gérer directement depuis cette page.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">

    {# ── Code Centre + Decipass ── #}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-bottom:48px;">

      {# Code Centre #}
      <div style="background:var(--bg-card);border:1px solid rgba(61,255,20,.35);
                  border-radius:var(--radius-lg);padding:28px 24px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <div style="width:44px;height:44px;background:rgba(61,255,20,.1);border-radius:10px;
                      display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="ti ti-building" style="font-size:22px;color:var(--green);"></i>
          </div>
          <div>
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:16px;
                        text-transform:uppercase;letter-spacing:1px;color:var(--white);">Code Centre</div>
            <div style="font-size:13px;color:var(--text-dim);">Pour rejoindre le club sur l'app</div>
          </div>
        </div>
        <div style="background:var(--bg-3);border:1px solid var(--border);border-radius:var(--radius);
                    padding:14px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;">
          <span style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;
                       color:var(--green);letter-spacing:4px;">{{ codeCentre }}</span>
          <button onclick="navigator.clipboard.writeText('{{ codeCentre }}').then(()=>{this.innerHTML='<i class=\'ti ti-check\'></i>';setTimeout(()=>{this.innerHTML='<i class=\'ti ti-copy\'></i>';},1500)})"
                  style="background:none;border:1px solid var(--border);border-radius:var(--radius-sm);
                         padding:8px 10px;cursor:pointer;color:var(--text-soft);transition:all .2s;"
                  title="Copier le code">
            <i class="ti ti-copy"></i>
          </button>
        </div>
        <p style="font-size:13px;color:var(--text-dim);margin-top:12px;line-height:1.6;">
          Ouvre l'app <strong style="color:var(--white);">Xplor Active</strong>,
          tape ce code pour retrouver SPORT+ et accéder à tes réservations.
        </p>
      </div>

      {# Decipass / Accès salle #}
      <div style="background:var(--bg-card);border:1px solid var(--border);
                  border-radius:var(--radius-lg);padding:28px 24px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <div style="width:44px;height:44px;background:rgba(61,255,20,.1);border-radius:10px;
                      display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="ti ti-qrcode" style="font-size:22px;color:var(--green);"></i>
          </div>
          <div>
            <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:16px;
                        text-transform:uppercase;letter-spacing:1px;color:var(--white);">Decipass</div>
            <div style="font-size:13px;color:var(--text-dim);">Accès salle 24h/24 via QR code</div>
          </div>
        </div>
        <p style="color:var(--text-soft);font-size:14px;line-height:1.7;margin-bottom:16px;">
          Ton <strong style="color:var(--white);">Decipass</strong> est un QR code personnel dans l'app
          <strong style="color:var(--white);">Xplor Active</strong>. Il remplace le badge physique
          et te permet d'entrer dans la salle à n'importe quelle heure.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="https://apps.apple.com/fr/app/xplor-active/id1479082498"
             target="_blank" rel="noopener noreferrer"
             style="display:inline-flex;align-items:center;gap:8px;padding:10px 16px;
                    background:var(--bg-3);border:1px solid var(--border);border-radius:var(--radius);
                    color:var(--white);text-decoration:none;font-size:13px;font-weight:600;
                    transition:border-color .2s;">
            <i class="ti ti-brand-apple" style="font-size:16px;"></i> App Store
          </a>
          <a href="https://play.google.com/store/apps/details?id=pro.deciplus.xploractive"
             target="_blank" rel="noopener noreferrer"
             style="display:inline-flex;align-items:center;gap:8px;padding:10px 16px;
                    background:var(--bg-3);border:1px solid var(--border);border-radius:var(--radius);
                    color:var(--white);text-decoration:none;font-size:13px;font-weight:600;
                    transition:border-color .2s;">
            <i class="ti ti-brand-google-play" style="font-size:16px;"></i> Google Play
          </a>
        </div>
      </div>

    </div>

    {# ── Iframe Deciplus ── #}
    <div class="section-label" style="margin-bottom:20px;">Planning & réservations</div>

    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);
                overflow:hidden;margin-bottom:48px;">

      {# Tabs de navigation #}
      <div style="display:flex;gap:0;border-bottom:1px solid var(--border);overflow-x:auto;
                  -webkit-overflow-scrolling:touch;">
        <a href="{{ path('app_deciplus') }}#iframe-area"
           onclick="document.getElementById('deciplus-frame').src='https://member-app.deciplus.pro/{{ slug }}/calendar';return false;"
           class="deciplus-tab active-tab" id="tab-calendar">
          <i class="ti ti-calendar"></i> Planning
        </a>
        <a href="{{ path('app_deciplus') }}#iframe-area"
           onclick="document.getElementById('deciplus-frame').src='https://member-app.deciplus.pro/{{ slug }}/tunnel';document.querySelectorAll('.deciplus-tab').forEach(t=>t.classList.remove('active-tab'));this.classList.add('active-tab');return false;"
           class="deciplus-tab" id="tab-inscription">
          <i class="ti ti-user-plus"></i> Inscription
        </a>
        <a href="{{ path('app_deciplus') }}#iframe-area"
           onclick="document.getElementById('deciplus-frame').src='https://member-app.deciplus.pro/{{ slug }}/shop';document.querySelectorAll('.deciplus-tab').forEach(t=>t.classList.remove('active-tab'));this.classList.add('active-tab');return false;"
           class="deciplus-tab" id="tab-shop">
          <i class="ti ti-shopping-cart"></i> Boutique
        </a>
      </div>

      {# Iframe #}
      <div id="iframe-area">
        <iframe
          id="deciplus-frame"
          src="https://member-app.deciplus.pro/{{ slug }}/calendar"
          width="100%"
          height="800"
          frameborder="0"
          allow="camera; microphone"
          loading="lazy"
          title="Espace membre SPORT+ — Deciplus"
          style="display:block;min-height:600px;">
        </iframe>
      </div>

    </div>

    {# ── Aide rapide ── #}
    <div style="background:var(--bg-card);border:1px solid var(--border);border-left:3px solid var(--green);
                border-radius:var(--radius-lg);padding:24px 28px;">
      <div style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:18px;
                  text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;color:var(--white);">
        <i class="ti ti-help-circle" style="color:var(--green);margin-right:8px;"></i>Aide rapide
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--white);margin-bottom:4px;">
            <i class="ti ti-circle-check" style="color:var(--green);margin-right:6px;"></i>
            Première connexion
          </div>
          <p style="font-size:13px;color:var(--text-dim);line-height:1.6;margin:0;">
            Télécharge Xplor Active, entre le code centre <strong style="color:var(--green);">{{ codeCentre }}</strong> et crée ton compte.
          </p>
        </div>
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--white);margin-bottom:4px;">
            <i class="ti ti-circle-check" style="color:var(--green);margin-right:6px;"></i>
            Accéder à la salle
          </div>
          <p style="font-size:13px;color:var(--text-dim);line-height:1.6;margin:0;">
            Ouvre l'app → onglet Decipass → présente ton QR code devant le lecteur d'accès.
          </p>
        </div>
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--white);margin-bottom:4px;">
            <i class="ti ti-circle-check" style="color:var(--green);margin-right:6px;"></i>
            Réserver une séance
          </div>
          <p style="font-size:13px;color:var(--text-dim);line-height:1.6;margin:0;">
            Utilise le planning ci-dessus ou l'app pour réserver avec un coach.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.deciplus-tab {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 20px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  color: var(--text-soft);
  text-decoration: none;
  border-right: 1px solid var(--border);
  white-space: nowrap;
  transition: color .2s, background .2s;
}
.deciplus-tab:hover {
  color: var(--white);
  background: rgba(61,255,20,.05);
}
.deciplus-tab.active-tab {
  color: var(--green);
  border-bottom: 2px solid var(--green);
  background: rgba(61,255,20,.04);
}
@media (max-width: 640px) {
  .deciplus-tab { padding: 12px 14px; font-size: 13px; }
}
</style>

{% endblock %}
