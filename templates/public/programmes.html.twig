{% extends 'base.html.twig' %}

{% block title %}Programmes — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Découvrez les programmes thématiques SPORT+ Marseille : cours femmes, ateliers enfants, séances after-work et bien plus. Une semaine, plusieurs rituels.">{% endblock %}
{% block og_title %}Nos Programmes — SPORT+ Marseille{% endblock %}
{% block og_description %}Cours femmes, kids energy, after work, senior wellness — découvrez les rituels hebdomadaires SPORT+.{% endblock %}

{% block body %}

{# Encart d'avertissement placeholders — textes seulement, photos OK #}
<div class="container" style="padding-top:30px;">
  <div style="background:rgba(255,138,77,0.08);border-left:3px solid #ff8a4d;
              padding:14px 18px;border-radius:var(--radius);
              font-size:14px;color:var(--text-soft);">
    <i class="ti ti-alert-triangle" style="color:#ff8a4d;margin-right:8px;"></i>
    <strong>À finaliser :</strong> les <strong>noms, horaires et descriptions</strong> entre
    crochets <code>[...]</code> sont des exemples — à confirmer avec les coachs. Les photos
    sont en place.
  </div>
</div>

{# ── Hero ── #}
<section class="pub-hero-split">
  <div class="container">
    <div class="pub-hero-split-grid">
      <div class="pub-hero-split-text">
        <div class="hero-badge">Nos rituels de la semaine</div>
        <h1 class="section-title">Nos <span style="color:var(--gold)">programmes</span></h1>
        <p class="section-sub">
          Chaque jour de la semaine a son rituel. Femmes, enfants, after-work, seniors —
          un programme pensé pour chaque envie, chaque énergie.
        </p>
      </div>
      <div class="pub-hero-split-photo">
        <img src="{{ asset('img/club-photos/cours-collectif-2.jpg') }}" alt="SPORT+ — Cours collectifs" loading="lazy">
      </div>
    </div>
  </div>
</section>

{# ── Cards Programmes ── #}
<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="programmes-grid" data-stagger data-animate="fade-up">

      {# ─── Programme 1 : Power Women #}
      <article class="programme-card">
        <div class="programme-photo">
          <img src="{{ asset('img/club-photos/cours-collectif-1.jpg') }}" alt="Programme Power Women SPORT+" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          <div class="programme-badge programme-badge-women">
            <i class="ti ti-spark"></i> Femmes uniquement
          </div>
        </div>
        <div class="programme-body">
          <div class="programme-day"><i class="ti ti-calendar-event"></i> [MARDI · 19h–20h30]</div>
          <h3 class="programme-title">[POWER WOMEN]</h3>
          <p class="programme-text">
            [Une heure trente entre nous. Cardio, renforcement musculaire et énergie collective —
            un rituel hebdomadaire pour reprendre le pouvoir sur son corps, dans un cadre
            bienveillant et 100% féminin.]
          </p>
          <div class="programme-meta">
            <span class="programme-meta-item"><i class="ti ti-users"></i> [6–10 pers.]</span>
            <span class="programme-meta-item"><i class="ti ti-coin"></i> [22€/séance]</span>
          </div>
          <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-full">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        </div>
      </article>

      {# ─── Programme 2 : Kids Energy #}
      <article class="programme-card">
        <div class="programme-photo">
          <img src="{{ asset('img/club-photos/duo-rire.jpg') }}" alt="Programme Kids Energy SPORT+" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          <div class="programme-badge programme-badge-kids">
            <i class="ti ti-mood-kid"></i> 7–12 ans
          </div>
        </div>
        <div class="programme-body">
          <div class="programme-day"><i class="ti ti-calendar-event"></i> [MERCREDI · 14h–15h] · [SAMEDI · 10h–11h]</div>
          <h3 class="programme-title">[KIDS ENERGY]</h3>
          <p class="programme-text">
            [Ateliers ludiques de motricité, jeux sportifs et défis collectifs pour canaliser
            l'énergie des enfants tout en développant leur confiance corporelle. Encadré par
            un coach spécialisé enfants.]
          </p>
          <div class="programme-meta">
            <span class="programme-meta-item"><i class="ti ti-users"></i> [8 enfants max]</span>
            <span class="programme-meta-item"><i class="ti ti-coin"></i> [15€/séance]</span>
          </div>
          <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-full">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        </div>
      </article>

      {# ─── Programme 3 : After Work #}
      <article class="programme-card">
        <div class="programme-photo">
          <img src="{{ asset('img/club-photos/coaching-halteres.jpg') }}" alt="Programme After Work SPORT+" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          <div class="programme-badge programme-badge-afterwork">
            <i class="ti ti-briefcase"></i> Salariés & cadres
          </div>
        </div>
        <div class="programme-body">
          <div class="programme-day"><i class="ti ti-calendar-event"></i> [LUNDI & JEUDI · 19h30–20h45]</div>
          <h3 class="programme-title">[AFTER WORK]</h3>
          <p class="programme-text">
            [Programme anti-stress conçu pour les actifs : circuit-training express,
            mobilité, et 10 minutes de récupération guidée. Sortez du bureau, déconnectez,
            transpirez, rentrez plus fort.]
          </p>
          <div class="programme-meta">
            <span class="programme-meta-item"><i class="ti ti-users"></i> [10 pers. max]</span>
            <span class="programme-meta-item"><i class="ti ti-coin"></i> [28€/séance]</span>
          </div>
          <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-full">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        </div>
      </article>

      {# ─── Programme 4 : Senior Wellness #}
      <article class="programme-card">
        <div class="programme-photo">
          <img src="{{ asset('img/club-photos/cours-collectif-2.jpg') }}" alt="Programme Senior Wellness SPORT+" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          <div class="programme-badge programme-badge-senior">
            <i class="ti ti-heart-handshake"></i> 60+ ans
          </div>
        </div>
        <div class="programme-body">
          <div class="programme-day"><i class="ti ti-calendar-event"></i> [VENDREDI · 10h–11h]</div>
          <h3 class="programme-title">[SENIOR WELLNESS]</h3>
          <p class="programme-text">
            [Mobilité douce, équilibre, renforcement progressif. Un programme adapté pour
            préserver l'autonomie, soulager les douleurs et garder le plaisir de bouger,
            quel que soit son âge.]
          </p>
          <div class="programme-meta">
            <span class="programme-meta-item"><i class="ti ti-users"></i> [6 pers. max]</span>
            <span class="programme-meta-item"><i class="ti ti-coin"></i> [20€/séance]</span>
          </div>
          <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-full">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        </div>
      </article>

      {# ─── Programme 5 : Boxe & Combat #}
      <article class="programme-card">
        <div class="programme-photo">
          <img src="{{ asset('img/club-photos/muscu-homme.jpg') }}" alt="Programme Boxe &amp; Combat SPORT+" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
          <div class="programme-badge programme-badge-combat">
            <i class="ti ti-flame"></i> Tous niveaux
          </div>
        </div>
        <div class="programme-body">
          <div class="programme-day"><i class="ti ti-calendar-event"></i> [MARDI & VENDREDI · 18h–19h30]</div>
          <h3 class="programme-title">[BOXE &amp; COMBAT]</h3>
          <p class="programme-text">
            [Technique, cardio explosif, défoulement contrôlé. Initiation aux fondamentaux
            de la boxe anglaise et du kick-boxing, dans un cadre sécurisé. Aucun prérequis
            — juste l'envie d'envoyer.]
          </p>
          <div class="programme-meta">
            <span class="programme-meta-item"><i class="ti ti-users"></i> [8 pers. max]</span>
            <span class="programme-meta-item"><i class="ti ti-coin"></i> [25€/séance]</span>
          </div>
          <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-full">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        </div>
      </article>

    </div>
  </div>
</section>

{# ── Mini-calendrier hebdo compact ── #}
<section class="section" style="background:var(--bg-2);padding-top:60px;padding-bottom:60px;">
  <div class="container" style="max-width:880px;">
    <div class="section-label" style="text-align:center;display:block;margin-bottom:8px;">Vue d'ensemble</div>
    <h2 class="section-title" style="font-size:clamp(28px,4vw,42px);margin-bottom:32px;">
      Une <span style="color:var(--gold)">semaine</span> à SPORT+
    </h2>

    <div class="week-grid" data-stagger data-animate="scale-in">

      <div class="week-day">
        <div class="week-day-name">Lun</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-afterwork">After Work</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Mar</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-women">Power Women</span>
          <span class="week-prog week-prog-combat">Boxe</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Mer</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-kids">Kids Energy</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Jeu</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-afterwork">After Work</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Ven</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-senior">Senior</span>
          <span class="week-prog week-prog-combat">Boxe</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Sam</div>
        <div class="week-day-programs">
          <span class="week-prog week-prog-kids">Kids Energy</span>
        </div>
      </div>

      <div class="week-day">
        <div class="week-day-name">Dim</div>
        <div class="week-day-programs">
          <span class="week-prog-empty">Open Gym</span>
        </div>
      </div>

    </div>

    <p style="text-align:center;font-family:'Cormorant Garamond',serif;font-style:italic;
              font-size:18px;color:var(--text-soft);margin-top:32px;">
      Et bien sûr, l'accès libre à la salle 24h/24, 7j/7.
    </p>
  </div>
</section>

{# ── CTA final ── #}
<section class="section" style="padding-top:60px;padding-bottom:80px;text-align:center;">
  <div class="container">
    <h2 class="section-title" style="margin-bottom:16px;">Un programme te parle ?</h2>
    <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:20px;
              color:var(--text-soft);margin-bottom:32px;">
      Rejoins le rituel qui te ressemble.
    </p>
    <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-lg">
      <i class="ti ti-calendar-plus"></i> Réserver ma place
    </a>
  </div>
</section>

{% endblock %}
