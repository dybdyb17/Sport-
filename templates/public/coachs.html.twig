{% extends 'base.html.twig' %}

{% block title %}Nos Coachs — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Rencontrez les coachs SPORT+ Marseille : experts certifiés, disponibles de jour comme de nuit pour un coaching personnalisé en salle privative.">{% endblock %}

{% block body %}

<section class="pub-hero pub-hero-bg" style="padding:80px 0 60px;text-align:center;background-image:url('{{ asset('img/club-photos/coaching-halteres.jpg') }}');">
  <div class="container">
    <div class="hero-badge">L'équipe</div>
    <h1 class="section-title" style="margin-top:16px;">Nos <span style="color:var(--gold)">Coachs</span></h1>
    <p class="section-sub">Des professionnels certifiés, disponibles 24h/24 pour t'accompagner vers tes objectifs.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container">
    {% if coaches is empty %}
      <div class="empty-placeholder">
        <i class="ti ti-users" style="font-size:48px;display:block;margin-bottom:16px;opacity:.3;"></i>
        Aucun coach disponible pour le moment.
      </div>
    {% else %}
      <div class="coach-pro-grid" data-stagger data-animate="fade-up">
        {% for coach in coaches %}
          <div class="coach-pro-card">

            {# Photo ou avatar initiales #}
            <div class="coach-pro-photo-wrap">
              {% if coach.photoFilename %}
                <img src="{{ asset('img/coaches/' ~ coach.photoFilename) }}"
                     alt="{{ coach.nomComplet }}"
                     class="coach-pro-photo">
              {% else %}
                <div class="coach-pro-initials">
                  {%- set words = coach.nomComplet|split(' ') -%}
                  {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
                </div>
              {% endif %}
            </div>

            {# Infos #}
            <div class="coach-pro-body">
              <div class="coach-pro-name">{{ coach.nomComplet }}</div>

              {% if coach.bio %}
                <p class="coach-pro-bio">{{ coach.bio }}</p>
              {% endif %}

              {% if coach.specialties is not empty %}
                <div class="coach-pro-chips">
                  {% for specialty in coach.specialties %}
                    <span class="coach-pro-chip">{{ specialty|capitalize }}</span>
                  {% endfor %}
                </div>
              {% endif %}

              <a href="{{ app.user ? path('app_booking_new') : path('app_login') }}"
                 class="btn btn-primary coach-pro-cta">
                <i class="ti ti-calendar-plus"></i> Réserver une séance
              </a>

              {% if not app.user %}
                <p style="font-size:12px;color:var(--text-dim);text-align:center;margin-top:8px;">
                  Connexion requise pour réserver
                </p>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% endblock %}
