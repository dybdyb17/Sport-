{% extends 'base.html.twig' %}

{% block title %}Tarifs — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Grille tarifaire officielle SPORT+ Marseille : séances uniques et packs mensuels Solo, Duo et Groupe. Journée, Night Coach, Astreinte.">{% endblock %}

{% block body %}
{% set bookingPath = app.user ? path('app_booking_new') : path('app_register') %}

{# ── Hero : priorité au coaching #}
<section class="pub-hero-split pricing-hero">
  <div class="pricing-hero-orb pricing-hero-orb-gold" aria-hidden="true"></div>
  <div class="pricing-hero-orb pricing-hero-orb-green" aria-hidden="true"></div>
  <div class="container">
    <div class="pub-hero-split-grid pricing-hero-grid">
      <div class="pub-hero-split-text pricing-hero-copy" data-animate="fade-up">
        <div class="hero-badge">Coaching de jour comme de nuit</div>
        <h1 class="section-title">Ton coaching, <span class="pricing-accent">à ton rythme</span></h1>
        <p class="section-sub">Découvre en priorité le Night Coach SPORT+, puis nos séances, packs et abonnements pour accéder à la salle 24h/24.</p>
        <div class="pricing-hero-actions">
          <a href="#coaching" class="btn btn-primary btn-lg"><i class="ti ti-moon-stars"></i> Voir le coaching</a>
          <a href="#abonnements" class="btn btn-secondary btn-lg"><i class="ti ti-id-badge-2"></i> Voir les abonnements</a>
        </div>
      </div>
      <div class="pub-hero-split-photo pricing-hero-photo" data-animate="fade-left">
        <img src="{{ asset('img/club-photos/sport-nuit.jpeg') }}" alt="Night Coach SPORT+ Marseille" fetchpriority="high">
        <div class="pricing-hero-panel pricing-hero-panel-night" aria-label="Night Coach SPORT+">
          <span>La signature SPORT+</span>
          <strong>Night Coach</strong>
          <small>20h → minuit · dès 60€</small>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Offre Membre Fondateur #}
{% set fo = foundingOffer ?? current_founding_offer() %}
{% if fo and fo.isStillRunning %}
<section class="pricing-founding-section" aria-labelledby="pricing-founding-title">
  <div class="container">
    <div class="pricing-founding-card" data-animate="fade-up">
      <div class="pricing-founding-photo">
        <img src="{{ asset('img/club-photos/heureux-fondateur.jpg') }}"
             onerror="this.onerror=null;this.src='{{ asset('img/club-photos/portrait-souriante.jpg') }}';"
             alt="Membre fondateur SPORT+ heureux après son entraînement">
        <span class="pricing-founding-photo-badge"><i class="ti ti-heart"></i> Offre lancement</span>
      </div>
      <div class="pricing-founding-content">
        {% if app.user and app.user.foundingClaim %}
          <div class="pricing-founding-eyebrow">{{ app.user.foundingClaim.foundingLabel }}</div>
          <h2 id="pricing-founding-title">Tu fais partie de l'aventure SPORT+</h2>
          <p>{{ app.user.foundingClaim.sessionsRemaining }}/{{ fo.sessionsIncluded }} séances incluses restantes · bilan {{ app.user.foundingClaim.isBilanDone ? 'effectué' : 'à programmer' }}.</p>
          <a href="{{ path('app_espace_client') }}" class="btn btn-primary"><i class="ti ti-user"></i> Voir mon espace</a>
        {% elseif fo.hasPlacesLeft %}
          <div class="pricing-founding-eyebrow">Deviens Membre Fondateur</div>
          <h2 id="pricing-founding-title">Commence avec une offre qui te ressemble</h2>
          <p class="pricing-founding-lead">Rejoins les premiers membres SPORT+ et profite d'un accompagnement privilégié dès ton arrivée.</p>
          <div class="pricing-founding-price"><strong>{{ fo.sessionsIncluded }} séances · {{ fo.price }}€</strong><span>Valeur habituelle {{ fo.regularPrice }}€</span></div>
          <ul class="pricing-founding-benefits">
            <li><i class="ti ti-circle-check"></i> {{ fo.sessionsIncluded }} séances de coaching incluses</li>
            {% if fo.includesFreeBilan %}<li><i class="ti ti-circle-check"></i> Bilan forme offert</li>{% endif %}
            {% if fo.includesPriorityNight %}<li><i class="ti ti-circle-check"></i> Priorité sur les créneaux Night Coach</li>{% endif %}
          </ul>
          <div class="pricing-founding-progress" aria-label="{{ fo.placesTaken }} places prises sur {{ fo.totalPlaces }}">
            <div><span>Déjà {{ fo.placesTaken }} membres</span><strong>{{ fo.placesRemaining }} places restantes</strong></div>
            <div class="pricing-founding-progress-track"><span style="width:{{ fo.progressPercent }}%;"></span></div>
          </div>
          <a href="{{ path('app_founding_detail') }}" class="btn btn-primary btn-lg"><i class="ti ti-sparkles"></i> Découvrir l'offre</a>
        {% else %}
          <div class="pricing-founding-eyebrow">Merci aux fondateurs</div>
          <h2 id="pricing-founding-title">L'offre lancement est complète</h2>
          <p>Les {{ fo.totalPlaces }} places ont été attribuées. Découvre maintenant nos formules de coaching.</p>
          <a href="#coaching" class="btn btn-secondary"><i class="ti ti-arrow-down"></i> Voir le coaching</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# ── Formules Coaching — priorité Night Coach #}
<section id="coaching" class="section pricing-section pricing-coaching-section">
  <div class="container">
    <div class="pricing-section-heading" data-animate="fade-up">
      <div class="section-label pricing-section-label">Coaching SPORT+</div>
      <h2 class="section-title pricing-section-title">Le coaching <span class="pricing-accent">quand les autres ferment</span></h2>
      <p class="pricing-section-intro">Night Coach est la signature SPORT+ : entraîne-toi avec ton coach le soir ou en pleine nuit, sans renoncer aux créneaux de journée.</p>
    </div>

    <div id="day-pass" class="pricing-day-pass-grid" data-stagger data-animate="fade-up">
      <article class="pricing-day-card">
        <div class="pricing-day-icon pricing-day-icon-gold"><i class="ti ti-sun"></i></div>
        <div class="pricing-day-label">Journée</div>
        <div class="pricing-day-price">40<span>€</span></div>
        <div class="pricing-day-time">6h – 20h</div>
      </article>

      <article class="pricing-day-card pricing-day-card-featured">
        <div class="pricing-day-ribbon">Le plus populaire</div>
        <div class="pricing-day-icon pricing-day-icon-live"><i class="ti ti-moon"></i></div>
        <div class="pricing-day-label">Night Coach</div>
        <div class="pricing-day-price">60<span>€</span></div>
        <div class="pricing-day-time">20h – minuit</div>
      </article>

      <article class="pricing-day-card">
        <div class="pricing-day-icon pricing-day-icon-gold"><i class="ti ti-moon-stars"></i></div>
        <div class="pricing-day-label">Astreinte</div>
        <div class="pricing-day-price">80<span>€</span></div>
        <div class="pricing-day-time">minuit – 6h</div>
      </article>
    </div>

    {# ── Section 2 : Packs mensuels #}
    <div id="packs" class="pricing-section-heading pricing-pack-heading" data-animate="fade-up">
      <div class="section-label pricing-section-label">Packs mensuels</div>
      <h2 class="section-title pricing-section-title">Tarifs <span class="pricing-accent">par personne / mois</span></h2>
    </div>

    <div class="pricing-pack-list">
      <section class="pricing-pack-block" data-animate="fade-up">
        <header class="pricing-pack-header">
          <i class="ti ti-user"></i>
          <div>
            <h3>Solo</h3>
            <p>1 personne · accompagnement individuel</p>
          </div>
        </header>
        <div class="pricing-table-scroll">
          <table class="tarif-table">
            <thead>
              <tr>
                <th></th>
                <th><i class="ti ti-sun"></i> Journée</th>
                <th><i class="ti ti-moon"></i> Night Coach</th>
                <th><i class="ti ti-moon-stars"></i> Astreinte</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="tarif-label">Pack 4 séances / mois</td>
                <td class="tarif-price">150 €</td>
                <td class="tarif-price">210 €</td>
                <td class="tarif-price">270 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 8 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
                <td class="tarif-price">240 €</td>
                <td class="tarif-price">335 €</td>
                <td class="tarif-price">430 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 12 séances / mois</td>
                <td class="tarif-price">320 €</td>
                <td class="tarif-price">450 €</td>
                <td class="tarif-price">575 €</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="pricing-pack-block" data-animate="fade-up">
        <header class="pricing-pack-header">
          <i class="ti ti-users"></i>
          <div>
            <h3>Duo</h3>
            <p>2 personnes · tarif par personne</p>
          </div>
        </header>
        <div class="pricing-table-scroll">
          <table class="tarif-table">
            <thead>
              <tr>
                <th></th>
                <th><i class="ti ti-sun"></i> Journée</th>
                <th><i class="ti ti-moon"></i> Night Coach</th>
                <th><i class="ti ti-moon-stars"></i> Astreinte</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="tarif-label">Pack 4 séances / mois par personne</td>
                <td class="tarif-price">105 €</td>
                <td class="tarif-price">147 €</td>
                <td class="tarif-price">189 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 8 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
                <td class="tarif-price">168 €</td>
                <td class="tarif-price">235 €</td>
                <td class="tarif-price">302 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 12 séances / mois</td>
                <td class="tarif-price">224 €</td>
                <td class="tarif-price">314 €</td>
                <td class="tarif-price">403 €</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="pricing-pack-block" data-animate="fade-up">
        <header class="pricing-pack-header">
          <i class="ti ti-users-group"></i>
          <div>
            <h3>Groupe</h3>
            <p>4 à 6 personnes · tarif par personne</p>
          </div>
        </header>
        <div class="pricing-table-scroll">
          <table class="tarif-table">
            <thead>
              <tr>
                <th></th>
                <th><i class="ti ti-sun"></i> Journée</th>
                <th><i class="ti ti-moon"></i> Night Coach</th>
                <th><i class="ti ti-moon-stars"></i> Astreinte</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="tarif-label">Pack 4 séances / mois</td>
                <td class="tarif-price">60 €</td>
                <td class="tarif-price">84 €</td>
                <td class="tarif-price">108 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 8 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
                <td class="tarif-price">96 €</td>
                <td class="tarif-price">134 €</td>
                <td class="tarif-price">173 €</td>
              </tr>
              <tr>
                <td class="tarif-label">Pack 12 séances / mois</td>
                <td class="tarif-price">128 €</td>
                <td class="tarif-price">179 €</td>
                <td class="tarif-price">230 €</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    {# ── Section 3 : FullAccess #}
    <section id="fullaccess" class="pricing-fullaccess" data-animate="fade-up">
      <div class="pricing-fullaccess-copy">
        <div class="pricing-fullaccess-title"><i class="ti ti-24-hours"></i> Option FullAccess</div>
        <p>Accès salle 24h/24 pour t'entraîner en autonomie entre tes séances coachées : cardio, musculation ou stretching.</p>
      </div>
      <div class="pricing-fullaccess-grid">
        <div class="pricing-fullaccess-price">
          <span>Solo</span>
          <strong>+30 €</strong>
          <small>/ mois</small>
        </div>
        <div class="pricing-fullaccess-price">
          <span>Duo</span>
          <strong>+30 €</strong>
          <small>/ mois / personne</small>
        </div>
        <div class="pricing-fullaccess-price">
          <span>Groupe</span>
          <strong>+25 €</strong>
          <small>/ mois / personne</small>
        </div>
      </div>
      <div class="pricing-fullaccess-note">
        <i class="ti ti-info-circle"></i>
        <span><strong>Exemple Groupe :</strong> 5 personnes × 25 € = <strong>125 € / mois</strong>. Chaque membre paye sa part.</span>
      </div>
    </section>

    {# ── CTA #}
    <div class="pricing-final-cta" data-animate="fade-up">
      <span class="pricing-final-kicker">Ton prochain objectif commence ici</span>
      <h2>Prêt à passer à l'action ?</h2>
      <p>Réserve ta première séance et choisis le coach, l'horaire et le format qui te correspondent.</p>
      <a href="{{ bookingPath }}" class="btn btn-primary btn-lg">
        <i class="ti ti-calendar-plus"></i>
        Réserver une séance
      </a>
    </div>

    {# Slogan bas de page #}
    <div class="pricing-signature">
      <p>Avance, progresse, dépasse — <strong>SPORT<span>+</span></strong></p>
    </div>

  </div>
</section>

{# ── Formules Abonnement — second parcours #}
<section id="abonnements" class="section pricing-section pricing-section-abonnements">
  <div class="container">
    <div class="section-label pricing-section-label">Accès salle 24h/24</div>
    <h2 class="section-title pricing-section-title">
      Formules <span class="pricing-accent">abonnement</span>
    </h2>
    <p class="pricing-section-intro">
      Inscription &amp; paiement <strong style="color:var(--green);">Paylib</strong> directement sur
      <strong style="color:var(--white);">Deciplus</strong> — le système officiel de gestion du club.
      Pas de double compte, pas de double saisie.
    </p>

    <div class="formules-grid" data-stagger data-animate="fade-up">

      {# Student #}
      <article class="formule-card"
               data-img="{{ asset('img/formules/student.jpg') }}"
               data-name="Student"
               data-price="25"
               data-period="/ 4 semaines"
               data-tag="Étudiant"
               data-fees="50€ frais d'inscription"
               data-features='["Sans engagement","Accès 24/24","1 semaine d''accès à offrir","Bilan forme offert","Cours collectif avec coach"]'>
        <div class="formule-tag">Étudiant</div>
        <div class="formule-name">Student</div>
        <div class="formule-price">25 <span>€</span></div>
        <div class="formule-period">/ 4 semaines</div>
        <ul class="formule-features">
          <li><i class="ti ti-check"></i> Sans engagement</li>
          <li><i class="ti ti-check"></i> Accès 24/24</li>
          <li><i class="ti ti-check"></i> 1 semaine d'accès à offrir</li>
          <li><i class="ti ti-check"></i> Bilan forme offert</li>
          <li><i class="ti ti-check"></i> Cours collectif avec coach</li>
        </ul>
        <div class="formule-fees">+ 50€ frais d'inscription</div>
        <button type="button" class="btn btn-outline formule-btn">
          <i class="ti ti-photo"></i> Voir la formule
        </button>
      </article>

      {# Premium+ #}
      <article class="formule-card"
               data-img="{{ asset('img/formules/premium-plus.jpg') }}"
               data-name="Premium +"
               data-price="45"
               data-period="/ 4 semaines"
               data-tag="Solo"
               data-fees="50€ frais d'inscription"
               data-features='["Sans engagement","Accès 24/24","1 semaine d''accès à offrir","Bilan forme offert","Cours collectif avec coach"]'>
        <div class="formule-tag">Solo</div>
        <div class="formule-badge-top">Le plus populaire</div>
        <div class="formule-name">Premium <span style="color:var(--green);">+</span></div>
        <div class="formule-price">45 <span>€</span></div>
        <div class="formule-period">/ 4 semaines</div>
        <ul class="formule-features">
          <li><i class="ti ti-check"></i> Sans engagement</li>
          <li><i class="ti ti-check"></i> Accès 24/24</li>
          <li><i class="ti ti-check"></i> 1 semaine d'accès à offrir</li>
          <li><i class="ti ti-check"></i> Bilan forme offert</li>
          <li><i class="ti ti-check"></i> Cours collectif avec coach</li>
        </ul>
        <div class="formule-fees">+ 50€ frais d'inscription</div>
        <button type="button" class="btn btn-outline formule-btn">
          <i class="ti ti-photo"></i> Voir la formule
        </button>
      </article>

      {# Duo+ — mis en avant #}
      <article class="formule-card formule-card-featured"
               data-img="{{ asset('img/formules/duo-plus.jpg') }}"
               data-name="Duo +"
               data-price="55"
               data-period="/ 4 semaines"
               data-tag="Duo"
               data-fees="50€ frais d'inscription"
               data-features='["Sans engagement","Accès 24/24","1 semaine d''accès à offrir","Entraînement avec un invité","Bilan forme offert","Cours collectif avec coach"]'>
        <div class="formule-tag">Duo</div>
        <div class="formule-name">Duo <span style="color:var(--green);">+</span></div>
        <div class="formule-price">55 <span>€</span></div>
        <div class="formule-period">/ 4 semaines</div>
        <ul class="formule-features">
          <li><i class="ti ti-check"></i> Sans engagement</li>
          <li><i class="ti ti-check"></i> Accès 24/24</li>
          <li><i class="ti ti-check"></i> 1 semaine d'accès à offrir</li>
          <li><i class="ti ti-check"></i> Entraînement avec un invité</li>
          <li><i class="ti ti-check"></i> Bilan forme offert</li>
          <li><i class="ti ti-check"></i> Cours collectif avec coach</li>
        </ul>
        <div class="formule-fees">+ 50€ frais d'inscription</div>
        <button type="button" class="btn btn-primary formule-btn">
          <i class="ti ti-photo"></i> Voir la formule
        </button>
      </article>

      {# Ultra #}
      <article class="formule-card"
               data-img="{{ asset('img/formules/ultra.jpg') }}"
               data-name="Ultra"
               data-price="90"
               data-period="/ 4 semaines · groupe"
               data-tag="Groupe"
               data-fees="Voir conditions au club"
               data-features='["Divise le prix entre amis","Jusqu''à 5 membres sur l''abonnement","Sans engagement","Accès 24/24","Ex : 18€/pers pour 5 personnes"]'>
        <div class="formule-tag">Groupe</div>
        <div class="formule-name">Ultra</div>
        <div class="formule-price">90 <span>€</span></div>
        <div class="formule-period">/ 4 semaines · groupe</div>
        <ul class="formule-features">
          <li><i class="ti ti-check"></i> Divise le prix entre amis</li>
          <li><i class="ti ti-check"></i> Jusqu'à 5 membres sur l'abonnement</li>
          <li><i class="ti ti-check"></i> Sans engagement</li>
          <li><i class="ti ti-check"></i> Accès 24/24</li>
          <li style="font-style:italic;color:var(--green);">Ex : 18€/pers pour 5 personnes</li>
        </ul>
        <div class="formule-fees">Voir conditions au club</div>
        <button type="button" class="btn btn-outline formule-btn">
          <i class="ti ti-photo"></i> Voir la formule
        </button>
      </article>

    </div>

    <p class="pricing-formule-note">Toutes les formules incluent l'accès libre 24h/24 à la salle.</p>

    {# Encart explicatif : 2 systèmes complémentaires #}
    <div class="dual-system-info">
      <div class="dual-system-card">
        <div class="dual-system-icon" style="background:rgba(46,204,113,.1);color:var(--green);">
          <i class="ti ti-credit-card"></i>
        </div>
        <div>
          <div class="dual-system-title">Abonnements mensuels</div>
          <div class="dual-system-text">
            Student, Premium+, Duo+, Ultra — inscription &amp; paiement
            <strong style="color:var(--green);">Paylib</strong> sur Deciplus.
            Tu retrouves ton compte sur l'app <strong>Xplor Active</strong> + QR code Decipass pour entrer dans la salle.
          </div>
        </div>
      </div>
      <div class="dual-system-card">
        <div class="dual-system-icon" style="background:rgba(200,169,81,.1);color:var(--gold);">
          <i class="ti ti-user-star"></i>
        </div>
        <div>
          <div class="dual-system-title">Coaching à la séance</div>
          <div class="dual-system-text">
            Day Pass, Pack 4/8/12 — réservation directe sur SPORT+ avec
            <strong style="color:var(--gold);">choix du coach</strong>,
            <strong style="color:var(--gold);">messagerie privée</strong> et
            paiement uniquement si le coach confirme.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Modal split : visuel + panneau infos animé ── #}
<div id="formule-modal" class="formule-modal" aria-hidden="true" role="dialog">
  <div class="formule-modal-backdrop" onclick="closeFormuleModal()"></div>

  <div class="formule-modal-content">
    <button type="button" class="formule-modal-close" onclick="closeFormuleModal()" aria-label="Fermer">
      <i class="ti ti-x"></i>
    </button>

    <div class="formule-modal-split">

      {# Visuel à gauche #}
      <div class="formule-modal-visual">
        <div class="formule-modal-glow"></div>
        <img id="formule-modal-img" src="" alt="" loading="lazy">
      </div>

      {# Panneau infos animé à droite #}
      <div class="formule-modal-info">
        <div class="formule-modal-tag" id="formule-modal-tag"></div>
        <h2 class="formule-modal-name" id="formule-modal-name"></h2>

        <div class="formule-modal-price-block">
          <div class="formule-modal-price">
            <span id="formule-modal-price-num">0</span><span class="euro">€</span>
          </div>
          <div class="formule-modal-period" id="formule-modal-period"></div>
        </div>

        <ul class="formule-modal-features" id="formule-modal-features"></ul>

        <div class="formule-modal-fees" id="formule-modal-fees"></div>

        <a href="https://member-app.deciplus.pro/{{ deciplusSlug }}/tunnel"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-primary btn-lg formule-modal-cta">
          <i class="ti ti-credit-card"></i> Je m'abonne via Deciplus
        </a>

        <div class="formule-modal-hint">
          <i class="ti ti-shield-check"></i>
          Inscription &amp; paiement sécurisés <strong>Paylib</strong> sur Deciplus, le système officiel SPORT+.
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  var modal       = document.getElementById('formule-modal');
  var modalImg    = document.getElementById('formule-modal-img');
  var modalTag    = document.getElementById('formule-modal-tag');
  var modalName   = document.getElementById('formule-modal-name');
  var modalPrice  = document.getElementById('formule-modal-price-num');
  var modalPeriod = document.getElementById('formule-modal-period');
  var modalFees   = document.getElementById('formule-modal-fees');
  var modalFeat   = document.getElementById('formule-modal-features');

  function animateNumber(el, target, duration) {
    var start    = 0;
    var startTs  = null;
    function step(ts) {
      if (!startTs) startTs = ts;
      var progress = Math.min((ts - startTs) / duration, 1);
      // ease-out cubic
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(start + (target - start) * eased);
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  document.querySelectorAll('.formule-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var card = btn.closest('.formule-card');
      if (!card) return;

      var img      = card.getAttribute('data-img');
      var name     = card.getAttribute('data-name');
      var price    = parseInt(card.getAttribute('data-price'), 10) || 0;
      var period   = card.getAttribute('data-period') || '';
      var tag      = card.getAttribute('data-tag') || '';
      var fees     = card.getAttribute('data-fees') || '';
      var features = [];
      try { features = JSON.parse(card.getAttribute('data-features') || '[]'); } catch (e) {}

      modalImg.src    = img;
      modalImg.alt    = 'Formule ' + name + ' — SPORT+ Marseille';
      modalTag.textContent    = tag;
      modalName.innerHTML     = name.replace('+', '<span style="color:var(--green);">+</span>');
      modalPeriod.textContent = period;
      modalFees.textContent   = fees;

      modalFeat.innerHTML = '';
      features.forEach(function(f, i) {
        var li = document.createElement('li');
        li.style.animationDelay = (0.15 + i * 0.06) + 's';
        li.innerHTML = '<i class="ti ti-circle-check"></i><span>' + f + '</span>';
        modalFeat.appendChild(li);
      });

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Anime le prix avec délai pour que ça apparaisse après l'entrée
      modalPrice.textContent = '0';
      setTimeout(function() { animateNumber(modalPrice, price, 600); }, 300);
    });
  });

  window.closeFormuleModal = function() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(function() { modalImg.src = ''; }, 300);
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) {
      window.closeFormuleModal();
    }
  });
})();
</script>


{% endblock %}
