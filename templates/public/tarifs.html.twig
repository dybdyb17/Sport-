{% extends 'base.html.twig' %}

{% block title %}Tarifs — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Grille tarifaire officielle SPORT+ Marseille : séances uniques et packs mensuels Solo, Duo et Groupe. Journée, Night Coach, Astreinte.">{% endblock %}

{% block body %}

{# ── Hero #}
<section class="pub-hero" style="padding:80px 0 56px;text-align:center;">
  <div class="container">
    <div class="hero-badge">Tarification officielle</div>
    <h1 class="section-title" style="margin-top:16px;">Nos <span style="color:var(--gold)">Tarifs</span></h1>
    <p class="section-sub">Des formules transparentes, adaptées à ton rythme. Day Pass à l'unité ou packs mensuels.</p>
  </div>
</section>

{# ── Section 1 : Séances uniques #}
<section class="section" style="padding-top:0;">
  <div class="container">
    <div class="section-label" style="text-align:center;display:block;margin-bottom:32px;">Day Pass — séance à l'unité</div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:48px;">

      {# Day Pass Journée #}
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 24px;text-align:center;">
        <div style="width:44px;height:44px;background:rgba(200,169,81,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <i class="ti ti-sun" style="font-size:22px;color:var(--gold);"></i>
        </div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;">Journée</div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:900;color:var(--gold);line-height:1;">40<span style="font-size:28px;color:var(--text-dim);">€</span></div>
        <div style="font-size:13px;color:var(--text-dim);margin-top:10px;">6h – 20h</div>
      </div>

      {# Day Pass Night #}
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 24px;text-align:center;position:relative;">
        <div style="position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--gold);color:var(--black);font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;padding:4px 12px;border-radius:0 0 8px 8px;">Le plus populaire</div>
        <div style="width:44px;height:44px;background:rgba(200,169,81,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <i class="ti ti-moon" style="font-size:22px;color:var(--gold);"></i>
        </div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;">Night Coach</div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:900;color:var(--gold);line-height:1;">60<span style="font-size:28px;color:var(--text-dim);">€</span></div>
        <div style="font-size:13px;color:var(--text-dim);margin-top:10px;">20h – minuit</div>
      </div>

      {# Day Pass Astreinte #}
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 24px;text-align:center;">
        <div style="width:44px;height:44px;background:rgba(200,169,81,0.1);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <i class="ti ti-moon-stars" style="font-size:22px;color:var(--gold);"></i>
        </div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px;">Astreinte</div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:56px;font-weight:900;color:var(--gold);line-height:1;">80<span style="font-size:28px;color:var(--text-dim);">€</span></div>
        <div style="font-size:13px;color:var(--text-dim);margin-top:10px;">minuit – 6h</div>
      </div>

    </div>

    {# ── Section 2 : Packs mensuels #}
    <div class="section-label" style="text-align:center;display:block;margin-bottom:32px;">Packs mensuels — par personne / mois</div>

    {# Solo #}
    <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;color:var(--gold);">
      <i class="ti ti-user"></i> Solo (1 personne)
    </h3>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;margin-bottom:32px;">
      <table class="tarif-table">
        <thead>
          <tr>
            <th></th>
            <th><i class="ti ti-sun"></i> Journée</th>
            <th><i class="ti ti-moon"></i> Night Coach</th>
            <th><i class="ti ti-moon-stars"></i> Astreinte</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tarif-label">Pack 4 séances / mois</td>
            <td class="tarif-price">150 €</td>
            <td class="tarif-price">210 €</td>
            <td class="tarif-price">270 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 8 séances / mois</td>
            <td class="tarif-price">240 €</td>
            <td class="tarif-price">335 €</td>
            <td class="tarif-price">430 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 12 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
            <td class="tarif-price">320 €</td>
            <td class="tarif-price">450 €</td>
            <td class="tarif-price">575 €</td>
          </tr>
        </tbody>
      </table>
    </div>

    {# Duo #}
    <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;color:var(--gold);">
      <i class="ti ti-users"></i> Duo (2 personnes) — par personne
    </h3>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;margin-bottom:32px;">
      <table class="tarif-table">
        <thead>
          <tr>
            <th></th>
            <th><i class="ti ti-sun"></i> Journée</th>
            <th><i class="ti ti-moon"></i> Night Coach</th>
            <th><i class="ti ti-moon-stars"></i> Astreinte</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tarif-label">Pack 4 séances / mois</td>
            <td class="tarif-price">105 €</td>
            <td class="tarif-price">147 €</td>
            <td class="tarif-price">189 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 8 séances / mois</td>
            <td class="tarif-price">168 €</td>
            <td class="tarif-price">235 €</td>
            <td class="tarif-price">302 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 12 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
            <td class="tarif-price">224 €</td>
            <td class="tarif-price">314 €</td>
            <td class="tarif-price">403 €</td>
          </tr>
        </tbody>
      </table>
    </div>

    {# Group #}
    <h3 style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:20px;letter-spacing:2px;text-transform:uppercase;margin-bottom:16px;color:var(--gold);">
      <i class="ti ti-users-group"></i> Groupe (4-6 personnes) — par personne
    </h3>
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;margin-bottom:48px;">
      <table class="tarif-table">
        <thead>
          <tr>
            <th></th>
            <th><i class="ti ti-sun"></i> Journée</th>
            <th><i class="ti ti-moon"></i> Night Coach</th>
            <th><i class="ti ti-moon-stars"></i> Astreinte</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="tarif-label">Pack 4 séances / mois</td>
            <td class="tarif-price">60 €</td>
            <td class="tarif-price">84 €</td>
            <td class="tarif-price">108 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 8 séances / mois</td>
            <td class="tarif-price">96 €</td>
            <td class="tarif-price">134 €</td>
            <td class="tarif-price">173 €</td>
          </tr>
          <tr>
            <td class="tarif-label">Pack 12 séances / mois <span class="tarif-best">Meilleur rapport</span></td>
            <td class="tarif-price">128 €</td>
            <td class="tarif-price">179 €</td>
            <td class="tarif-price">230 €</td>
          </tr>
        </tbody>
      </table>
    </div>

    {# ── Section 3 : FullAccess #}
    <div class="fullaccess-block" style="background:var(--bg-card);border:1px solid var(--border);border-left:3px solid var(--green);border-radius:var(--radius-lg);padding:28px 32px;margin-bottom:48px;display:flex;gap:32px;flex-wrap:wrap;align-items:center;">
      <div>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:700;letter-spacing:1px;color:var(--green);">
          <i class="ti ti-24-hours"></i> Option FullAccess — Accès salle 24h/24
        </div>
        <p style="color:var(--text-dim);margin-top:8px;font-size:15px;max-width:600px;">
          Entraîne-toi en totale autonomie, même sans coach. Idéal pour les séances cardio, musculation ou stretching entre tes séances coachées.
        </p>
      </div>
      <div style="display:flex;gap:24px;flex-wrap:wrap;">
        <div style="text-align:center;">
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:36px;font-weight:700;color:var(--green);">+30 €</div>
          <div style="font-size:13px;color:var(--text-dim);">/ mois · Solo &amp; Duo</div>
        </div>
        <div style="text-align:center;">
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:36px;font-weight:700;color:var(--green);">+25 €</div>
          <div style="font-size:13px;color:var(--text-dim);">/ mois · Groupe</div>
        </div>
      </div>
    </div>

    {# ── CTA #}
    <div style="text-align:center;padding:48px 0 24px;">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:20px;color:var(--text-dim);margin-bottom:24px;">
        Prêt à commencer ? Réservez votre première séance.
      </p>
      <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-lg">
        <i class="ti ti-calendar-plus"></i>
        Réserver une séance
      </a>
    </div>

    {# Slogan bas de page #}
    <div style="text-align:center;margin-top:40px;padding-top:40px;border-top:1px solid var(--border);">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:var(--text-dim);">
        Avance, progresse, dépasse — <strong style="color:var(--gold)">SPORT<span style="color:var(--green)">+</span></strong>
      </p>
    </div>

  </div>
</section>

{% endblock %}
