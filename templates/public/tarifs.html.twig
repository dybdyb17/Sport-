          <div style="font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:6px;">Solo (1 personne)</div>
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:800;color:var(--white);line-height:1;">+30 €<span style="font-size:14px;color:var(--text-soft);font-weight:600;"> / mois</span></div>
        </div>
        <div style="background:rgba(46,204,113,.06);border:1px solid rgba(46,204,113,.2);border-radius:var(--radius);padding:16px 18px;">
          <div style="font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:6px;">Duo (par personne)</div>
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:800;color:var(--white);line-height:1;">+30 €<span style="font-size:14px;color:var(--text-soft);font-weight:600;"> / mois</span></div>
        </div>
        <div style="background:rgba(46,204,113,.06);border:1px solid rgba(46,204,113,.2);border-radius:var(--radius);padding:16px 18px;">
          <div style="font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-bottom:6px;">Groupe (4–6 pers)</div>
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:800;color:var(--white);line-height:1;">+25 €<span style="font-size:14px;color:var(--text-soft);font-weight:600;"> / mois / personne</span></div>
        </div>
      </div>
      <div style="margin-top:18px;padding:12px 14px;background:rgba(46,204,113,.04);border:1px dashed rgba(46,204,113,.25);border-radius:var(--radius);font-size:13px;color:var(--text-soft);line-height:1.55;">
        <i class="ti ti-info-circle" style="color:var(--green);margin-right:6px;"></i>
        <strong style="color:var(--white);">Exemple Groupe :</strong> 5 personnes × 25 € = <strong style="color:var(--green);">125 € / mois</strong>. Le tarif Groupe est <strong>par personne</strong>, chaque membre du groupe paye sa part.
      </div>
    </div>

    {# ── CTA #}
    <div style="text-align:center;padding:48px 0 24px;">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:20px;color:var(--text-dim);margin-bottom:24px;">
        Prêt à commencer ? Réservez votre première séance.
      </p>
      <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-primary btn-lg">
        <i class="ti ti-calendar-plus"></i>
        Réserver une séance
      </a>
    </div>

    {# Slogan bas de page #}
    <div style="text-align:center;margin-top:40px;padding-top:40px;border-top:1px solid var(--border);">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:var(--text-dim);">
        Avance, progresse, dépasse — <strong style="color:var(--gold)">SPORT<span style="color:var(--green)">+</span></strong>
      </p>
    </div>

  </div>
</section>

{% endblock %}
