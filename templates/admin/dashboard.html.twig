{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord — Admin SPORT+{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-chart-bar"></i>
        <span>Tableau de <span class="admin-title-accent">bord</span></span>
      </h1>
      <p class="admin-subtitle">{{ periodLabel }} — pilotage business du club.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_export_revenue') }}" class="admin-btn-export">
        <i class="ti ti-file-download"></i> CA mensuel
      </a>
      <a href="{{ path('app_admin_export_founding') }}" class="admin-btn-export">
        <i class="ti ti-file-download"></i> Fondateurs
      </a>
    </div>
  </div>

  {# ── VUE D'ENSEMBLE DU MOIS — 4 cartes principales ──────────────── #}
  <div class="admin-section-title">
    <span>Vue d'ensemble du mois <span class="admin-section-title-sub">— {{ periodLabel }}</span></span>
  </div>

  {% set caMoisTva = tva_split(breakdown.total) %}
  <div class="admin-stats-grid">

    {# CA du mois TTC — la donnée-vedette de Loïc #}
    <div class="admin-stat admin-stat--gold">
      <div class="admin-stat-eyebrow">CA du mois <span class="admin-stat-eyebrow-mini">TTC</span></div>
      <div class="admin-stat-value">{{ breakdown.total|number_format(2, ',', ' ') }} €</div>
      <div class="admin-stat-hint">
        HT : <strong>{{ caMoisTva.ht|number_format(2, ',', ' ') }} €</strong> ·
        TVA 20 % : <strong>{{ caMoisTva.tva|number_format(2, ',', ' ') }} €</strong>
      </div>
      <div class="admin-stat-note">
        Part structure : {{ breakdown.structure|number_format(2, ',', ' ') }} € ·
        Part coach : {{ breakdown.coach|number_format(2, ',', ' ') }} €
      </div>
    </div>

    {# Marge structure — la 2ᵉ donnée qui parle à Loïc #}
    <div class="admin-stat admin-stat--green">
      <div class="admin-stat-eyebrow">Marge structure</div>
      <div class="admin-stat-value">{{ breakdown.structure|number_format(2, ',', ' ') }} €</div>
      {% if breakdown.total|number_format(2, '.', '') > 0 %}
        <div class="admin-stat-hint">
          <strong>{{ ((breakdown.structure / breakdown.total) * 100)|round }}%</strong> du CA total
        </div>
      {% endif %}
    </div>

    {# Séances confirmées #}
    <div class="admin-stat">
      <div class="admin-stat-eyebrow">Séances confirmées</div>
      <div class="admin-stat-value">{{ bookingCounts['confirmed'] }}</div>
      <div class="admin-stat-hint">
        En attente : <strong>{{ bookingCounts['pending'] }}</strong> ·
        Refusées : <strong>{{ bookingCounts['refused'] }}</strong>
      </div>
    </div>

    {# Membres fondateurs #}
    {% if foundingOffer and foundingStats %}
      {% set foVariant = foundingOffer.placesRemaining <= 5 ? 'admin-stat--danger'
                       : (foundingOffer.placesRemaining <= 25 ? 'admin-stat--gold' : 'admin-stat--green') %}
      <div class="admin-stat {{ foVariant }}">
        <div class="admin-stat-eyebrow">Membres fondateurs</div>
        <div class="admin-stat-value">{{ foundingStats.total }} / {{ foundingOffer.totalPlaces }}</div>
        <div class="admin-stat-progress">
          <div class="admin-stat-progress-fill" style="width:{{ foundingOffer.progressPercent }}%;"></div>
        </div>
        <div class="admin-stat-hint">
          <strong>{{ foundingOffer.placesRemaining }}</strong> place{{ foundingOffer.placesRemaining != 1 ? 's' : '' }} restante{{ foundingOffer.placesRemaining != 1 ? 's' : '' }}
        </div>
      </div>
    {% else %}
      <div class="admin-stat">
        <div class="admin-stat-eyebrow">Membres fondateurs</div>
        <div class="admin-stat-value">—</div>
        <div class="admin-stat-hint">Aucune offre active.</div>
      </div>
    {% endif %}
  </div>

  {# ── RÉPARTITION PAR CRÉNEAU (tous coachs) ──────────────────────── #}
  <div class="admin-section-title">
    <span>Répartition par créneau <span class="admin-section-title-sub">— {{ periodLabel }} · Tous coachs</span></span>
  </div>

  {% set totalSlots = slotStats['day'].count + slotStats['night'].count + slotStats['astreinte'].count %}

  <div class="slot-tiles">
    {% for slot, info in {
      'day':       {label: 'Journée',     hours: '6h — 20h',     icon: 'ti-sun',        color: 'gold',  data: slotStats['day']},
      'night':     {label: 'Night Coach', hours: '20h — minuit', icon: 'ti-moon',       color: 'green', data: slotStats['night']},
      'astreinte': {label: 'Astreinte',   hours: 'minuit — 6h',  icon: 'ti-moon-stars', color: 'red',   data: slotStats['astreinte']}
    } %}
      {% set pct = totalSlots > 0 ? (info.data.count / totalSlots * 100)|round : 0 %}
      <div class="slot-tile slot-tile--{{ info.color }}">
        <div class="slot-tile-glow" aria-hidden="true"></div>
        <div class="slot-tile-head">
          <div class="slot-tile-icon"><i class="ti {{ info.icon }}"></i></div>
          <div>
            <div class="slot-tile-label">{{ info.label }}</div>
            <div class="slot-tile-hours">{{ info.hours }}</div>
          </div>
          <div class="slot-tile-pct">{{ pct }}%</div>
        </div>
        <div class="slot-tile-bignum">
          <span class="slot-tile-num">{{ info.data.count }}</span>
          <span class="slot-tile-num-unit">séance{{ info.data.count > 1 ? 's' : '' }}</span>
        </div>
        <div class="slot-tile-bar">
          <div class="slot-tile-bar-fill" style="width:{{ pct }}%;"></div>
        </div>
        <div class="slot-tile-revenue">
          <span class="slot-tile-revenue-num">{{ info.data.revenue|number_format(0, ',', ' ') }} €</span>
          <span class="slot-tile-revenue-label">de CA</span>
        </div>
      </div>
    {% endfor %}
  </div>

  {# ── CALENDRIER — semaine en cours ─────────────────────────────── #}
  <div class="admin-section-title">
    <span>Calendrier <span class="admin-section-title-sub">— semaine du {{ weekMonday|date('d/m/Y') }}</span></span>
    <a href="{{ path('app_admin_calendar') }}" class="admin-section-title-link">
      Voir plein écran <i class="ti ti-arrow-right"></i>
    </a>
  </div>

  {% set dayLabels = {1: 'LUN', 2: 'MAR', 3: 'MER', 4: 'JEU', 5: 'VEN', 6: 'SAM', 7: 'DIM'} %}
  {% set slotLabels = {day: 'DAY', night: 'NIGHT', astreinte: 'ASTR.'} %}

  <div class="calendar-grid dashboard-week-grid">
    <div class="calendar-cell header"></div>
    {% for i in 1..7 %}
      <div class="calendar-cell header">
        {{ dayLabels[i] }}
        <span class="dashboard-week-date">{{ weekMonday|date_modify('+' ~ (i - 1) ~ ' days')|date('d/m') }}</span>
      </div>
    {% endfor %}
    {% for slotKey, slotLabel in slotLabels %}
      <div class="calendar-cell slot-label dashboard-slot-{{ slotKey }}">{{ slotLabel }}</div>
      {% for i in 1..7 %}
        <div class="calendar-cell">
          {% for booking in weekGrid[i][slotKey] %}
            <button type="button" class="calendar-event {{ slotKey != 'day' ? slotKey : '' }}"
                    data-peek-ref="{{ booking.reference }}"
                    title="{{ booking.client.nomComplet }} — {{ booking.coach.nomComplet }}">
              <span class="calendar-event-time">{{ booking.startAt|date('H:i') }}</span>
              <span class="calendar-event-meta">{{ booking.client.nomComplet|split(' ')|first }} · {{ booking.format.value|upper }}</span>
            </button>
          {% else %}
            <span></span>
          {% endfor %}
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  {# ── TOP COACHS DU MOIS ────────────────────────────────────────── #}
  {% if topCoaches is not empty %}
    <div class="admin-section-title">
      <span>Top coachs <span class="admin-section-title-sub">— {{ periodLabel }}</span></span>
    </div>
    <div class="admin-table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="admin-col-rank">Rang</th>
            <th>Coach</th>
            <th class="admin-align-center">Séances</th>
            <th class="admin-align-right">CA généré</th>
          </tr>
        </thead>
        <tbody>
          {% for entry in topCoaches %}
            <tr>
              <td data-label="Rang" class="admin-cell-rank">#{{ loop.index }}</td>
              <td data-label="Coach" class="admin-cell-primary">{{ entry.coach.nomComplet }}</td>
              <td data-label="Séances" class="admin-align-center admin-cell-num admin-cell-num--gold">{{ entry.sessions }}</td>
              <td data-label="CA généré" class="admin-align-right admin-cell-num admin-cell-num--gold">{{ entry.revenue|number_format(2, ',', ' ') }} €</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {# ── ABONNEMENTS ACTIFS ────────────────────────────────────────── #}
  <div class="admin-section-title">
    <span>Abonnements actifs</span>
  </div>
  <div class="admin-double-card">
    <div class="admin-double-metric">
      <div class="admin-double-metric-block">
        <div class="admin-double-metric-value admin-double-metric-value--gold">{{ subStats.active }}</div>
        <div class="admin-double-metric-label">abonnements actifs</div>
      </div>
      <div class="admin-double-metric-block">
        <div class="admin-double-metric-value admin-double-metric-value--green">
          {{ subStats.monthlyRecurring|number_format(2, ',', ' ') }} €
        </div>
        <div class="admin-double-metric-label">CA récurrent mensuel</div>
      </div>
    </div>

    {% if subStats.byPack is not empty %}
      <div class="admin-chips-row">
        {% for packKey, packCount in subStats.byPack %}
          <div class="admin-chip-pack">
            <strong>{{ packCount }}</strong>
            <span>× {{ packKey|upper|replace({'_': ' '}) }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if expiringSubs is not empty %}
      <div class="admin-callout admin-callout--warn">
        <span>
          <i class="ti ti-alert-triangle"></i>
          <strong>{{ expiringSubs|length }} abonnement{{ expiringSubs|length > 1 ? 's' : '' }}</strong>
          expire{{ expiringSubs|length > 1 ? 'nt' : '' }} dans les 7 prochains jours.
        </span>
        <a href="{{ path('app_admin_subscriptions', {expiring: 1}) }}" class="admin-callout-cta">
          Voir détails
        </a>
      </div>
    {% endif %}
  </div>

  {# ── CA CUMULÉ DEPUIS L'OUVERTURE ──────────────────────────────── #}
  {% set caTotalTva = tva_split(breakdownAllTime.total) %}
  <div class="admin-section-title">
    <span>CA cumulé depuis l'ouverture</span>
  </div>
  <div class="admin-stats-grid">
    <div class="admin-stat admin-stat--gold">
      <div class="admin-stat-eyebrow">CA total <span class="admin-stat-eyebrow-mini">TTC</span></div>
      <div class="admin-stat-value">{{ breakdownAllTime.total|number_format(2, ',', ' ') }} €</div>
      <div class="admin-stat-hint">
        HT : <strong>{{ caTotalTva.ht|number_format(2, ',', ' ') }} €</strong> ·
        TVA 20 % : <strong>{{ caTotalTva.tva|number_format(2, ',', ' ') }} €</strong>
      </div>
    </div>
    <div class="admin-stat admin-stat--green">
      <div class="admin-stat-eyebrow">Part structure (total)</div>
      <div class="admin-stat-value">{{ breakdownAllTime.structure|number_format(2, ',', ' ') }} €</div>
    </div>
    <div class="admin-stat">
      <div class="admin-stat-eyebrow">Membres inscrits</div>
      <div class="admin-stat-value">{{ totalUsers }}</div>
      <div class="admin-stat-hint">dont <strong>{{ totalCoaches }}</strong> coach{{ totalCoaches > 1 ? 's' : '' }}</div>
    </div>
  </div>

  {# ── DERNIÈRES RÉSERVATIONS ─────────────────────────────────────── #}
  <div class="admin-section-title">
    <span>Dernières réservations</span>
    <a href="{{ path('app_admin_bookings') }}" class="admin-section-title-link">
      Voir tout <i class="ti ti-arrow-right"></i>
    </a>
  </div>

  {% if recentBookings is empty %}
    <div class="admin-empty">
      <i class="ti ti-inbox"></i>
      <div class="admin-empty-title">Aucune réservation pour le moment</div>
    </div>
  {% else %}
    <div class="admin-table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Réf.</th>
            <th>Prestation</th>
            <th>Date</th>
            <th>Client</th>
            <th>Coach</th>
            <th>Statut</th>
            <th class="admin-align-right">Prix</th>
          </tr>
        </thead>
        <tbody>
          {% for booking in recentBookings %}
            <tr data-peek-ref="{{ booking.reference }}">
              <td data-label="Réf." class="admin-cell-ref">{{ booking.reference }}</td>
              <td data-label="Prestation">
                <span class="admin-cell-primary admin-cell-primary--barlow">{{ booking.offerLabel }}</span>
              </td>
              <td data-label="Date" class="admin-cell-date">{{ booking.startAt|date('d/m/Y') }}</td>
              <td data-label="Client">
                {{ booking.client.nomComplet }}
                {% if booking.client.isFoundingMember %}
                  <span class="admin-founding-pill" title="Membre Fondateur"><i class="ti ti-crown"></i> Fondateur</span>
                {% endif %}
              </td>
              <td data-label="Coach">{{ booking.coach.nomComplet }}</td>
              <td data-label="Statut">
                {% set badge = {
                  'confirmed': 'admin-badge--ok',
                  'pending':   'admin-badge--gold',
                  'refused':   'admin-badge--danger',
                  'cancelled': 'admin-badge--neutral',
                } %}
                <span class="admin-badge {{ badge[booking.status] ?? 'admin-badge--neutral' }}">
                  <i class="ti {{ booking.statutIcon }}"></i>{{ booking.statutLabel }}
                </span>
              </td>
              <td data-label="Prix" class="admin-align-right admin-cell-num admin-cell-num--gold">
                {{ booking.displayAmountFormatted }}
                {% if booking.coveredBy == 'founding' %}
                  <div><span class="admin-mini-tag admin-mini-tag--gold">Fondateur</span></div>
                {% endif %}
                {% if booking.coveredBy == 'subscription' and booking.subscription %}
                  <div><span class="admin-mini-tag admin-mini-tag--green">Via {{ booking.subscription.packType.label }}</span></div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>
{% endblock %}
