{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="admin-page">

  <a href="{{ path('app_admin_conversations') }}" class="admin-back-link">
    <i class="ti ti-arrow-left"></i> Toutes les conversations
  </a>

  <div class="admin-conversation-header">
    <div class="admin-conversation-header-id">
      <div class="admin-conversation-eyebrow">CONV-{{ conversation.id }}</div>
      <h1 class="admin-conversation-title">
        {{ conversation.client ? conversation.client.nomComplet : '—' }}
        <span class="admin-conversation-title-sep">↔</span>
        {{ conversation.coach ? conversation.coach.nomComplet : '—' }}
      </h1>
      <div class="admin-conversation-meta">
        Ouverte le {{ conversation.createdAt|date('d/m/Y \\à H\\hi') }} ·
        {{ conversation.messages|length }} message{{ conversation.messages|length > 1 ? 's' : '' }}
      </div>
    </div>

    {# Recherche dans la conv #}
    <form method="get" action="{{ path('app_admin_conversation_show', {id: conversation.id}) }}"
          class="admin-conversation-search">
      <input type="search" name="highlight" value="{{ highlight }}" placeholder="Surligner un mot…"
             class="form-control">
      <button type="submit" class="btn btn-secondary btn-sm">
        <i class="ti ti-search"></i>
      </button>
    </form>
  </div>

  <div class="admin-chat-container">
    <div class="admin-chat-scroll">
      {% if conversation.messages|length == 0 %}
        <p class="admin-chat-empty">Aucun message dans cette conversation.</p>
      {% else %}
        {% for msg in conversation.messages %}
          {% set isClient = conversation.client and msg.author.id == conversation.client.id %}

          {% set msgFlagged = false %}
          {% set lowered = msg.content|lower %}
          {% for kw in sensitiveKeywords %}
            {% if not msgFlagged and lowered matches '/' ~ kw ~ '/' %}
              {% set msgFlagged = true %}
            {% endif %}
          {% endfor %}

          <div class="admin-chat-message {{ isClient ? 'admin-chat-message--client' : 'admin-chat-message--coach' }} {{ msgFlagged ? 'admin-chat-message--flagged' : '' }}">
            <div class="admin-chat-message-head">
              <div class="admin-chat-message-author">
                <strong>{{ msg.author.nomComplet }}</strong>
                <span class="admin-chat-message-role">{{ isClient ? 'Client' : 'Coach' }}</span>
                {% if msgFlagged %}
                  <span class="admin-chat-message-flag">
                    <i class="ti ti-flag"></i> Mot-clé sensible
                  </span>
                {% endif %}
              </div>
              <span class="admin-chat-message-date">{{ msg.createdAt|date('d/m/Y \\à H\\hi') }}</span>
            </div>
            <div class="admin-chat-message-body">{{ msg.content|highlight_sensitive(sensitiveKeywords, highlight) }}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

</div>
{% endblock %}
