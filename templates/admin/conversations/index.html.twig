{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-messages"></i>
        <span class="admin-title-accent">Conversations</span>
      </h1>
      <p class="admin-subtitle">
        {{ rows|length }} conversation{{ rows|length > 1 ? 's' : '' }} — lecture complète des échanges coach ↔ client.
        Les conversations avec un mot-clé sensible (paiement, fraude, hors-site…) sont signalées d'un drapeau.
      </p>
    </div>
  </div>

  {# ── Barre de filtres ────────────────────────────────────────── #}
  <form method="get" action="{{ path('app_admin_conversations') }}" class="conv-admin-filters admin-filters">
    <div class="admin-filter-field">
      <label class="admin-filter-label">Recherche (message, client, coach)</label>
      <input type="search" name="q" value="{{ search }}" placeholder="Ex : paiement, Karim, cash…"
             class="form-control" autocomplete="off">
    </div>
    <div class="admin-filter-field">
      <label class="admin-filter-label">Ouverte du</label>
      <input type="date" name="from" value="{{ from }}" class="form-control">
    </div>
    <div class="admin-filter-field">
      <label class="admin-filter-label">au</label>
      <input type="date" name="to" value="{{ to }}" class="form-control">
    </div>
    <div class="admin-filter-actions">
      <label class="admin-filter-check">
        <input type="checkbox" name="flagged" value="1" {{ flagOnly ? 'checked' : '' }}> Signalées
      </label>
      <button type="submit" class="btn btn-primary btn-sm">
        <i class="ti ti-filter"></i> Filtrer
      </button>
    </div>
  </form>

  {% if rows|length == 0 %}
    <div class="admin-empty">
      <i class="ti ti-message-off"></i>
      <div class="admin-empty-sub">
        Aucune conversation trouvée{% if search or from or to or flagOnly %} avec ces critères{% endif %}.
      </div>
      {% if search or from or to or flagOnly %}
        <div class="admin-empty-actions">
          <a href="{{ path('app_admin_conversations') }}" class="btn btn-secondary btn-sm">
            <i class="ti ti-x"></i> Réinitialiser les filtres
          </a>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="admin-table-card">
      <div class="admin-table-header">
        <h3>{{ rows|length }} conversation{{ rows|length > 1 ? 's' : '' }}</h3>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Réf.</th>
            <th>Client ↔ Coach</th>
            <th>Dernier message</th>
            <th>Messages</th>
            <th>Activité</th>
            <th class="admin-align-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            {% set conv = row.conversation %}
            {% set lastMsg = conv.lastMessage %}
            <tr class="{{ row.flagged ? 'admin-row-flagged' : '' }}">
              <td data-label="Réf.">
                <span class="admin-cell-ref">CONV-{{ conv.id }}</span>
                <div class="admin-cell-tiny">Depuis {{ conv.createdAt|date('d/m/Y') }}</div>
                {% if row.flagged %}
                  <div class="admin-flag-mini">
                    <i class="ti ti-flag"></i> Signalée
                  </div>
                {% endif %}
              </td>
              <td data-label="Client ↔ Coach">
                <div class="admin-cell-strong">{{ conv.client ? conv.client.nomComplet : '—' }}</div>
                <div class="admin-cell-sub">↳ {{ conv.coach ? conv.coach.nomComplet : '—' }}</div>
              </td>
              <td data-label="Dernier message" class="admin-cell-lastmsg">
                {% if lastMsg %}
                  <div class="admin-cell-lastmsg-body">
                    <strong class="admin-cell-lastmsg-author">{{ lastMsg.author.firstName ?? lastMsg.author.email }} :</strong>
                    {{ lastMsg.content|highlight_sensitive(sensitiveKeywords, search) }}
                  </div>
                {% else %}
                  <span class="admin-empty-value">—</span>
                {% endif %}
              </td>
              <td data-label="Messages"><strong>{{ conv.messages|length }}</strong></td>
              <td data-label="Activité" class="admin-cell-date admin-cell-nowrap">
                {% if lastMsg %}{{ lastMsg.createdAt|date('d/m H\\hi') }}{% else %}—{% endif %}
              </td>
              <td data-label="Actions" class="admin-align-right">
                <a href="{{ path('app_admin_conversation_show', {id: conv.id, highlight: search}) }}" class="btn btn-secondary btn-sm">
                  <i class="ti ti-eye"></i> Lire
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>
{% endblock %}
