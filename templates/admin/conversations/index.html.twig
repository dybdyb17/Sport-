{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="page-header">
  <div>
    <h1><span style="color:var(--gold)">Conversations</span></h1>
    <p class="page-subtitle">
      {{ rows|length }} conversation{{ rows|length > 1 ? 's' : '' }} — lecture complète des échanges coach ↔ client.
      Les conversations avec un mot-clé sensible (paiement, fraude, hors-site…) sont signalées d'un drapeau.
    </p>
  </div>
</div>

{# ── Barre de filtres ────────────────────────────────────────── #}
<form method="get" action="{{ path('app_admin_conversations') }}"
      style="display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:12px;
             padding:16px;margin-bottom:24px;background:var(--bg-card);
             border:1px solid var(--border);border-radius:12px;">
  <div>
    <label style="display:block;font-size:12px;color:var(--text-dim);margin-bottom:4px;">
      Recherche (message, client, coach)
    </label>
    <input type="search" name="q" value="{{ search }}" placeholder="Ex : paiement, Karim, cash…"
           class="form-control" autocomplete="off">
  </div>
  <div>
    <label style="display:block;font-size:12px;color:var(--text-dim);margin-bottom:4px;">Ouverte du</label>
    <input type="date" name="from" value="{{ from }}" class="form-control">
  </div>
  <div>
    <label style="display:block;font-size:12px;color:var(--text-dim);margin-bottom:4px;">au</label>
    <input type="date" name="to" value="{{ to }}" class="form-control">
  </div>
  <div style="display:flex;flex-direction:column;justify-content:flex-end;gap:6px;">
    <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text-dim);">
      <input type="checkbox" name="flagged" value="1" {{ flagOnly ? 'checked' : '' }}> Signalées
    </label>
    <button type="submit" class="btn btn-primary btn-sm">
      <i class="ti ti-filter"></i> Filtrer
    </button>
  </div>
</form>

{% if rows|length == 0 %}
  <div class="empty-placeholder" style="padding:60px;text-align:center;">
    Aucune conversation trouvée{% if search or from or to or flagOnly %} avec ces critères{% endif %}.
    {% if search or from or to or flagOnly %}
      <div style="margin-top:14px;">
        <a href="{{ path('app_admin_conversations') }}" class="btn btn-secondary btn-sm">
          <i class="ti ti-x"></i> Réinitialiser les filtres
        </a>
      </div>
    {% endif %}
  </div>
{% else %}
  <div class="data-table-card">
    <div class="data-table-header"><h3>{{ rows|length }} conversation{{ rows|length > 1 ? 's' : '' }}</h3></div>
    <table>
      <thead>
        <tr>
          <th>Réf.</th>
          <th>Client ↔ Coach</th>
          <th>Dernier message</th>
          <th>Messages</th>
          <th>Activité</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          {% set conv = row.conversation %}
          {% set lastMsg = conv.lastMessage %}
          <tr style="{% if row.flagged %}background:rgba(255,80,80,.04);{% endif %}">
            <td>
              <span style="font-family:'Barlow Condensed',sans-serif;letter-spacing:1.5px;font-weight:700;color:var(--gold);">CONV-{{ conv.id }}</span>
              <div style="font-size:11px;color:var(--text-dim);">Depuis {{ conv.createdAt|date('d/m/Y') }}</div>
              {% if row.flagged %}
                <div style="margin-top:4px;display:inline-flex;align-items:center;gap:4px;
                            font-size:10px;color:#ff8a8a;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
                  <i class="ti ti-flag"></i> Signalée
                </div>
              {% endif %}
            </td>
            <td>
              <div style="color:var(--white);font-weight:600;">{{ conv.client ? conv.client.nomComplet : '—' }}</div>
              <div style="color:var(--text-dim);font-size:12px;">↳ {{ conv.coach ? conv.coach.nomComplet : '—' }}</div>
            </td>
            <td style="max-width:340px;">
              {% if lastMsg %}
                <div style="color:var(--text-soft);font-size:13px;line-height:1.5;
                            display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
                            overflow:hidden;text-overflow:ellipsis;">
                  <strong style="color:var(--text-dim);">{{ lastMsg.author.firstName ?? lastMsg.author.email }} :</strong>
                  {{ lastMsg.content|highlight_sensitive(sensitiveKeywords, search) }}
                </div>
              {% else %}
                <span style="color:var(--text-dim);">—</span>
              {% endif %}
            </td>
            <td><strong>{{ conv.messages|length }}</strong></td>
            <td style="color:var(--text-dim);font-size:13px;white-space:nowrap;">
              {% if lastMsg %}{{ lastMsg.createdAt|date('d/m H\\hi') }}{% else %}—{% endif %}
            </td>
            <td>
              <a href="{{ path('app_admin_conversation_show', {id: conv.id, highlight: search}) }}" class="btn btn-secondary btn-sm">
                <i class="ti ti-eye"></i> Lire
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
