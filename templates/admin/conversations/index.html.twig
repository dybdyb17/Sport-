{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="page-header">
  <div>
    <h1><span style="color:var(--gold)">Conversations</span></h1>
    <p class="page-subtitle">{{ conversations|length }} conversation{{ conversations|length > 1 ? 's' : '' }} — lecture complète des échanges coach↔client.</p>
  </div>
</div>

{% if conversations|length == 0 %}
  <div class="empty-placeholder" style="padding:60px;text-align:center;">
    Aucune conversation pour le moment.
  </div>
{% else %}
  <div class="data-table-card">
    <div class="data-table-header"><h3>Liste des conversations</h3></div>
    <table>
      <thead>
        <tr>
          <th>Réservation</th>
          <th>Client</th>
          <th>Coach</th>
          <th>Messages</th>
          <th>Dernier échange</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for conv in conversations %}
          {% set lastMsg = conv.lastMessage %}
          <tr data-href="{{ path('app_admin_conversation_show', {id: conv.id}) }}" class="row-clickable">
            <td>
              <span style="font-family:'Barlow Condensed',sans-serif;letter-spacing:1.5px;font-weight:700;color:var(--gold);">CONV-{{ conv.id }}</span>
              <div style="font-size:12px;color:var(--text-dim);">Depuis {{ conv.createdAt|date('d/m/Y') }}</div>
            </td>
            <td style="color:var(--text-dim);">{{ conv.client ? conv.client.nomComplet : '—' }}</td>
            <td style="color:var(--text-dim);">{{ conv.coach ? conv.coach.nomComplet : '—' }}</td>
            <td><strong>{{ conv.messages|length }}</strong></td>
            <td style="color:var(--text-dim);font-size:13px;">
              {% if lastMsg %}{{ lastMsg.createdAt|date('d/m H\\hi') }}{% else %}—{% endif %}
            </td>
            <td>
              <a href="{{ path('app_admin_conversation_show', {id: conv.id}) }}" class="btn btn-secondary btn-sm">
                <i class="ti ti-eye"></i> Lire
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
{% endblock %}
