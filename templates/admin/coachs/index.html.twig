{% extends 'admin/base.html.twig' %}

{% block title %}Coachs — Admin SPORT+{% endblock %}

{% block admin_body %}

<div class="page-header">
  <div>
    <h1>Gestion des <span style="color:var(--gold)">Coachs</span></h1>
    <p class="page-subtitle">{{ coaches|length }} coach{% if coaches|length > 1 %}s{% endif %} enregistré{% if coaches|length > 1 %}s{% endif %}</p>
  </div>
  <a href="{{ path('app_admin_coach_new') }}" class="btn btn-primary">
    <i class="ti ti-plus"></i> Créer un coach
  </a>
</div>

<div class="data-table-card">
  <div class="data-table-header">
    <h3>Liste des coachs</h3>
  </div>
  {% if coaches is empty %}
    <div class="empty-placeholder" style="padding:60px;">Aucun coach enregistré. Créez le premier profil coach.</div>
  {% else %}
    <table>
      <thead>
        <tr>
          <th>Coach</th>
          <th>Email</th>
          <th>Spécialités</th>
          <th>Bio</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for coach in coaches %}
          <tr>
            <td>
              {% set coachPhoto = coach.photoSrc %}
              <div class="admin-coach-cell">
                {% if coachPhoto %}
                  <img src="{{ coachPhoto }}"
                       alt="{{ coach.nomComplet }}"
                       class="admin-coach-avatar">
                {% else %}
                  <div class="admin-coach-avatar admin-coach-avatar-placeholder">
                    {%- set words = coach.nomComplet|split(' ') -%}
                    {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
                  </div>
                {% endif %}
                <span class="admin-coach-name">{{ coach.nomComplet }}</span>
              </div>
            </td>
            <td class="admin-coach-email">{{ coach.user.email }}</td>
            <td class="cell-wrap admin-coach-specialties">{{ coach.specialtiesLabel }}</td>
            <td class="cell-wrap admin-coach-bio">
              {% if coach.bio %}
                {{ coach.bio|striptags|slice(0,110) }}{% if coach.bio|length > 110 %}…{% endif %}
              {% else %}
                <span class="admin-empty-value">—</span>
              {% endif %}
            </td>
            <td style="text-align:right;">
              <a href="{{ path('app_admin_coach_edit', {id: coach.id}) }}" class="btn btn-secondary btn-sm">
                <i class="ti ti-edit"></i> Modifier
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>

{% endblock %}
