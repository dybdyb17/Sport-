{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ coach.nomComplet }} — Admin SPORT+{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-user-edit"></i>
        <span>Modifier <span class="admin-title-accent">{{ coach.nomComplet }}</span></span>
      </h1>
      <p class="admin-subtitle">Mise à jour des informations du coach.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_coachs') }}" class="admin-back-link">
        <i class="ti ti-arrow-left"></i> Retour à la liste
      </a>
    </div>
  </div>

  {% set coachPhoto = coach.photoSrc %}

  {# Mini-card récap #}
  <div class="admin-user-mini-card">
    {% if coachPhoto %}
      <img src="{{ coachPhoto }}" alt="{{ coach.nomComplet }}" class="admin-user-mini-avatar">
    {% else %}
      <div class="admin-user-mini-avatar admin-user-mini-avatar--initials">
        {%- set words = coach.nomComplet|split(' ') -%}
        {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
      </div>
    {% endif %}
    <div class="admin-user-mini-body">
      <div class="admin-user-mini-name">{{ coach.nomComplet }}</div>
      <div class="admin-user-mini-email">{{ coach.user.email }}</div>
      <div class="admin-user-mini-meta">
        <span><i class="ti ti-calendar"></i> Membre depuis {{ coach.user.createdAt|date('d/m/Y') }}</span>
        <span class="admin-user-mini-sep">·</span>
        <span><i class="ti ti-list-check"></i> {{ coach.bookings|length }} réservation{% if coach.bookings|length > 1 %}s{% endif %}</span>
      </div>
    </div>
  </div>

  <div class="admin-form-card">

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      {% if form.vars.submitted and not form.vars.valid %}
        <div class="admin-form-errors">
          <i class="ti ti-alert-circle admin-form-errors-icon"></i>
          <div class="admin-form-errors-body">
            <strong>Impossible d'enregistrer les modifications :</strong>
            <ul>
              {% for error in form.vars.errors %}
                <li>{{ error.message }}</li>
              {% endfor %}
              {% for child in form %}
                {% for error in child.vars.errors %}
                  <li><strong>{{ child.vars.label ?? child.vars.name }}</strong> : {{ error.message }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      <div class="form-field">
        {{ form_label(form.nomComplet) }}
        {{ form_widget(form.nomComplet) }}
        {{ form_errors(form.nomComplet) }}
      </div>

      <div class="form-field">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
      </div>

      <div class="form-field">
        {{ form_label(form.phone) }}
        {{ form_widget(form.phone) }}
        {{ form_errors(form.phone) }}
      </div>

      <div class="form-field">
        {{ form_label(form.plainPassword) }}
        <div class="password-field-wrapper">
          {{ form_widget(form.plainPassword) }}
          <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Afficher/masquer le mot de passe">
            <i class="ti ti-eye"></i>
          </button>
        </div>
        {{ form_errors(form.plainPassword) }}
        <div class="admin-form-hint">
          <i class="ti ti-info-circle"></i> 8 caractères minimum si modifié.
        </div>
      </div>

      <div class="form-field">
        {{ form_label(form.bio) }}
        {{ form_widget(form.bio) }}
        {{ form_errors(form.bio) }}
      </div>

      <div class="form-field">
        {{ form_label(form.photoFile) }}
        {% if coachPhoto %}
          <div class="admin-photo-current">
            <img src="{{ coachPhoto }}" alt="Photo actuelle" class="admin-photo-current-img">
            <span class="admin-photo-current-label">Photo actuelle — uploader une nouvelle pour la remplacer</span>
          </div>
        {% endif %}
        {{ form_widget(form.photoFile) }}
        {{ form_errors(form.photoFile) }}
      </div>

      <div class="form-field">
        {{ form_label(form.specialties, null, {'label_attr': {'class': 'form-label-uppercase'}}) }}
        <div class="chip-group">
          {% for child in form.specialties %}
            <label class="chip">
              {{ form_widget(child) }}
              <span class="chip-text">{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_errors(form.specialties) }}
      </div>

      <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-device-floppy"></i> Enregistrer les modifications
        </button>
        <a href="{{ path('app_admin_coachs') }}" class="btn btn-secondary">Annuler</a>
      </div>

    {{ form_end(form) }}

  </div>

</div>
{% endblock %}
