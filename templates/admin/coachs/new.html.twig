{% extends 'admin/base.html.twig' %}

{% block title %}Créer un coach — Admin SPORT+{% endblock %}

{% block admin_body %}

<div class="page-header">
  <div>
    <h1>Nouveau <span style="color:var(--gold)">Coach</span></h1>
    <p class="page-subtitle">Créer un nouveau profil coach</p>
  </div>
  <a href="{{ path('app_admin_coachs') }}" class="btn btn-secondary">
    <i class="ti ti-arrow-left"></i> Retour à la liste
  </a>
</div>

<div style="max-width:800px;margin:0 auto;">
  <div class="data-table-card" style="padding:32px 40px;">

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      {% if form.vars.submitted and not form.vars.valid %}
        <div style="display:flex;gap:12px;align-items:flex-start;padding:14px 18px;margin-bottom:24px;
                    background:rgba(255,80,80,.08);border:1px solid rgba(255,80,80,.4);
                    border-radius:10px;color:#ffb3b3;">
          <i class="ti ti-alert-circle" style="font-size:22px;color:#ff6b6b;flex-shrink:0;margin-top:2px;"></i>
          <div style="flex:1;font-size:14px;line-height:1.6;">
            <strong style="color:#fff;display:block;margin-bottom:4px;">Impossible d'enregistrer ce coach :</strong>
            <ul style="margin:0;padding-left:18px;">
              {% for error in form.vars.errors %}
                <li>{{ error.message }}</li>
              {% endfor %}
              {% for child in form %}
                {% for error in child.vars.errors %}
                  <li><strong>{{ child.vars.label ?? child.vars.name }}</strong> : {{ error.message }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      <div class="form-field">
        {{ form_label(form.nomComplet) }}
        {{ form_widget(form.nomComplet) }}
        {{ form_errors(form.nomComplet) }}
      </div>

      <div class="form-field">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
      </div>

      <div class="form-field">
        {{ form_label(form.phone) }}
        {{ form_widget(form.phone) }}
        {{ form_errors(form.phone) }}
      </div>

      <div class="form-field">
        {{ form_label(form.plainPassword) }}
        <div class="password-field-wrapper">
          {{ form_widget(form.plainPassword) }}
          <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Afficher/masquer le mot de passe">
            <i class="ti ti-eye"></i>
          </button>
        </div>
        {{ form_errors(form.plainPassword) }}
        <div style="font-size:12px;color:var(--text-dim);margin-top:6px;">
          <i class="ti ti-info-circle"></i> 8 caractères minimum.
        </div>
      </div>

      <div class="form-field">
        {{ form_label(form.bio) }}
        {{ form_widget(form.bio) }}
        {{ form_errors(form.bio) }}
      </div>

      <div class="form-field">
        {{ form_label(form.photoFile) }}
        {{ form_widget(form.photoFile) }}
        {{ form_errors(form.photoFile) }}
        <div style="font-size:12px;color:var(--text-dim);margin-top:6px;">
          <i class="ti ti-info-circle"></i> JPEG, PNG ou WebP — max 2 Mo
        </div>
      </div>

      <div class="form-field">
        {{ form_label(form.specialties, null, {'label_attr': {'class': 'form-label-uppercase'}}) }}
        <div class="chip-group">
          {% for child in form.specialties %}
            <label class="chip">
              {{ form_widget(child) }}
              <span class="chip-text">{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_errors(form.specialties) }}
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">
        <i class="ti ti-user-plus"></i> Créer le coach
      </button>

    {{ form_end(form) }}

  </div>
</div>

{% endblock %}
