{% extends 'admin/base.html.twig' %}

{% block title %}Créer un coach — Admin SPORT+{% endblock %}

{% block admin_body %}

<div class="page-header">
  <div>
    <h1>Nouveau <span style="color:var(--gold)">Coach</span></h1>
    <p class="page-subtitle">Créer un nouveau profil coach</p>
  </div>
  <a href="{{ path('app_admin_coachs') }}" class="btn btn-secondary">
    <i class="ti ti-arrow-left"></i> Retour à la liste
  </a>
</div>

<div style="max-width:800px;margin:0 auto;">
  <div class="data-table-card" style="padding:32px 40px;">

    {{ form_start(form) }}

      <div class="form-field">
        {{ form_label(form.nomComplet) }}
        {{ form_widget(form.nomComplet) }}
        {{ form_errors(form.nomComplet) }}
      </div>

      <div class="form-field">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
      </div>

      <div class="form-field">
        {{ form_label(form.phone) }}
        {{ form_widget(form.phone) }}
        {{ form_errors(form.phone) }}
      </div>

      <div class="form-field">
        {{ form_label(form.plainPassword) }}
        {{ form_widget(form.plainPassword) }}
        {{ form_errors(form.plainPassword) }}
      </div>

      <div class="form-field">
        {{ form_label(form.hourlyRate) }}
        {{ form_widget(form.hourlyRate) }}
        {{ form_errors(form.hourlyRate) }}
      </div>

      <div class="form-field">
        {{ form_label(form.specialties, null, {'label_attr': {'class': 'form-label-uppercase'}}) }}
        <div class="chip-group">
          {% for child in form.specialties %}
            <label class="chip">
              {{ form_widget(child) }}
              <span class="chip-text">{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_errors(form.specialties) }}
      </div>

      <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">
        <i class="ti ti-user-plus"></i> Créer le coach
      </button>

    {{ form_end(form) }}

  </div>
</div>

{% endblock %}
