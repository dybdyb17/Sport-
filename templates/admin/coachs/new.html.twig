{% extends 'admin/base.html.twig' %}

{% block title %}Créer un coach — Admin SPORT+{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-user-plus"></i>
        <span>Nouveau <span class="admin-title-accent">coach</span></span>
      </h1>
      <p class="admin-subtitle">Créer un nouveau profil coach.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_coachs') }}" class="admin-back-link">
        <i class="ti ti-arrow-left"></i> Retour à la liste
      </a>
    </div>
  </div>

  <div class="admin-form-card">

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

      {% if form.vars.submitted and not form.vars.valid %}
        <div class="admin-form-errors">
          <i class="ti ti-alert-circle admin-form-errors-icon"></i>
          <div class="admin-form-errors-body">
            <strong>Impossible d'enregistrer ce coach :</strong>
            <ul>
              {% for error in form.vars.errors %}
                <li>{{ error.message }}</li>
              {% endfor %}
              {% for child in form %}
                {% for error in child.vars.errors %}
                  <li><strong>{{ child.vars.label ?? child.vars.name }}</strong> : {{ error.message }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      <div class="form-field">
        {{ form_label(form.nomComplet) }}
        {{ form_widget(form.nomComplet) }}
        {{ form_errors(form.nomComplet) }}
      </div>

      <div class="form-field">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
      </div>

      <div class="form-field">
        {{ form_label(form.phone) }}
        {{ form_widget(form.phone) }}
        {{ form_errors(form.phone) }}
      </div>

      <div class="form-field">
        {{ form_label(form.plainPassword) }}
        <div class="password-field-wrapper">
          {{ form_widget(form.plainPassword) }}
          <button type="button" class="password-toggle" onclick="togglePassword(this)" aria-label="Afficher/masquer le mot de passe">
            <i class="ti ti-eye"></i>
          </button>
        </div>
        {{ form_errors(form.plainPassword) }}
        <div class="admin-form-hint">
          <i class="ti ti-info-circle"></i> 8 caractères minimum.
        </div>
      </div>

      <div class="form-field">
        {{ form_label(form.bio) }}
        {{ form_widget(form.bio) }}
        {{ form_errors(form.bio) }}
      </div>

      <div class="form-field">
        {{ form_label(form.photoFile) }}
        {{ form_widget(form.photoFile) }}
        {{ form_errors(form.photoFile) }}
        <div class="admin-form-hint">
          <i class="ti ti-info-circle"></i> JPEG, PNG ou WebP — max 2 Mo
        </div>
      </div>

      <div class="form-field">
        {{ form_label(form.specialties, null, {'label_attr': {'class': 'form-label-uppercase'}}) }}
        <div class="chip-group">
          {% for child in form.specialties %}
            <label class="chip">
              {{ form_widget(child) }}
              <span class="chip-text">{{ child.vars.label }}</span>
            </label>
          {% endfor %}
        </div>
        {{ form_errors(form.specialties) }}
      </div>

      <button type="submit" class="btn btn-primary btn-full admin-form-submit">
        <i class="ti ti-user-plus"></i> Créer le coach
      </button>

    {{ form_end(form) }}

  </div>

</div>
{% endblock %}
