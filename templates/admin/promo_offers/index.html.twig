{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-brand-instagram"></i>
        <span>Offres <span class="admin-title-accent">Instagram</span></span>
      </h1>
      <p class="admin-subtitle">Crée une offre SPORT+ payable par lien Stripe pour story, pub ou bio Instagram.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_promo_offer_new') }}" class="admin-btn-pill admin-btn-pill--green">
        <i class="ti ti-plus"></i> Nouvelle offre
      </a>
    </div>
  </div>

  {# Encart "Paiements au club en attente" — n'apparaît que s'il y en a. #}
  {% if pendingOnsite is defined and pendingOnsite|length > 0 %}
    <a href="{{ path('app_admin_promo_pending_onsite') }}" class="admin-callout-link">
      <div class="admin-callout-link-icon">
        <i class="ti ti-cash"></i>
      </div>
      <div class="admin-callout-link-body">
        <div class="admin-callout-link-title">
          Paiements au club en attente
          <span class="admin-callout-link-count">{{ pendingOnsite|length }}</span>
        </div>
        <div class="admin-callout-link-sub">
          {{ pendingOnsite|length > 1 ? 'clients' : 'client' }} en attente d'encaissement espèces / CB au comptoir.
        </div>
      </div>
      <i class="ti ti-chevron-right admin-callout-link-chevron"></i>
    </a>
  {% endif %}

  <div class="admin-table-card">
    <div class="admin-table-header">
      <h3>Liens publics</h3>
    </div>
    {% if offers is empty %}
      <div class="admin-empty">
        <i class="ti ti-file-off"></i>
        <div class="admin-empty-sub">Aucune offre pour le moment.</div>
      </div>
    {% else %}
      <table class="admin-table">
        <thead>
          <tr>
            <th>Offre</th>
            <th>Prix</th>
            <th>Statut</th>
            <th>Ventes</th>
            <th>Lien Instagram</th>
            <th class="admin-align-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for offer in offers %}
            {% set publicUrl = url('app_promo_offer_show', {slug: offer.slug}) %}
            <tr>
              <td data-label="Offre">
                <strong class="admin-cell-strong">{{ offer.title }}</strong>
                <div class="admin-cell-sub">/{{ offer.slug }} · {{ offer.type }}</div>
              </td>
              <td data-label="Prix" class="admin-cell-price">{{ offer.priceFormatted }}</td>
              <td data-label="Statut">
                <span class="status-badge {{ offer.status == 'active' ? 'confirmed' : (offer.status == 'draft' ? 'pending' : 'cancelled') }}">{{ offer.status }}</span>
              </td>
              <td data-label="Ventes">
                <div class="admin-cell-strong">{{ offer.paidPurchasesCount }}{% if offer.maxQuantity %} / {{ offer.maxQuantity }}{% endif %} vente{{ offer.paidPurchasesCount > 1 ? 's' : '' }}</div>
                <div class="admin-cell-sub">{{ offer.checkedInPurchasesCount }} check-in{{ offer.checkedInPurchasesCount > 1 ? 's' : '' }}</div>
              </td>
              <td data-label="Lien Instagram">
                <input value="{{ publicUrl }}" readonly onclick="this.select();navigator.clipboard && navigator.clipboard.writeText(this.value);" class="admin-copy-input">
              </td>
              <td data-label="Actions" class="admin-align-right">
                <div class="admin-cell-actions">
                  <a href="{{ path('app_admin_promo_offer_edit', {id: offer.id}) }}#achats-checkins" class="btn btn-primary btn-sm">
                    <i class="ti ti-list-check"></i> Achats
                  </a>
                  <a href="{{ path('app_admin_promo_offer_edit', {id: offer.id}) }}" class="btn btn-secondary btn-sm">
                    <i class="ti ti-edit"></i> Modifier
                  </a>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>

</div>
{% endblock %}
