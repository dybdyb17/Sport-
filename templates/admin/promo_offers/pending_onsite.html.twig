{% extends 'admin/base.html.twig' %}

{% block title %}Paiements au club — Offres Instagram — SPORT+{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-cash admin-title-icon--green"></i>
        <span>Paiements au club <span class="admin-title-sub">— Offres Instagram</span></span>
      </h1>
      <p class="admin-subtitle">Réservations en attente de paiement espèces / CB au comptoir.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_promo_offers') }}" class="admin-back-link">
        <i class="ti ti-arrow-left"></i> Retour aux offres
      </a>
    </div>
  </div>

  {% if purchases is empty %}
    <div class="admin-empty">
      <i class="ti ti-inbox"></i>
      <div class="admin-empty-sub">Aucune réservation en attente de paiement au club.</div>
    </div>
  {% else %}
    <div class="admin-pending-list">
      {% for p in purchases %}
        <div class="admin-pending-card">

          <div class="admin-pending-card-head">
            <div class="admin-pending-card-id">
              <div class="admin-pending-card-ref">
                {{ p.reference }}
                {% if p.offer.isUnlimitedAccess %}
                  <span class="admin-pending-card-lifetime">
                    <i class="ti ti-infinity"></i> À vie
                  </span>
                {% endif %}
              </div>
              <div class="admin-pending-card-name">{{ p.buyerName }}</div>
              <div class="admin-pending-card-offer">
                <i class="ti ti-tag"></i> {{ p.offer.title }}
              </div>
            </div>
            <div class="admin-pending-card-money">
              <div class="admin-pending-card-amount">{{ p.amountFormatted }}</div>
              <div class="admin-pending-card-time">Réservé le {{ p.createdAt|date('d/m/Y à H\\hi') }}</div>
            </div>
          </div>

          <div class="admin-pending-card-contacts">
            <span>
              <i class="ti ti-mail"></i>
              <a href="mailto:{{ p.buyerEmail }}">{{ p.buyerEmail }}</a>
            </span>
            {% if p.buyerPhone %}
              <span>
                <i class="ti ti-phone"></i>
                <a href="tel:{{ p.buyerPhone|replace({' ': '', '.': '', '-': ''}) }}">{{ p.buyerPhone }}</a>
              </span>
            {% endif %}
          </div>

          {% if p.offer.isUnlimitedAccess %}
            <div class="admin-callout admin-callout--danger">
              <i class="ti ti-alert-triangle"></i>
              <div>
                <strong>Accès à vie</strong> — vérifie l'identité (pièce d'identité) avant de valider.
                Après validation, le client recevra son QR et pourra activer son accès permanent.
              </div>
            </div>
          {% endif %}

          <form method="post" action="{{ path('app_admin_promo_validate_onsite', {id: p.id}) }}"
                class="admin-pending-card-actions"
                data-confirm-title="Valider le paiement de cette réservation ?"
                data-confirm-button="Oui, j'ai encaissé">
            <input type="hidden" name="_token" value="{{ csrf_token('promo_onsite_validate_' ~ p.id) }}">
            <button type="submit" name="method" value="cash"
                    class="btn btn-primary admin-pending-card-btn"
                    data-confirm="Confirme que tu as encaissé {{ p.amountFormatted }} en espèces auprès de {{ p.buyerName }} ?">
              <i class="ti ti-cash"></i> Encaissé en espèces
            </button>
            <button type="submit" name="method" value="card"
                    class="btn btn-secondary admin-pending-card-btn"
                    data-confirm="Confirme que tu as encaissé {{ p.amountFormatted }} par carte auprès de {{ p.buyerName }} ?">
              <i class="ti ti-credit-card"></i> Encaissé par carte
            </button>
          </form>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
{% endblock %}
