{% extends 'admin/base.html.twig' %}
{% import '_macros/form_dropdown.html.twig' as ui %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-tag"></i>
        <span class="admin-title-accent">{{ title }}</span>
      </h1>
      <p class="admin-subtitle">Le lien généré peut être collé en story, publicité ou bio Instagram.</p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_promo_offers') }}" class="admin-back-link">
        <i class="ti ti-arrow-left"></i> Retour
      </a>
    </div>
  </div>

  <form method="post" class="form-card admin-form-card admin-form-grid-2col">
    <div class="admin-form-grid-2col-inner">

      {# ── Colonne gauche : Info principale ────────────────────────────── #}
      <div class="admin-form-col">
        <div class="form-group">
          <label>Titre</label>
          <input name="title" value="{{ offer.title }}" required maxlength="140" class="form-control" placeholder="Ex : Pilates Reformer — Vague 1">
        </div>
        <div class="form-group">
          <label>Slug URL</label>
          <input name="slug" value="{{ offer.slug }}" maxlength="160" class="form-control" placeholder="laisse vide pour générer automatiquement">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="10" class="form-control" placeholder="Texte affiché sur la page publique et dans Stripe Checkout">{{ offer.description }}</textarea>
        </div>
      </div>

      {# ── Colonne droite : Paramètres ────────────────────────────────── #}
      <div class="admin-form-col">
        <div class="admin-form-subgrid-2">
          <div class="form-group">
            <label>Type</label>
            {{ ui.nativeSelect(
              'promo_type',
              'type',
              '',
              {'session':'Séance','event':'Événement','pilates':'Pilates','hyrox':'Hyrox','crossfit':'CrossFit','subscription':'Abonnement'},
              offer.type
            ) }}
          </div>
          <div class="form-group">
            <label>Prix (€)</label>
            <input name="price" value="{{ offer.price }}" required inputmode="decimal" class="form-control">
          </div>
          <div class="form-group">
            <label>Places max</label>
            <input name="max_quantity" value="{{ offer.maxQuantity }}" type="number" min="1" class="form-control" placeholder="illimité">
          </div>
          <div class="form-group">
            <label>Statut</label>
            {{ ui.nativeSelect(
              'promo_status',
              'status',
              '',
              {'draft': 'Brouillon', 'active': 'Actif', 'archived': 'Archivé'},
              offer.status
            ) }}
          </div>
        </div>
        <div class="admin-form-subgrid-2">
          <div class="form-group">
            <label>Début visibilité</label>
            <input name="starts_at" value="{{ offer.startsAt ? offer.startsAt|date('Y-m-d\\TH:i') : '' }}" type="datetime-local" class="form-control">
          </div>
          <div class="form-group">
            <label>Fin visibilité</label>
            <input name="ends_at" value="{{ offer.endsAt ? offer.endsAt|date('Y-m-d\\TH:i') : '' }}" type="datetime-local" class="form-control">
          </div>
        </div>

        {# Accès illimité type BlackCard #}
        <label class="admin-form-toggle admin-form-toggle--gold">
          <input type="checkbox" name="is_unlimited_access" value="1" {{ offer.isUnlimitedAccess ? 'checked' : '' }} class="admin-form-toggle-input">
          <div class="admin-form-toggle-body">
            <div class="admin-form-toggle-title">
              <i class="ti ti-infinity"></i> Accès illimité (à vie)
            </div>
            <div class="admin-form-toggle-desc">
              Pour les offres type BlackCard : 1 scan à l'accueil pour activer, puis le client entre librement au club à vie.
              Le coach est prévenu au moment du scan que l'action est irréversible.
            </div>
          </div>
        </label>

        {# Autoriser paiement au club en plus de Stripe #}
        <label class="admin-form-toggle admin-form-toggle--green">
          <input type="checkbox" name="allows_onsite_payment" value="1" {{ offer.allowsOnSitePayment ? 'checked' : '' }} class="admin-form-toggle-input">
          <div class="admin-form-toggle-body">
            <div class="admin-form-toggle-title">
              <i class="ti ti-cash"></i> Autoriser paiement au club (espèces / CB)
            </div>
            <div class="admin-form-toggle-desc">
              Ajoute un 2ᵉ bouton "Réserver, je paye au club" à côté du paiement Stripe. Le client réserve, tu valides à sa venue, il reçoit son QR par email. Économise les frais Stripe (2.9%) sur les grosses offres.
            </div>
          </div>
        </label>
      </div>

    </div>

    <button class="btn btn-primary btn-lg admin-form-submit-inline" type="submit">
      <i class="ti ti-device-floppy"></i> Enregistrer l'offre
    </button>
  </form>

  {% if offer.id %}
    <div id="achats-checkins" class="admin-table-card admin-table-card--anchor">
      <div class="admin-table-header">
        <h3>Achats & check-ins</h3>
        <p class="admin-subtitle admin-subtitle--tight">Cette liste se met à jour après le scan du QR par le coach.</p>
      </div>

      {% if offer.purchases is empty %}
        <div class="admin-empty">
          <i class="ti ti-shopping-cart-off"></i>
          <div class="admin-empty-sub">Aucun achat pour cette offre.</div>
        </div>
      {% else %}
        <table class="admin-table">
          <thead>
            <tr>
              <th>Référence</th>
              <th>Client</th>
              <th>Paiement</th>
              <th>Check-in</th>
            </tr>
          </thead>
          <tbody>
            {% for purchase in offer.purchases %}
              <tr>
                <td data-label="Référence" class="admin-cell-ref">{{ purchase.reference }}</td>
                <td data-label="Client">
                  <strong class="admin-cell-strong">{{ purchase.buyerName }}</strong>
                  <div class="admin-cell-sub admin-cell-sub--email">{{ purchase.buyerEmail }}</div>
                </td>
                <td data-label="Paiement">
                  <span class="status-badge {{ purchase.paid ? 'confirmed' : 'pending' }}">{{ purchase.paid ? 'Payé' : 'En attente' }}</span>
                  <div class="admin-cell-sub admin-cell-sub--spaced">{{ purchase.paidAt ? purchase.paidAt|date('d/m/Y H:i') : '—' }}</div>
                </td>
                <td data-label="Check-in">
                  {% if purchase.checkedIn %}
                    <span class="status-badge confirmed">Validé</span>
                    <div class="admin-cell-sub admin-cell-sub--spaced">
                      {{ purchase.checkinAt|date('d/m/Y H:i') }}{% if purchase.checkinBy %} · {{ purchase.checkinBy.nomComplet }}{% endif %}
                    </div>
                  {% else %}
                    <span class="status-badge pending">Pas encore scanné</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  {% endif %}

</div>
{% endblock %}
