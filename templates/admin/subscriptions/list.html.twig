{% extends 'admin/base.html.twig' %}
{% import '_macros/admin_dropdown.html.twig' as adm %}

{% block title %}Abonnements actifs — Admin SPORT+{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-credit-card"></i>
        <span>Abonnements <span class="admin-title-accent">actifs</span></span>
      </h1>
      <p class="admin-subtitle">
        Packs mensuels en cours — {{ subscriptions|length }} abonnement{{ subscriptions|length != 1 ? 's' : '' }} affiché{{ subscriptions|length != 1 ? 's' : '' }}.
      </p>
    </div>
    <div class="admin-page-header-tools">
      <a href="{{ path('app_admin_export_subscriptions') }}" class="admin-btn-export" title="Export CSV">
        <i class="ti ti-file-download"></i> Export CSV
      </a>
    </div>
  </div>

  <div class="admin-filterbar">
    <div class="admin-filterbar-filters">
      {% set expiringCurrent = filterExpiring ? '1' : null %}
      {{ adm.filterDropdown('app_admin_subscriptions', 'expiring', 'État', expiringCurrent, [
        {value: null, label: 'Tous', icon: 'ti-adjustments-horizontal'},
        {value: '1',  label: 'Expire bientôt', icon: 'ti-alert-triangle'},
      ]) }}
      {{ adm.filterDropdown('app_admin_subscriptions', 'pack', 'Pack', filterPack, [
        {value: null,      label: 'Tous les packs',                 icon: 'ti-list'},
        {value: 'pack_4',  label: 'Pack 4 (' ~ (stats.byPack.pack_4 ?? 0) ~ ')',   icon: 'ti-package'},
        {value: 'pack_8',  label: 'Pack 8 (' ~ (stats.byPack.pack_8 ?? 0) ~ ')',   icon: 'ti-package'},
        {value: 'pack_12', label: 'Pack 12 (' ~ (stats.byPack.pack_12 ?? 0) ~ ')', icon: 'ti-package'},
      ]) }}
    </div>
  </div>

  {% if filterExpiring %}
    <div style="margin-bottom:20px;padding:12px 16px;background:rgba(255,180,80,.08);border:1px solid rgba(255,180,80,.28);border-left:3px solid #ffb450;border-radius:10px;font-size:13px;color:var(--text-soft);">
      <i class="ti ti-alert-triangle" style="color:#ffb450;"></i>
      Affichage des abonnements expirant dans les 7 prochains jours.
    </div>
  {% endif %}

  {% if subscriptions is empty %}
    <div class="admin-empty">
      <i class="ti ti-credit-card-off"></i>
      <div class="admin-empty-title">
        Aucun abonnement
        {%- if filterExpiring %} expirant prochainement{% elseif filterPack %} pour ce pack{% endif %}
      </div>
      <div class="admin-empty-sub">Change de filtre pour voir d'autres abonnements.</div>
    </div>
  {% else %}
    <div class="admin-table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Réf.</th>
            <th>Client</th>
            <th>Coach</th>
            <th>Format</th>
            <th>Créneau</th>
            <th>Pack</th>
            <th class="admin-align-center">Séances restantes</th>
            <th class="admin-align-right">Prix / mois</th>
            <th>Expire le</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          {% for sub in subscriptions %}
            {% set daysLeft = ((sub.endsAt.timestamp - 'now'|date('U'))|abs / 86400)|round(0, 'ceil') %}
            {% set isExpiringSoon = sub.endsAt.timestamp < ('now'|date('U') + 7 * 86400) %}
            <tr {% if isExpiringSoon %}style="background:rgba(255,180,80,.04);"{% endif %}>
              <td data-label="Réf." class="admin-cell-ref">{{ sub.reference }}</td>
              <td data-label="Client" class="admin-cell-primary">
                {{ sub.client.nomComplet }}
                {% if sub.client.isFoundingMember %}
                  <span class="admin-founding-pill" title="Membre Fondateur — -5% appliqué"><i class="ti ti-crown"></i> Fondateur</span>
                {% endif %}
              </td>
              <td data-label="Coach" class="admin-cell-date">{{ sub.coach ? sub.coach.nomComplet : '—' }}</td>
              <td data-label="Format">{{ sub.format.label }}</td>
              <td data-label="Créneau" style="font-size:13px;">{{ sub.timeSlot.label }}</td>
              <td data-label="Pack">
                <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:13px;letter-spacing:1px;">
                  {{ sub.packType.label }}
                </span>
              </td>
              <td data-label="Séances restantes" class="admin-align-center">
                <span style="font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:800;color:var(--gold);">{{ sub.sessionsRemaining }}</span>
                <span style="color:var(--text-dim);"> / {{ sub.packType.sessionsCount }}</span>
              </td>
              <td data-label="Prix / mois" class="admin-cell-num admin-cell-num--gold">
                {{ sub.monthlyPrice|number_format(2, ',', ' ') }} €
              </td>
              <td data-label="Expire le" {% if isExpiringSoon %}style="color:#ffb450;font-weight:600;"{% else %}class="admin-cell-date"{% endif %}>
                {{ sub.endsAt|date('d/m/Y') }}
                {% if isExpiringSoon %}<i class="ti ti-alert-triangle"></i>{% endif %}
              </td>
              <td data-label="Statut">
                {% set subBadge = {
                  'active':    'admin-badge--ok',
                  'expired':   'admin-badge--neutral',
                  'cancelled': 'admin-badge--danger',
                } %}
                <span class="admin-badge {{ subBadge[sub.status] ?? 'admin-badge--neutral' }}">
                  {{ sub.status }}
                </span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>
{% endblock %}
