{% extends 'admin/base.html.twig' %}
{% block title %}Admin · Abonnements — SPORT+{% endblock %}
{% block admin_body %}
<div class="admin-header"><h1>Abonnements</h1><a class="action-btn" href="{{ path('app_admin_export_subscriptions') }}">Télécharger CSV</a></div>
<div class="filter-row"><a class="btn-filter {{ not expiringOnly and not currentPack ? 'active' : '' }}" href="{{ path('app_admin_subscriptions') }}">Tous</a><a class="btn-filter {{ expiringOnly ? 'active' : '' }}" href="{{ path('app_admin_subscriptions', {expiring: 1}) }}">Expire bientôt</a>{% for pack in packs %}<a class="btn-filter {{ currentPack == pack.value ? 'active' : '' }}" href="{{ path('app_admin_subscriptions', {pack: pack.value}) }}">{{ pack.label }}</a>{% endfor %}</div>
<section class="admin-stat-grid"><article class="stat-card"><span class="stat-card-label">Actifs</span><span class="stat-card-num">{{ stats.active }}</span></article><article class="stat-card stat-card--green"><span class="stat-card-label">MRR</span><span class="stat-card-num">{{ stats.monthlyRecurring|number_format(2, ',', ' ') }} €</span></article></section>
<section class="data-card"><table class="admin-table"><thead><tr><th>Réf</th><th>Client</th><th>Coach</th><th>Format</th><th>Créneau</th><th>Pack</th><th>Séances</th><th>Expire le</th><th>Statut</th></tr></thead><tbody>{% for sub in subscriptions %}<tr><td>{{ sub.reference }}</td><td>{{ sub.client.nomComplet }}</td><td>{{ sub.coach.nomComplet }}</td><td>{{ sub.format.label }}</td><td>{{ sub.timeSlot.label }}</td><td>{{ sub.packType.label }}</td><td>{{ sub.sessionsRemaining }}</td><td>{{ sub.endsAt|date('d/m/Y') }}</td><td>{{ sub.status }}</td></tr>{% else %}<tr><td colspan="9">Aucun abonnement actif.</td></tr>{% endfor %}</tbody></table></section>
{% endblock %}
