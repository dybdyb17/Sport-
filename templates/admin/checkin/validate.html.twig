{% extends 'admin/base.html.twig' %}

{% block admin_body %}
<div class="page-header">
  <div>
    <h1><i class="ti ti-qrcode" style="color:var(--gold);"></i> Validation check-in</h1>
    <p class="page-subtitle">Vérifie les détails et valide l'arrivée du client.</p>
  </div>
</div>

<div class="form-card" style="max-width:560px;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span>
    <span style="font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:2px;color:var(--text-dim);">{{ booking.reference }}</span>
  </div>

  <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--white);margin-bottom:6px;">
    {{ booking.client.nomComplet }}
  </div>
  <div style="font-size:13px;color:var(--text-dim);margin-bottom:20px;">{{ booking.client.email }}</div>

  <div style="background:rgba(0,0,0,.25);border:1px solid var(--border);border-radius:var(--radius);padding:4px 16px;margin-bottom:20px;">
    <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
      <span style="color:var(--text-dim);font-size:13px;">Coach</span>
      <span style="color:var(--white);font-weight:600;">{{ booking.coach.nomComplet }}</span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
      <span style="color:var(--text-dim);font-size:13px;">Date</span>
      <span style="color:var(--white);font-weight:600;">{{ booking.startAt|date('d/m/Y \\à H\\hi') }}</span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
      <span style="color:var(--text-dim);font-size:13px;">Format</span>
      <span style="color:var(--white);font-weight:600;">{{ booking.offerLabel }}</span>
    </div>
    <div style="display:flex;justify-content:space-between;padding:12px 0;">
      <span style="color:var(--text-dim);font-size:13px;">Montant</span>
      <span style="color:var(--gold);font-weight:800;font-family:'Barlow Condensed',sans-serif;font-size:20px;">{{ booking.prixFormatted }}</span>
    </div>
  </div>

  {% if booking.checkinAt %}
    <div style="background:rgba(46,204,113,.1);border:1px solid rgba(46,204,113,.3);border-radius:var(--radius);padding:16px;text-align:center;">
      <i class="ti ti-check" style="color:var(--green);font-size:24px;"></i>
      <div style="font-weight:700;color:var(--green);margin-top:6px;">
        Déjà validé le {{ booking.checkinAt|date('d/m/Y \\à H\\hi') }}
      </div>
      {% if booking.checkinBy %}
        <div style="font-size:13px;color:var(--text-dim);margin-top:4px;">par {{ booking.checkinBy.nomComplet }}</div>
      {% endif %}
    </div>
  {% else %}
    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('checkin_' ~ booking.reference) }}">
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;font-size:16px;padding:16px;">
        <i class="ti ti-check"></i> Valider l'arrivée du client
      </button>
    </form>
  {% endif %}
</div>
{% endblock %}
