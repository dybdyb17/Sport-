{% extends 'base.html.twig' %}

{% block title %}Validation check-in — {{ booking.reference }} — SPORT+{% endblock %}

{% block body %}
<div class="container" style="padding-top:32px;padding-bottom:80px;max-width:620px;">

  {# Retour adapté au rôle : coach → dashboard coach, admin → checkins admin #}
  {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-ghost btn-sm" style="margin-bottom:20px;">
      <i class="ti ti-arrow-left"></i> Dashboard admin
    </a>
  {% else %}
    <a href="{{ path('app_coach_dashboard') }}" class="btn btn-ghost btn-sm" style="margin-bottom:20px;">
      <i class="ti ti-arrow-left"></i> Mon dashboard
    </a>
  {% endif %}

  <div class="page-header" style="margin-bottom:24px;">
    <div>
      <h1><i class="ti ti-qrcode" style="color:var(--gold);"></i> Validation check-in</h1>
      <p class="page-subtitle">Vérifie les détails et valide l'arrivée du client.</p>
    </div>
  </div>

  <div class="form-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
      <span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span>
      <span style="font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:2px;color:var(--text-dim);">{{ booking.reference }}</span>
    </div>

    <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--white);margin-bottom:6px;">
      {{ booking.client.nomComplet }}
    </div>
    <div style="font-size:13px;color:var(--text-dim);margin-bottom:6px;">{{ booking.client.email }}</div>
    {% if booking.client.phone %}
      <div style="margin-bottom:20px;">
        <a href="tel:{{ booking.client.phone|replace({' ': '', '.': '', '-': ''}) }}"
           style="display:inline-flex;align-items:center;gap:5px;font-size:13px;color:var(--green);text-decoration:none;font-family:ui-monospace,'SF Mono',Menlo,monospace;">
          <i class="ti ti-phone"></i> {{ booking.client.phone }}
        </a>
      </div>
    {% endif %}

    <div style="background:rgba(0,0,0,.25);border:1px solid var(--border);border-radius:var(--radius);padding:4px 16px;margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
        <span style="color:var(--text-dim);font-size:13px;">Coach</span>
        <span style="color:var(--white);font-weight:600;">{{ booking.coach.nomComplet }}</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
        <span style="color:var(--text-dim);font-size:13px;">Date</span>
        <span style="color:var(--white);font-weight:600;">{{ booking.startAt|date('d/m/Y \\à H\\hi') }}</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);">
        <span style="color:var(--text-dim);font-size:13px;">Format</span>
        <span style="color:var(--white);font-weight:600;">{{ booking.offerLabel }}</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:12px 0;">
        <span style="color:var(--text-dim);font-size:13px;">Montant</span>
        <span style="color:var(--gold);font-weight:800;font-family:'Barlow Condensed',sans-serif;font-size:20px;">{{ booking.prixFormatted }}</span>
      </div>
    </div>

    {# ─── ARRIVÉE ────────────────────────────────────────────────── #}
    <div class="checkin-section-title">
      <i class="ti ti-user-check"></i> Arrivée du client
    </div>
    {% if booking.checkinAt %}
      <div class="checkin-arrived">
        <i class="ti ti-check checkin-arrived-icon"></i>
        <div class="checkin-arrived-text">
          <div class="checkin-arrived-title">
            Validé le {{ booking.checkinAt|date('d/m/Y \\à H\\hi') }}
          </div>
          {% if booking.checkinBy %}
            <div class="checkin-arrived-sub">par {{ booking.checkinBy.nomComplet }}</div>
          {% endif %}
        </div>
      </div>
    {% else %}
      <form method="post" action="{{ path('app_admin_checkin_validate', {reference: booking.reference}) }}" class="checkin-arrival-form">
        <input type="hidden" name="_token" value="{{ csrf_token('checkin_' ~ booking.reference) }}">
        <button type="submit" class="checkin-btn checkin-btn--primary">
          <i class="ti ti-check"></i> Valider l'arrivée du client
        </button>
      </form>
    {% endif %}

    {# ─── PAIEMENT ──────────────────────────────────────────────────
       3 états selon la séance :
        1. Réglé (paymentMethod posé) → badge, pas de bouton
        2. Couverte par pack/founding → badge "Rien à encaisser"
        3. À encaisser → montant + 2 boutons cash/card
       Cas limite : intent=stripe non encore payé → info "en attente" +
       possibilité de basculer en encaissement sur place (le client peut
       changer d'avis au dernier moment). #}
    {% set methodLabels = {
      'cash':   'espèces',
      'card':   'carte bancaire',
      'stripe': 'en ligne (Stripe)',
    } %}

    <div class="checkin-section-title" style="margin-top:24px;">
      <i class="ti ti-cash"></i> Paiement
    </div>

    {% if booking.paymentMethod %}
      {# ── État 1 : déjà réglé ── #}
      <div class="checkin-paid">
        <i class="ti ti-check checkin-arrived-icon"></i>
        <div class="checkin-arrived-text">
          <div class="checkin-arrived-title">
            Réglé — {{ methodLabels[booking.paymentMethod] ?? booking.paymentMethod }}
          </div>
          {% if booking.paymentDeclaredAt %}
            <div class="checkin-arrived-sub">
              Enregistré le {{ booking.paymentDeclaredAt|date('d/m/Y \\à H\\hi') }}
              {%- if booking.paymentDeclaredBy -%}
                {{ ' ' }}· par {{ booking.paymentDeclaredBy.nomComplet }}
              {%- endif -%}
            </div>
          {% endif %}
        </div>
      </div>
    {% elseif booking.coveredBy == 'founding' %}
      {# ── État 2a : offre Fondateur ── #}
      <div class="checkin-covered">
        <i class="ti ti-crown"></i>
        <div>
          <strong>Offre Fondateur</strong>
          <div class="checkin-covered-sub">Rien à encaisser — séance déjà couverte.</div>
        </div>
      </div>
    {% elseif booking.coveredBy == 'subscription' and booking.subscription %}
      {# ── État 2b : couverte par un pack ── #}
      <div class="checkin-covered">
        <i class="ti ti-package"></i>
        <div>
          <strong>Couverte par son pack</strong>
          <div class="checkin-covered-sub">
            {{ booking.subscription.packType.label }} — rien à encaisser.
          </div>
        </div>
      </div>
    {% else %}
      {# ── État 3 : à encaisser ── #}
      {% if booking.intendedPaymentMethod == 'stripe' %}
        <div class="checkin-stripe-pending">
          <i class="ti ti-clock"></i>
          <div>
            <strong>Paiement en ligne annoncé (non reçu)</strong>
            <div class="checkin-covered-sub">
              Le client peut aussi régler sur place — les deux boutons ci-dessous sont disponibles.
            </div>
          </div>
        </div>
      {% endif %}

      <div class="checkin-amount">
        À encaisser :
        <strong>{{ booking.prixFormatted }}</strong>
      </div>

      <form method="post" action="{{ path('app_admin_checkin_declare_payment', {reference: booking.reference}) }}" class="checkin-pay-form"
            data-confirm-title="Confirme l'encaissement"
            data-confirm-button="Oui, j'ai encaissé">
        <input type="hidden" name="_token" value="{{ csrf_token('checkin_pay_' ~ booking.reference) }}">
        <button type="submit" name="method" value="cash" class="checkin-btn checkin-btn--cash"
                data-confirm="Confirme que tu as bien encaissé {{ booking.prixFormatted }} en espèces auprès de {{ booking.client.nomComplet }} ?">
          <i class="ti ti-cash"></i> Encaissé en espèces
        </button>
        <button type="submit" name="method" value="card" class="checkin-btn checkin-btn--card"
                data-confirm="Confirme que tu as bien encaissé {{ booking.prixFormatted }} par carte auprès de {{ booking.client.nomComplet }} ?">
          <i class="ti ti-credit-card"></i> Encaissé par carte
        </button>
      </form>
    {% endif %}
  </div>
</div>
{% endblock %}
