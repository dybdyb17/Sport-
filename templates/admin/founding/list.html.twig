{% extends 'admin/base.html.twig' %}
{% block title %}Admin · Fondateurs — SPORT+{% endblock %}
{% block admin_body %}
<div class="admin-header"><h1>Fondateurs</h1><div class="admin-toolbar"><a class="action-btn" href="{{ path('app_admin_export_founding') }}">Télécharger CSV</a>{% if offer %}<form method="post" action="{{ path('app_admin_founding_toggle') }}"><input type="hidden" name="_token" value="{{ csrf_token('founding_toggle' ~ offer.id) }}"><button class="action-btn" type="submit">{{ offer.active ? 'Désactiver' : 'Activer' }} l'offre</button></form>{% endif %}</div></div>
<section class="admin-stat-grid"><article class="stat-card"><span class="stat-card-label">Places prises</span><span class="stat-card-num">{{ stats.total }}</span></article><article class="stat-card"><span class="stat-card-label">Places restantes</span><span class="stat-card-num">{{ offer ? offer.placesRemaining : 0 }}</span></article><article class="stat-card stat-card--green"><span class="stat-card-label">Bilans effectués</span><span class="stat-card-num">{{ stats.bilanDone }}</span></article><article class="stat-card stat-card--gold"><span class="stat-card-label">Séances consommées</span><span class="stat-card-num">{{ stats.sessionsConsumed }} / {{ stats.sessionsTotal }}</span></article></section>
<section class="data-card"><table class="admin-table"><thead><tr><th>N°</th><th>Client</th><th>Email</th><th>Inscrit le</th><th>Séances</th><th>Bilan</th><th>Action</th></tr></thead><tbody>{% for claim in claims %}<tr><td>#{{ claim.claimNumber }}</td><td>{{ claim.user.nomComplet }}</td><td>{{ claim.user.email }}</td><td>{{ claim.createdAt|date('d/m/Y') }}</td><td>{{ claim.sessionsUsed }}/3</td><td><span class="status-badge {{ claim.bilanDone ? 'confirmed' : 'pending' }}">{{ claim.bilanDone ? 'Effectué' : 'À programmer' }}</span></td><td>{% if not claim.bilanDone %}<form method="post" action="{{ path('app_admin_founding_bilan_done', {id: claim.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('founding_bilan' ~ claim.id) }}"><button class="action-btn" type="submit">Marquer effectué</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7">Aucun fondateur.</td></tr>{% endfor %}</tbody></table></section>
{% endblock %}
