{% extends 'admin/base.html.twig' %}
{% import '_macros/admin_dropdown.html.twig' as adm %}

{% block title %}Journal d'audit — SPORT+ Admin{% endblock %}

{% block admin_body %}
<div class="admin-page">

  <div class="admin-page-header">
    <div class="admin-page-header-body">
      <h1 class="admin-title">
        <i class="ti ti-shield-lock"></i>
        <span>Journal d'<span class="admin-title-accent">audit</span></span>
      </h1>
      <p class="admin-subtitle">
        Historique infalsifiable des actions sensibles (paiements, absences, modifs admin, confirmations client).
        Les 200 entrées les plus récentes selon les filtres.
      </p>
    </div>
  </div>

  {# ── Filtres ────────────────────────────────────────────────────
     2 dropdowns (Action + Rôle) qui naviguent par URL, + 1 mini-form
     GET pour les dates qui conserve les params action/role via hidden.
     Séparés parce que ui-dropdown navigue en <a href>, pas en submit. #}
  <div class="admin-filterbar">
    <div class="admin-filterbar-filters">
      {# Action : {value, label} pour chaque AuditAction case. Le "null" =
         "Toutes les actions" retire complètement le param. #}
      {% set actionOptions = [{value: null, label: 'Toutes les actions', icon: 'ti-list'}] %}
      {% for a in actions %}
        {% set actionOptions = actionOptions|merge([{
          value: a.value,
          label: a.label,
          icon:  a.icon,
        }]) %}
      {% endfor %}
      {{ adm.filterDropdown('app_admin_audit', 'action', 'Action', actionFilter ? actionFilter.value : null, actionOptions) }}

      {{ adm.filterDropdown('app_admin_audit', 'role', 'Rôle acteur', roleFilter, [
        {value: null,     label: 'Tous les rôles', icon: 'ti-users'},
        {value: 'admin',  label: 'Admin',          icon: 'ti-shield'},
        {value: 'coach',  label: 'Coach',          icon: 'ti-whistle'},
        {value: 'client', label: 'Client',         icon: 'ti-user'},
        {value: 'system', label: 'Système',        icon: 'ti-terminal-2'},
      ]) }}

      {# Mini-form dates : préserve action + role en hidden pour ne pas les
         perdre au submit du calendrier. #}
      <form method="get" action="{{ path('app_admin_audit') }}"
            style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        {% if actionFilter %}<input type="hidden" name="action" value="{{ actionFilter.value }}">{% endif %}
        {% if roleFilter %}<input type="hidden" name="role" value="{{ roleFilter }}">{% endif %}
        <label style="display:flex;flex-direction:column;gap:3px;font-size:11px;font-family:'Barlow Condensed',sans-serif;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);">
          Du
          <input type="date" name="from" value="{{ fromFilter }}"
                 style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:8px 10px;color:var(--white);font-size:13px;min-height:42px;">
        </label>
        <label style="display:flex;flex-direction:column;gap:3px;font-size:11px;font-family:'Barlow Condensed',sans-serif;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);">
          Au
          <input type="date" name="to" value="{{ toFilter }}"
                 style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:8px 10px;color:var(--white);font-size:13px;min-height:42px;">
        </label>
        <button type="submit" class="admin-btn-pill" style="align-self:flex-end;">
          <i class="ti ti-filter"></i> Filtrer dates
        </button>
      </form>
    </div>
    <a href="{{ path('app_admin_audit') }}" class="admin-btn-pill admin-btn-pill--danger" title="Réinitialiser tous les filtres">
      <i class="ti ti-refresh"></i> Reset
    </a>
  </div>

  {# ── Table ────────────────────────────────────────────────────── #}
  {% if logs is empty %}
    <div class="admin-empty">
      <i class="ti ti-database-off"></i>
      <div class="admin-empty-title">Aucune action journalisée avec ces filtres</div>
      <div class="admin-empty-sub">Change de filtre ou reset pour voir plus d'entrées.</div>
    </div>
  {% else %}
    <div class="admin-table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Quand</th>
            <th>Action</th>
            <th>Acteur</th>
            <th>Cible</th>
            <th>Détails</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          {% for log in logs %}
            {% set actionColor = log.action.color %}
            <tr style="border-left:3px solid {{ actionColor }};background:linear-gradient(90deg, color-mix(in srgb, {{ actionColor }} 7%, transparent), transparent 48%);">
              <td data-label="Quand" style="white-space:nowrap;color:var(--text-dim);font-size:13px;">
                <div>{{ log.createdAt|date('d/m/Y') }}</div>
                <div style="font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:11px;">{{ log.createdAt|date('H:i:s') }}</div>
              </td>
              <td data-label="Action">
                <span style="display:inline-flex;align-items:center;gap:8px;font-weight:700;color:{{ actionColor }};">
                  <i class="ti {{ log.action.icon }}" style="font-size:18px;"></i>
                  {{ log.action.label }}
                </span>
              </td>
              <td data-label="Acteur">
                <div class="admin-cell-primary">{{ log.actorLabel ?? '—' }}</div>
                <div class="admin-cell-sub" style="text-transform:uppercase;letter-spacing:1px;">{{ log.actorRole }}</div>
              </td>
              <td data-label="Cible">
                {% if log.targetType %}
                  <div class="admin-cell-sub">{{ log.targetType }}</div>
                  <div style="font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:12px;color:var(--gold);">{{ log.targetLabel ?? ('#' ~ log.targetId) }}</div>
                {% else %}
                  <span style="color:var(--text-dim);">—</span>
                {% endif %}
              </td>
              <td data-label="Détails" style="min-width:260px;">
                {% if log.details is not empty %}
                  {% set detailLabels = {
                    'note': 'Note',
                    'amount': 'Montant',
                    'client': 'Client',
                    'method': 'Mode de paiement',
                    'source': 'Origine',
                    'startAt': 'Créneau',
                    'reason': 'Motif',
                    'oldRole': 'Ancien rôle',
                    'newRole': 'Nouveau rôle',
                    'previous': 'Avant',
                    'new': 'Après'
                  } %}
                  {% set methodLabels = {'cash': 'Espèces', 'card': 'Carte bancaire', 'stripe': 'Stripe', 'transfer': 'Virement'} %}
                  {% set sourceLabels = {'checkin_scan': 'Scan QR coach', 'client_confirmation': 'Confirmation client', 'admin': 'Admin', 'system': 'Système'} %}
                  <details>
                    <summary style="cursor:pointer;color:var(--gold);font-size:12px;font-weight:800;font-family:'Barlow Condensed',sans-serif;letter-spacing:1.2px;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;">
                      <i class="ti ti-list-details"></i> Voir détails
                    </summary>
                    <div style="margin-top:10px;display:grid;gap:8px;min-width:260px;max-width:420px;">
                      {% for key, value in log.details %}
                        <div style="display:grid;grid-template-columns:minmax(95px, .65fr) 1fr;gap:10px;align-items:start;padding:9px 10px;background:rgba(0,0,0,.22);border:1px solid var(--border);border-radius:10px;">
                          <div style="font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;">{{ detailLabels[key] ?? key }}</div>
                          <div style="font-size:13px;color:var(--text-soft);font-weight:600;overflow-wrap:anywhere;">
                            {% if value is same as(null) or value is same as('') %}
                              <span style="color:var(--text-dim);">Non renseigné</span>
                            {% elseif key == 'amount' %}
                              <span style="color:var(--gold);">{{ value|number_format(2, ',', ' ') }} €</span>
                            {% elseif key == 'method' %}
                              {{ methodLabels[value] ?? value }}
                            {% elseif key == 'source' %}
                              {{ sourceLabels[value] ?? value }}
                            {% elseif key in ['startAt', 'createdAt', 'paidAt'] %}
                              {{ value|date('d/m/Y à H\\hi') }}
                            {% elseif value is iterable %}
                              <code style="display:block;white-space:pre-wrap;font-size:11px;line-height:1.5;color:var(--text-soft);">{{ value|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</code>
                            {% else %}
                              {{ value }}
                            {% endif %}
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </details>
                {% else %}
                  <span style="color:var(--text-dim);">—</span>
                {% endif %}
              </td>
              <td data-label="IP" style="font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:11px;color:var(--text-dim);">
                {{ log.ipAddress ?? '—' }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>
{% endblock %}
