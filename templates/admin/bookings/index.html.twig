{% extends 'admin/base.html.twig' %}

{% block title %}Réservations — Admin SPORT+{% endblock %}

{% block admin_body %}

<div class="page-header">
  <div>
    <h1><span style="color:var(--gold)">Réservations</span></h1>
    <p class="page-subtitle">{{ bookings|length }} réservation{% if bookings|length > 1 %}s{% endif %}{% if activeStatus %} — filtre : {{ activeStatus }}{% endif %}</p>
  </div>
</div>

<div class="filter-bar">
  <a href="{{ path('app_admin_bookings') }}"
     class="btn btn-sm {{ activeStatus is null ? 'btn-primary' : 'btn-secondary' }}">
    Toutes
  </a>
  <a href="{{ path('app_admin_bookings', {status: 'pending'}) }}"
     class="btn btn-sm {{ activeStatus == 'pending' ? 'btn-primary' : 'btn-secondary' }}">
    En attente
  </a>
  <a href="{{ path('app_admin_bookings', {status: 'confirmed'}) }}"
     class="btn btn-sm {{ activeStatus == 'confirmed' ? 'btn-primary' : 'btn-secondary' }}">
    Confirmées
  </a>
  <a href="{{ path('app_admin_bookings', {status: 'refused'}) }}"
     class="btn btn-sm {{ activeStatus == 'refused' ? 'btn-primary' : 'btn-secondary' }}">
    Refusées
  </a>
  <a href="{{ path('app_admin_bookings', {status: 'cancelled'}) }}"
     class="btn btn-sm {{ activeStatus == 'cancelled' ? 'btn-primary' : 'btn-secondary' }}">
    Annulées
  </a>
</div>

<div class="data-table-card">
  <div class="data-table-header">
    <h3>Liste des réservations</h3>
  </div>
  {% if bookings is empty %}
    <div class="empty-placeholder" style="padding:60px;">
      Aucune réservation{% if activeStatus %} avec ce statut{% endif %}.
    </div>
  {% else %}
    <table>
      <thead>
        <tr>
          <th>Réf.</th>
          <th>Date</th>
          <th>Prestation</th>
          <th>Client</th>
          <th>Coach</th>
          <th>Statut</th>
          <th>Prix</th>
        </tr>
      </thead>
      <tbody>
        {% for booking in bookings %}
          <tr>
            <td style="font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:2px;color:var(--text-dim);">{{ booking.reference }}</td>
            <td style="color:var(--text-dim);">{{ booking.startAt|date('d/m/Y à H:i') }}</td>
            <td style="font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.offerLabel }}</td>
            <td style="color:var(--text-dim);">{{ booking.client.nomComplet }}</td>
            <td style="color:var(--text-dim);">{{ booking.coach.nomComplet }}</td>
            <td><span class="status-badge {{ booking.status }}">{{ booking.statutLabel }}</span></td>
            <td style="color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;">{{ booking.prixFormatted }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>

{% endblock %}
