{% extends 'admin/base.html.twig' %}

{% block title %}Paiements — Admin SPORT+{% endblock %}

{#
  Macro dropdown réutilisable. Génère le markup ui-dropdown avec les hrefs
  qui conservent les autres query params (marge des filtres).
  - param     : nom du query param à modifier (ex: 'method')
  - eyebrow   : label gris fin (ex: "Méthode")
  - current   : valeur actuelle du filtre (ex: 'all')
  - options   : tableau {value, label, icon}
  - align     : 'left' (défaut) ou 'right'
#}
{% macro filterDropdown(param, eyebrow, current, options, align = 'left') %}
  {% set currentLabel = 'Toutes' %}
  {% for o in options %}
    {% if o.value == current %}{% set currentLabel = o.label %}{% endif %}
  {% endfor %}
  <div class="ui-dropdown"
       data-dropdown
       {% if align == 'right' %}data-dropdown-align="right"{% endif %}>
    <button type="button" class="ui-dropdown-trigger"
            aria-haspopup="listbox" aria-expanded="false">
      <span class="ui-dropdown-eyebrow">{{ eyebrow }}</span>
      <span class="ui-dropdown-current">{{ currentLabel }}</span>
      <i class="ti ti-chevron-down ui-dropdown-caret" aria-hidden="true"></i>
    </button>
    <div class="ui-dropdown-panel" role="listbox">
      {% for o in options %}
        {% set qs = app.request.query.all|merge({(param): o.value}) %}
        <a href="{{ path('app_admin_payments', qs) }}"
           class="ui-dropdown-option{{ o.value == current ? ' is-active' : '' }}"
           data-value="{{ o.value }}"
           role="option"
           aria-selected="{{ o.value == current ? 'true' : 'false' }}">
          <i class="ti {{ o.icon|default('ti-point') }} ui-dropdown-option-icon" aria-hidden="true"></i>
          <span class="ui-dropdown-option-label">{{ o.label }}</span>
          <i class="ti ti-check ui-dropdown-option-check" aria-hidden="true"></i>
        </a>
      {% endfor %}
    </div>
  </div>
{% endmacro %}

{% import _self as ui %}

{% set typeOptions = [
  {value: 'all',       label: 'Tous les types',  icon: 'ti-list'},
  {value: 'seance',    label: 'Séances',          icon: 'ti-run'},
  {value: 'pack',      label: 'Packs',            icon: 'ti-calendar-stats'},
  {value: 'fondateur', label: 'Fondateur',        icon: 'ti-crown'},
] %}
{% set methodOptions = [
  {value: 'all',    label: 'Toutes',    icon: 'ti-wallet'},
  {value: 'stripe', label: 'Stripe',    icon: 'ti-lock'},
  {value: 'cash',   label: 'Espèces',   icon: 'ti-cash'},
  {value: 'card',   label: 'CB',        icon: 'ti-credit-card'},
] %}
{% set statusOptions = [
  {value: 'all',     label: 'Tout',           icon: 'ti-adjustments-horizontal'},
  {value: 'paid',    label: 'Réglés',         icon: 'ti-check'},
  {value: 'pending', label: 'À encaisser',    icon: 'ti-hourglass'},
] %}
{% set coachOptions = [{value: 'all', label: 'Tous les coachs', icon: 'ti-users'}] %}
{% for c in coachList %}
  {% set coachOptions = coachOptions|merge([{
    value: c.id,
    label: c.nomComplet ?? '—',
    icon: 'ti-user'
  }]) %}
{% endfor %}
{% set periodDropdownOptions = [] %}
{% for p in periodOptions %}
  {% set periodDropdownOptions = periodDropdownOptions|merge([{
    value: p.key,
    label: p.label,
    icon: p.key == 'current' ? 'ti-calendar-event' : (p.key == 'all' ? 'ti-history' : 'ti-calendar')
  }]) %}
{% endfor %}

{% set currentCoach = filters.coachId is null ? 'all' : filters.coachId %}

{% block admin_body %}
<div class="ap-page">

  <div class="ap-header">
    <div>
      <h1 class="ap-title">
        <i class="ti ti-cash-banknote"></i>
        <span>Paiements</span>
      </h1>
      <p class="ap-subtitle">Journal unifié des encaissements — séances, packs, offres Fondateur.</p>
    </div>
    <div class="ap-header-period">
      {{ ui.filterDropdown('period', 'Période', filters.periodKey, periodDropdownOptions, 'right') }}
    </div>
  </div>

  {# ── 4 CARTES COMPTEURS ─────────────────────────────────────────── #}
  <div class="ap-metrics">
    <div class="ap-metric">
      <div class="ap-metric-eyebrow">Total encaissé</div>
      <div class="ap-metric-value">{{ totals.total|number_format(2, ',', ' ') }} €</div>
      <div class="ap-metric-hint">Sur la période sélectionnée</div>
    </div>
    <div class="ap-metric">
      <div class="ap-metric-eyebrow"><i class="ti ti-lock"></i> En ligne (Stripe)</div>
      <div class="ap-metric-value">{{ totals.stripe|number_format(2, ',', ' ') }} €</div>
      <div class="ap-metric-hint">Paiements automatiques</div>
    </div>
    <div class="ap-metric">
      <div class="ap-metric-eyebrow"><i class="ti ti-cash"></i> Sur place</div>
      <div class="ap-metric-value">{{ totals.onSite|number_format(2, ',', ' ') }} €</div>
      <div class="ap-metric-hint">Espèces + CB déclarés</div>
    </div>
    <div class="ap-metric ap-metric--pending">
      <div class="ap-metric-eyebrow"><i class="ti ti-hourglass"></i> À encaisser</div>
      <div class="ap-metric-value">{{ totals.pending|number_format(2, ',', ' ') }} €</div>
      <div class="ap-metric-hint">Séances confirmées et packs sur place en attente</div>
    </div>
  </div>

  {# ── BARRE DE FILTRES ───────────────────────────────────────────── #}
  <div class="ap-filterbar">
    <div class="ap-filterbar-filters">
      {{ ui.filterDropdown('type',   'Type',    filters.type,   typeOptions) }}
      {{ ui.filterDropdown('method', 'Méthode', filters.method, methodOptions) }}
      {{ ui.filterDropdown('status', 'Statut',  filters.status, statusOptions) }}
      {{ ui.filterDropdown('coach',  'Coach',   currentCoach,   coachOptions) }}
    </div>
    <a href="{{ path('app_admin_payments_export', app.request.query.all) }}"
       class="ap-export-btn" title="Export CSV de la vue actuelle">
      <i class="ti ti-file-download"></i>
      <span>Export CSV</span>
    </a>
  </div>

  {# ── TABLE JOURNAL ──────────────────────────────────────────────── #}
  {% if events is empty %}
    <div class="ap-empty">
      <i class="ti ti-inbox"></i>
      <div class="ap-empty-title">Aucun paiement sur cette période</div>
      <div class="ap-empty-sub">Change de mois ou de filtre pour voir plus.</div>
    </div>
  {% else %}
    <div class="ap-journal">
      <div class="ap-journal-head">
        <div>Date</div>
        <div>Type</div>
        <div>Détail</div>
        <div>Méthode</div>
        <div class="ap-align-right">Montant</div>
      </div>
      {% for e in events %}
        {% set typeBadge = {
          'seance':    {label: 'Séance',    className: 'ap-badge--seance'},
          'pack':      {label: 'Pack',      className: 'ap-badge--pack'},
          'fondateur': {label: 'Fondateur', className: 'ap-badge--fondateur'},
        } %}
        {% set methodDisplay = {
          'stripe': {label: 'Stripe',  icon: 'ti-lock'},
          'cash':   {label: 'Espèces', icon: 'ti-cash'},
          'card':   {label: 'CB',      icon: 'ti-credit-card'},
        } %}
        <div class="ap-journal-row{{ e.pending ? ' is-pending' : '' }}">
          <div class="ap-cell ap-cell-date" data-label="Date">
            {{ e.paidAt|date('d/m H:i') }}
          </div>
          <div class="ap-cell ap-cell-type" data-label="Type">
            <span class="ap-badge {{ typeBadge[e.type].className }}">{{ typeBadge[e.type].label }}</span>
          </div>
          <div class="ap-cell ap-cell-detail" data-label="Détail">
            <div class="ap-client">{{ e.clientName }}</div>
            <div class="ap-detail">{{ e.detail }}</div>
          </div>
          <div class="ap-cell ap-cell-method" data-label="Méthode">
            {% if e.pending %}
              <span class="ap-pending-badge">
                <i class="ti ti-hourglass"></i>
                {{ e.pendingLabel|default('À encaisser') }}
              </span>
              {% if e.method and methodDisplay[e.method] %}
                <div class="ap-method-hint">
                  <i class="ti {{ methodDisplay[e.method].icon }}"></i>
                  intention : {{ methodDisplay[e.method].label }}
                </div>
              {% endif %}
            {% else %}
              {% set md = methodDisplay[e.method] %}
              <div class="ap-method">
                <i class="ti {{ md.icon }}"></i>
                <span>{{ md.label }}</span>
                {% if e.stripeUrl %}
                  <a href="{{ e.stripeUrl }}" target="_blank" rel="noopener"
                     class="ap-stripe-link" title="Voir le paiement Stripe">
                    <i class="ti ti-external-link"></i>
                  </a>
                {% endif %}
              </div>
              {% if e.canal or e.validatedBy %}
                <div class="ap-method-hint">
                  {% if e.canal %}· {{ e.canal }}{% endif %}
                  {%- if e.validatedBy %}{% if e.canal %} {% endif %}· validé {{ e.validatedBy }}{% endif -%}
                </div>
              {% endif %}
            {% endif %}
          </div>
          <div class="ap-cell ap-cell-amount ap-align-right" data-label="Montant">
            {{ e.amount|number_format(2, ',', ' ') }} €
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>

<script src="{{ asset('js/ui-dropdown.js') }}" defer></script>
{% endblock %}
