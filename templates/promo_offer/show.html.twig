{% extends 'base.html.twig' %}

{% block title %}{{ offer.title }} — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Réserve et règle en ligne l'offre {{ offer.title }} chez SPORT+ Marseille. Paiement sécurisé Stripe, QR débloqué après paiement validé.">{% endblock %}

{% block body %}
<section class="pub-hero-sober" style="padding-bottom:36px;">
  <div class="container" style="max-width:980px;">
    <div class="hero-badge">Offre SPORT+ Instagram</div>
    <h1 class="section-title">{{ offer.title }}</h1>
    <p class="section-sub">Paiement sécurisé par Stripe. Ton QR de réservation est débloqué uniquement après validation du paiement.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container" style="max-width:980px;">
    <div style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:28px;align-items:start;" class="promo-offer-grid">
      <article class="form-card" style="padding:28px;">
        <div class="section-label" style="margin-top:0;">{{ offer.type|capitalize }}</div>
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:42px;text-transform:uppercase;margin:8px 0 14px;">{{ offer.title }}</h2>
        <div style="font-family:'Barlow Condensed',sans-serif;font-size:64px;font-weight:900;color:var(--gold);line-height:1;margin-bottom:18px;">{{ offer.priceFormatted }}</div>
        {% if offer.description %}
          <p style="color:var(--text-soft);font-size:16px;line-height:1.8;white-space:pre-line;">{{ offer.description }}</p>
        {% else %}
          <p style="color:var(--text-soft);font-size:16px;line-height:1.8;">Offre limitée SPORT+ à réserver en ligne. Après paiement, conserve ton QR et présente-le à l'accueil.</p>
        {% endif %}
        {% if offer.maxQuantity %}
          <p style="margin-top:18px;color:var(--text-dim);"><i class="ti ti-ticket"></i> Places restantes : <strong style="color:var(--gold);">{{ offer.maxQuantity - offer.paidPurchasesCount }}</strong></p>
        {% endif %}
      </article>

      <aside class="form-card" style="padding:24px;position:sticky;top:96px;">
        {% if not offer.isCurrentlyAvailable %}
          <div class="alert alert-warning">Cette offre n'est plus disponible.</div>
        {% else %}
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;text-transform:uppercase;margin-bottom:8px;">Réserver maintenant</h3>
          <p style="color:var(--text-dim);font-size:14px;line-height:1.6;margin-bottom:18px;">Renseigne tes infos, puis tu seras redirigé vers Stripe. Le QR est généré après paiement validé.</p>
          <form method="post" action="{{ path('app_promo_offer_checkout', {slug: offer.slug}) }}" style="display:grid;gap:14px;">
            <input type="hidden" name="_token" value="{{ csrf_token('promo-offer-' ~ offer.id) }}">
            <div class="form-group">
              <label>Nom complet</label>
              <input name="buyer_name" required maxlength="120" class="form-control" autocomplete="name">
            </div>
            <div class="form-group">
              <label>Email</label>
              <input name="buyer_email" type="email" required maxlength="180" class="form-control" autocomplete="email">
            </div>
            <div class="form-group">
              <label>Téléphone <span style="color:var(--text-dim);font-weight:400;">optionnel</span></label>
              <input name="buyer_phone" maxlength="30" class="form-control" autocomplete="tel">
            </div>
            <button class="btn btn-primary btn-lg" type="submit" style="width:100%;">
              <i class="ti ti-brand-stripe"></i> Payer {{ offer.priceFormatted }}
            </button>
            <p style="margin:0;color:var(--text-dim);font-size:12px;text-align:center;"><i class="ti ti-lock"></i> Paiement carte sécurisé Stripe · Aucun QR sans paiement confirmé.</p>
          </form>
        {% endif %}
      </aside>
    </div>
  </div>
</section>
<style>
@media (max-width: 820px) {
  .promo-offer-grid { grid-template-columns: 1fr !important; }
  .promo-offer-grid aside { position: static !important; }
}
</style>
{% endblock %}
