{% extends 'base.html.twig' %}

{% block title %}{{ offer.title }} — SPORT+ Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Réserve et règle en ligne l'offre {{ offer.title }} chez SPORT+ Marseille. Paiement sécurisé Stripe, QR débloqué après paiement validé.">{% endblock %}

{% block body %}
<section class="pub-hero-sober" style="padding-bottom:36px;">
  <div class="container" style="max-width:980px;">
    <div class="hero-badge">Offre SPORT+ Instagram</div>
    <h1 class="section-title">{{ offer.title }}</h1>
    <p class="section-sub">Paiement sécurisé par Stripe. Ton QR de réservation est débloqué uniquement après validation du paiement.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="container" style="max-width:980px;">
    <div style="display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:28px;align-items:start;" class="promo-offer-grid">
      {# Le -5% Fondateur ne s'applique QUE si un user est connecté ET est
         fondateur — jamais basé sur un email saisi (usurpation). Le prix
         affiché reflète exactement ce qui sera figé + débité Stripe pour lui. #}
      {% set isFoundingUser = app.user and app.user.isFoundingMember %}
      {% set effectivePrice = isFoundingUser ? (offer.price|number_format(2, '.', '') * 0.95)|number_format(2, '.', '') : offer.price %}
      {% set effectivePriceLabel = (effectivePrice|number_format(2, ',', "\u{202F}")) ~ ' €' %}

      <article class="form-card" style="padding:28px;">
        <div class="section-label" style="margin-top:0;">{{ offer.type|capitalize }}</div>
        {% if offer.isUnlimitedAccess %}
          <div style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px;margin-bottom:14px;background:linear-gradient(135deg,rgba(200,169,81,.18) 0%,rgba(46,204,113,.15) 100%);border:1px solid rgba(200,169,81,.55);border-radius:100px;font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--gold);">
            <i class="ti ti-infinity" style="font-size:18px;"></i> Accès à vie
          </div>
        {% endif %}
        <h2 style="font-family:'Barlow Condensed',sans-serif;font-size:42px;text-transform:uppercase;margin:8px 0 14px;">{{ offer.title }}</h2>

        {# Bloc prix : prix effectif en grand, prix public barré à côté si
           fondateur (pattern e-commerce standard), pill "-5% Fondateur" en
           dessous. Layout flex-wrap → propre sur mobile / sidebar étroite. #}
        <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:{{ isFoundingUser ? 10 : 18 }}px;">
          <div style="font-family:'Barlow Condensed',sans-serif;font-size:64px;font-weight:900;color:var(--gold);line-height:1;">{{ effectivePriceLabel }}</div>
          {% if isFoundingUser %}
            <div style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--text-dim);text-decoration:line-through;text-decoration-thickness:2px;line-height:1;">
              {{ offer.priceFormatted }}
            </div>
          {% endif %}
        </div>
        {% if isFoundingUser %}
          <div style="display:inline-flex;align-items:center;gap:5px;margin-bottom:16px;padding:3px 10px;border-radius:100px;background:rgba(200,169,81,.14);border:1px solid rgba(200,169,81,.38);color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;white-space:nowrap;">
            <i class="ti ti-discount" style="font-size:12px;"></i> Fondateur -5%
          </div>
        {% endif %}
        {% if offer.isUnlimitedAccess %}
          <p style="margin:0 0 16px;padding:12px 14px;background:rgba(46,204,113,.06);border-left:3px solid var(--green);border-radius:8px;color:var(--text-soft);font-size:14px;line-height:1.55;">
            <i class="ti ti-info-circle" style="color:var(--green);"></i>
            <strong style="color:var(--white);">1 seul scan à l'accueil pour activer.</strong>
            Une fois activé, tu entres librement au club à vie — pas besoin de re-scanner ton QR à chaque visite.
          </p>
        {% endif %}
        {% if offer.description %}
          <p style="color:var(--text-soft);font-size:16px;line-height:1.8;white-space:pre-line;">{{ offer.description }}</p>
        {% else %}
          <p style="color:var(--text-soft);font-size:16px;line-height:1.8;">Offre limitée SPORT+ à réserver en ligne. Après paiement, conserve ton QR et présente-le à l'accueil.</p>
        {% endif %}
        {% if offer.maxQuantity %}
          <p style="margin-top:18px;color:var(--text-dim);"><i class="ti ti-ticket"></i> Places restantes : <strong style="color:var(--gold);">{{ offer.maxQuantity - offer.paidPurchasesCount }}</strong></p>
        {% endif %}
      </article>

      <aside class="form-card" style="padding:24px;position:sticky;top:96px;">
        {% if not offer.isCurrentlyAvailable %}
          <div class="alert alert-warning">Cette offre n'est plus disponible.</div>
        {% else %}
          <h3 style="font-family:'Barlow Condensed',sans-serif;font-size:26px;text-transform:uppercase;margin-bottom:8px;">Réserver maintenant</h3>
          <p style="color:var(--text-dim);font-size:14px;line-height:1.6;margin-bottom:18px;">
            Renseigne tes infos ci-dessous{{ offer.allowsOnSitePayment ? ' et choisis ton mode de paiement.' : ', tu seras redirigé vers Stripe. Le QR est généré après paiement validé.' }}
          </p>

          {# Formulaire unique. Le token _token change dynamiquement selon le
             mode choisi (Stripe / onsite) via JS. L'action du form aussi. #}
          <form method="post"
                action="{{ path('app_promo_offer_checkout', {slug: offer.slug}) }}"
                style="display:grid;gap:14px;"
                data-action-stripe="{{ path('app_promo_offer_checkout', {slug: offer.slug}) }}"
                data-action-onsite="{{ offer.allowsOnSitePayment ? path('app_promo_offer_reserve_onsite', {slug: offer.slug}) : '' }}"
                data-token-stripe="{{ csrf_token('promo-offer-' ~ offer.id) }}"
                data-token-onsite="{{ offer.allowsOnSitePayment ? csrf_token('promo-offer-onsite-' ~ offer.id) : '' }}">
            <input type="hidden" name="_token" value="{{ csrf_token('promo-offer-' ~ offer.id) }}">
            {# Pré-remplissage si un user est connecté — champs restent
               VISIBLES et MODIFIABLES (le client peut offrir la promo à
               quelqu'un et changer nom/email/tel pour cet achat). Le -5%
               reste basé sur $this->getUser() côté serveur, JAMAIS sur
               buyer_email (usurpation possible). #}
            <div class="form-group">
              <label>Nom complet</label>
              <input name="buyer_name" required maxlength="120" class="form-control" autocomplete="name"
                     value="{{ app.user ? app.user.nomComplet : '' }}">
            </div>
            <div class="form-group">
              <label>Email</label>
              <input name="buyer_email" type="email" required maxlength="180" class="form-control" autocomplete="email"
                     value="{{ app.user ? app.user.email : '' }}">
            </div>
            <div class="form-group">
              <label>Téléphone <span style="color:var(--text-dim);font-weight:400;">optionnel</span></label>
              <input name="buyer_phone" maxlength="30" class="form-control" autocomplete="tel"
                     value="{{ app.user and app.user.phone ? app.user.phone : '' }}">
            </div>

            {% if offer.allowsOnSitePayment %}
              {# Chips radios pour choisir le mode de paiement (Stripe / au club).
                 Style aligné sur les chips du tunnel booking : cases cliquables
                 pleine largeur, l'active a bordure or + fond translucide.
                 Le radio est visuellement caché mais reste focusable/accessible. #}
              <div style="display:grid;gap:10px;margin-top:4px;">
                <div style="font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);">
                  Mode de paiement
                </div>
                <label class="promo-pay-chip is-active">
                  <input type="radio" name="pay_mode" value="stripe" checked>
                  <span class="promo-pay-chip-icon"><i class="ti ti-brand-stripe"></i></span>
                  <span class="promo-pay-chip-body">
                    <span class="promo-pay-chip-name">En ligne (Stripe)</span>
                    <span class="promo-pay-chip-sub">Paiement carte sécurisé · QR immédiat après validation</span>
                  </span>
                  <span class="promo-pay-chip-check"><i class="ti ti-check"></i></span>
                </label>
                <label class="promo-pay-chip">
                  <input type="radio" name="pay_mode" value="onsite">
                  <span class="promo-pay-chip-icon"><i class="ti ti-cash"></i></span>
                  <span class="promo-pay-chip-body">
                    <span class="promo-pay-chip-name">Au club (espèces ou CB)</span>
                    <span class="promo-pay-chip-sub">Tu réserves ici, tu payes à l'accueil · QR envoyé par email après paiement</span>
                  </span>
                  <span class="promo-pay-chip-check"><i class="ti ti-check"></i></span>
                </label>
              </div>
            {% endif %}

            <button class="btn btn-primary btn-lg" type="submit" style="width:100%;" data-submit-btn>
              <i class="ti ti-lock" data-submit-icon></i> <span data-submit-label>Payer {{ effectivePriceLabel }} en ligne</span>
            </button>
            <p style="margin:0;color:var(--text-dim);font-size:12px;text-align:center;" data-submit-hint>
              <i class="ti ti-info-circle"></i> Paiement Stripe sécurisé · Aucun QR sans paiement confirmé.
            </p>
          </form>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

<style>
  /* ── Chips radios "Mode de paiement" ─────────────────────────────
     Case cliquable pleine largeur, style aligné sur le tunnel booking
     (chips Espèces / CB / Stripe). L'input radio est visuellement
     absorbé par la card, mais reste focusable clavier + accessible. */
  .promo-pay-chip {
    display: grid;
    grid-template-columns: 42px 1fr 22px;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: rgba(255,255,255,.02);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease, transform .12s ease;
    margin: 0;
  }
  .promo-pay-chip:hover {
    background: rgba(200,169,81,.06);
    border-color: rgba(200,169,81,.35);
  }
  .promo-pay-chip.is-active {
    border-color: var(--gold);
    background: rgba(200,169,81,.10);
    box-shadow: 0 0 0 3px rgba(200,169,81,.10);
  }
  .promo-pay-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .promo-pay-chip-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--bg-2, #101018);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dim);
    font-size: 20px;
    flex-shrink: 0;
  }
  .promo-pay-chip.is-active .promo-pay-chip-icon {
    background: rgba(200,169,81,.15);
    color: var(--gold);
  }
  .promo-pay-chip-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .promo-pay-chip-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .5px;
    text-transform: uppercase;
    color: var(--white);
  }
  .promo-pay-chip-sub {
    font-size: 12.5px;
    color: var(--text-dim);
    line-height: 1.35;
  }
  .promo-pay-chip-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    font-size: 14px;
    flex-shrink: 0;
    transition: all .15s ease;
  }
  .promo-pay-chip.is-active .promo-pay-chip-check {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--black);
  }
  /* Focus visible pour l'accessibilité clavier. */
  .promo-pay-chip:focus-within {
    outline: none;
    border-color: var(--gold);
  }

  @media (max-width: 820px) {
    .promo-offer-grid { grid-template-columns: 1fr !important; }
    .promo-offer-grid aside { position: static !important; }
  }
</style>

<script>
  // Synchronise l'action + le token _token + le label du bouton selon
  // le mode de paiement choisi via les chips radios. Zéro back-end à changer.
  (function() {
    var form = document.querySelector('form[data-action-stripe]');
    if (!form) return;
    var radios      = form.querySelectorAll('input[name="pay_mode"]');
    if (!radios.length) return; // Pas de chips (offre stripe-only), rien à faire
    var tokenInput  = form.querySelector('input[name="_token"]');
    var submitBtn   = form.querySelector('[data-submit-btn]');
    var submitLabel = form.querySelector('[data-submit-label]');
    var submitIcon  = form.querySelector('[data-submit-icon]');
    var submitHint  = form.querySelector('[data-submit-hint]');
    var priceStr    = {{ effectivePriceLabel|json_encode|raw }};

    function apply() {
      var chosen = form.querySelector('input[name="pay_mode"]:checked');
      var mode   = chosen ? chosen.value : 'stripe';

      form.querySelectorAll('.promo-pay-chip').forEach(function(chip) {
        var input = chip.querySelector('input[name="pay_mode"]');
        chip.classList.toggle('is-active', !!(input && input.checked));
      });

      if (mode === 'onsite') {
        form.action = form.dataset.actionOnsite || form.action;
        if (tokenInput) tokenInput.value = form.dataset.tokenOnsite || tokenInput.value;
        if (submitLabel) submitLabel.textContent = 'Réserver — je paye au club';
        if (submitIcon)  submitIcon.className = 'ti ti-cash';
        if (submitHint)  submitHint.innerHTML = '<i class="ti ti-info-circle"></i> Réservation enregistrée · Paiement espèces / CB au club · QR reçu par email après paiement.';
      } else {
        form.action = form.dataset.actionStripe || form.action;
        if (tokenInput) tokenInput.value = form.dataset.tokenStripe || tokenInput.value;
        if (submitLabel) submitLabel.textContent = 'Payer ' + priceStr + ' en ligne';
        if (submitIcon)  submitIcon.className = 'ti ti-lock';
        if (submitHint)  submitHint.innerHTML = '<i class="ti ti-info-circle"></i> Paiement Stripe sécurisé · Aucun QR sans paiement confirmé.';
      }
    }

    radios.forEach(function(r) { r.addEventListener('change', apply); });
    apply();
  })();
</script>
{% endblock %}
