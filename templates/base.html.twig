<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}SPORT+ — Coaching Premium Marseille{% endblock %}</title>
  {% block meta_description %}<meta name="description" content="SPORT+ — Coaching premium à Marseille. Coaching privé, duo ou groupe. Night Coach disponible dès 20h. 164 Chemin de Saint-Jean du Désert, 13005 Marseille.">{% endblock %}
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

  {# Open Graph #}
  {% block og_tags %}
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="SPORT+ Marseille">
  <meta property="og:locale"      content="fr_FR">
  <meta property="og:title"       content="{% block og_title %}SPORT+ — Coaching Premium Marseille{% endblock %}">
  <meta property="og:description" content="{% block og_description %}Coaching privé, duo ou groupe à Marseille. Night Coach disponible dès 20h, accès salle 24h/24.{% endblock %}">
  <meta property="og:url"         content="{{ app.request.uri }}">
  <meta property="og:image"       content="{{ app.request.schemeAndHttpHost ~ asset('img/club/club-1.jpg') }}">
  <meta name="twitter:card"       content="summary_large_image">
  <meta name="twitter:title"      content="{% block twitter_title %}SPORT+ — Coaching Premium{% endblock %}">
  <meta name="twitter:description" content="{% block twitter_description %}Coaching privé, duo ou groupe à Marseille.{% endblock %}">
  <meta name="twitter:image"      content="{{ app.request.schemeAndHttpHost ~ asset('img/club/club-1.jpg') }}">
  {% endblock %}

  <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Barlow+Condensed:wght@500;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css">
  {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/sportplus.css') }}">{% endblock %}
  {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="{{ path('app_home') }}" class="logo">
      <div class="logo-mark">S<span style="color:var(--gold)">+</span></div>
      <span class="logo-name">SPORT<span>+</span></span>
    </a>

    <!-- Nav desktop -->
    <nav class="main-nav" aria-label="Navigation principale">
      <a href="{{ path('app_home') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}">Accueil</a>
      <a href="{{ path('app_coachs_list') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_coachs_list' %}active{% endif %}">Coachs</a>
      <a href="{{ path('app_concept') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_concept' %}active{% endif %}">Concept</a>
      <a href="{{ path('app_tarifs') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_tarifs' %}active{% endif %}">Tarifs</a>
      <a href="{{ path('app_about') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_about' %}active{% endif %}">À propos</a>
      <a href="{{ path('app_faq') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_faq' %}active{% endif %}">FAQ</a>
      <a href="{{ path('app_contact') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_contact' %}active{% endif %}">Contact</a>
      <a href="{{ path('app_deciplus') }}" class="nav-link nav-link-deciplus {% if app.request.attributes.get('_route') == 'app_deciplus' %}active{% endif %}">
        <i class="ti ti-qrcode" style="font-size:14px;"></i> Deciplus
      </a>
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      {% if app.user %}
        <!-- CTA Réserver (pour non-coachs/non-admins) -->
        {% if not is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') %}
          <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-sm">
            <i class="ti ti-calendar-plus"></i> Réserver
          </a>
        {% endif %}
        {% if app.user.foundingClaim %}
          <span class="badge-founding-mini">{{ app.user.foundingClaim.foundingLabel }}</span>
        {% endif %}
        <!-- Avatar + dropdown -->
        <div style="position:relative;">
          {% set initials %}
            {%- set words = app.user.nomComplet|split(' ') -%}
            {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
          {% endset %}
          <button class="user-avatar" aria-haspopup="true" aria-expanded="false" title="{{ app.user.nomComplet }}">
            {{- initials -}}
          </button>
          <div class="user-dropdown" role="menu">
            <div class="dropdown-header">
              <div style="font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:700;color:var(--white);">{{ app.user.nomComplet }}</div>
              <div style="font-size:13px;color:var(--text-dim);margin-top:2px;">{{ app.user.email }}</div>
              {% if app.user.foundingClaim %}
                <div style="margin-top:6px;"><span class="badge-founding-mini">{{ app.user.foundingClaim.foundingLabel }}</span></div>
              {% endif %}
            </div>
            {% if is_granted('ROLE_ADMIN') %}
              <a href="{{ path('app_admin_dashboard') }}" class="dropdown-item" role="menuitem"><i class="ti ti-shield"></i> Administration</a>
            {% endif %}
            {% if is_granted('ROLE_COACH') %}
              <a href="{{ path('app_coach_dashboard') }}" class="dropdown-item" role="menuitem"><i class="ti ti-users"></i> Espace coach</a>
            {% else %}
              <a href="{{ path('app_espace_client') }}" class="dropdown-item" role="menuitem"><i class="ti ti-user"></i> Mon espace</a>
              <a href="{{ path('app_espace_client_profil') }}" class="dropdown-item" role="menuitem"><i class="ti ti-user-cog"></i> Mon profil</a>
            {% endif %}
            <a href="{{ path('app_conversation_inbox') }}" class="dropdown-item" role="menuitem">
              <i class="ti ti-message"></i> Messagerie
              {% set unread = unread_messages_count() %}
              {% if unread > 0 %}
                <span style="margin-left:auto;background:var(--green);color:var(--black);font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:1px;padding:2px 7px;border-radius:100px;">{{ unread }}</span>
              {% endif %}
            </a>
            <div class="dropdown-divider"></div>
            <a href="{{ path('app_logout') }}" class="dropdown-item danger" role="menuitem"><i class="ti ti-logout"></i> Déconnexion</a>
          </div>
        </div>
      {% else %}
        <a href="{{ path('app_login') }}" class="btn btn-ghost btn-sm header-connexion-btn">Connexion</a>
        <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm">Commencer</a>
      {% endif %}
      <!-- Burger mobile -->
      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <nav class="mobile-nav">
    <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
    <a href="{{ path('app_coachs_list') }}" class="nav-link">Coachs</a>
    <a href="{{ path('app_concept') }}" class="nav-link">Concept</a>
    <a href="{{ path('app_tarifs') }}" class="nav-link">Tarifs</a>
    <a href="{{ path('app_about') }}" class="nav-link">À propos</a>
    <a href="{{ path('app_faq') }}" class="nav-link">FAQ</a>
    <a href="{{ path('app_contact') }}" class="nav-link">Contact</a>
    <a href="{{ path('app_deciplus') }}" class="nav-link" style="color:var(--green);">
      <i class="ti ti-qrcode"></i> Deciplus
    </a>
  </nav>
  <div class="mobile-actions">
    {% if app.user %}
      {% if not is_granted('ROLE_COACH') and not is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-full">Réserver</a>
      {% endif %}
      {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary btn-full">Administration</a>
      {% elseif is_granted('ROLE_COACH') %}
        <a href="{{ path('app_coach_dashboard') }}" class="btn btn-secondary btn-full">Espace coach</a>
      {% else %}
        <a href="{{ path('app_espace_client') }}" class="btn btn-secondary btn-full">Mon espace</a>
      {% endif %}
      <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-full">Déconnexion</a>
    {% else %}
      <a href="{{ path('app_login') }}" class="btn btn-ghost btn-full">Connexion</a>
      <a href="{{ path('app_register') }}" class="btn btn-primary btn-full">Commencer</a>
    {% endif %}
  </div>
</div>

<!-- Flash messages -->
{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="container" style="margin-top:12px;">
      <div class="alert alert-{{ label }}">
        <i class="ti ti-{% if label == 'success' %}circle-check{% elseif label == 'error' %}alert-circle{% else %}info-circle{% endif %}"></i>
        {{ message }}
      </div>
    </div>
  {% endfor %}
{% endfor %}

<main>{% block body %}{% endblock %}</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="{{ path('app_home') }}" class="logo" style="margin-bottom:16px;display:inline-flex;">
          <div class="logo-mark">S<span style="color:var(--gold)">+</span></div>
          <span class="logo-name">SPORT<span>+</span></span>
        </a>
        <p style="font-size:14px;color:var(--text-dim);line-height:1.7;margin-top:12px;">Coaching premium à Marseille. Ton coach, quand tu veux, même à 4h du mat'.</p>
      </div>
      <div>
        <div class="footer-col-title">Services</div>
        <a href="{{ path('app_booking_new') }}" class="footer-link"><i class="ti ti-moon"></i> Night Coach</a>
        <a href="{{ path('app_booking_new') }}" class="footer-link"><i class="ti ti-users"></i> Small Group</a>
        <a href="{{ path('app_booking_new') }}" class="footer-link"><i class="ti ti-bolt"></i> Accès salle 24h</a>
        <a href="{{ path('app_tarifs') }}" class="footer-link"><i class="ti ti-coins"></i> Tarifs</a>
      </div>
      <div>
        <div class="footer-col-title">Contact</div>
        <div class="footer-link"><i class="ti ti-map-pin"></i> 164 Chemin de Saint-Jean du Désert, 13005 Marseille</div>
        <a href="tel:0491422207" class="footer-link"><i class="ti ti-phone"></i> 04 91 42 22 07</a>
        <div class="footer-link"><i class="ti ti-clock-24"></i> Ouvert 24h/24 — Sans engagement</div>
        <a href="{{ path('app_contact') }}" class="footer-link"><i class="ti ti-mail"></i> Nous contacter</a>
      </div>
      <div>
        <div class="footer-col-title">Suivez-nous</div>
        <a href="https://www.facebook.com/sportplus13005/?locale=fr_FR" target="_blank" rel="noopener noreferrer" class="footer-link"><i class="ti ti-brand-facebook"></i> Facebook</a>
        <a href="https://www.instagram.com/sportplus13005?igsh=dGd2NmVsY2JzMDF4" target="_blank" rel="noopener noreferrer" class="footer-link"><i class="ti ti-brand-instagram"></i> Instagram</a>
        <a href="https://www.linkedin.com/company/sport-13/" target="_blank" rel="noopener noreferrer" class="footer-link"><i class="ti ti-brand-linkedin"></i> LinkedIn</a>
        <a href="https://www.tiktok.com/@sizlo_personal_trainer" target="_blank" rel="noopener noreferrer" class="footer-link"><i class="ti ti-brand-tiktok"></i> TikTok</a>
        <a href="{{ path('app_deciplus') }}" class="footer-link"><i class="ti ti-qrcode"></i> Espace Deciplus</a>
        <div class="footer-col-title" style="margin-top:20px;">Légal</div>
        <a href="{{ path('app_about') }}" class="footer-link">À propos</a>
        <a href="{{ path('app_legal_mentions') }}" class="footer-link">Mentions légales</a>
        <a href="{{ path('app_legal_cgv') }}" class="footer-link">CGV</a>
        <a href="{{ path('app_legal_confidentialite') }}" class="footer-link">Confidentialité</a>
        <a href="{{ path('app_legal_cookies') }}" class="footer-link">Cookies</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="brand-slogan" style="padding:12px 0 0;">Pour le meilleur & pour le <span class="brand-plus">+</span></div>
    <div class="footer-bottom-inner container">
      <span>© {{ "now"|date("Y") }} SPORT+ Marseille — Coaching Premium</span>
      <span style="color:var(--gold);font-family:'Barlow Condensed',sans-serif;font-weight:700;letter-spacing:2px;">POUR LE MEILLEUR <span style="color:var(--green)">+</span></span>
    </div>
  </div>
</footer>

<script src="{{ asset('js/app.js') }}" defer></script>
{% block mercure %}{% endblock %}
</body>
</html>
