{% extends 'base.html.twig' %}

{% block title %}SPORT+ Marseille — Coaching privé, salle 24h/24 & Pilates Reformer{% endblock %}
{% block meta_description %}<meta name="description" content="Coaching privé à Marseille — Day Pass dès 40€, Night Coach dès 20h, salle 24h/24 & Pilates Reformer. 164 Chemin Saint-Jean du Désert, 13005.">{% endblock %}
{% block og_title %}SPORT+ Marseille — Coaching privé, salle 24h/24 & Pilates Reformer{% endblock %}
{% block og_description %}Coaching privé à Marseille, Night Coach dès 20h, accès salle 24h/24 et Pilates Reformer. Sans engagement.{% endblock %}
{% block preload_assets %}<link rel="preload" as="image" href="{{ asset('img/club-photos/cours-collectif-1.jpg') }}" fetchpriority="high">{% endblock %}

{% block body %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "SPORT+",
  "description": "Club de coaching privé à Marseille. Day Pass dès 40€, Night Coach dès 20h, accès salle 24h/24 et Pilates Reformer.",
  "url": "{{ app.request.schemeAndHttpHost }}",
  "telephone": "+33491422207",
  "openingHours": "Mo-Su 00:00-24:00",
  "priceRange": "35€ - 575€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "164 Chemin de Saint-Jean du Désert",
    "addressLocality": "Marseille",
    "postalCode": "13005",
    "addressCountry": "FR"
  },
  "areaServed": ["Marseille", "Marseille 13005", "Saint-Jean du Désert", "La Timone"],
  "makesOffer": [
    {"@type":"Offer","name":"Coaching privé SPORT+ Marseille","priceCurrency":"EUR","price":"40"},
    {"@type":"Offer","name":"Night Coach SPORT+ Marseille","priceCurrency":"EUR","price":"60"},
    {"@type":"Offer","name":"Pilates Reformer SPORT+ Marseille","priceCurrency":"EUR","price":"35"}
  ],
  "areaServed": ["Marseille", "Marseille 13005", "Saint-Jean du Désert", "La Timone"],
  "makesOffer": [
    {"@type":"Offer","name":"Coaching privé SPORT+ Marseille","priceCurrency":"EUR","price":"40"},
    {"@type":"Offer","name":"Night Coach SPORT+ Marseille","priceCurrency":"EUR","price":"60"},
    {"@type":"Offer","name":"Pilates Reformer SPORT+ Marseille","priceCurrency":"EUR","price":"35"}
  ],
  "sameAs": [
    "https://www.facebook.com/sportplus13005/?locale=fr_FR",
    "https://www.instagram.com/sportplus13005",
    "https://www.linkedin.com/company/sport-13/",
    "https://www.tiktok.com/@sizlo_personal_trainer"
  ]
}
</script>

{# ── HERO ── #}
<section class="hero">
  <div class="hero-bg-photo" style="background-image:url('{{ asset('img/club-photos/cours-collectif-1.jpg') }}');"></div>
  <div class="hero-noise" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge" data-animate="fade-down">Marseille — Ouvert 24h/24</div>
      <h1 class="hero-title">
        <span class="split-word" style="animation-delay:.1s;">Ton</span>
        <span class="split-word" style="animation-delay:.22s;">coach</span><br>
        <span class="split-word gold" style="animation-delay:.34s;">premium</span><br>
        <span class="split-word" style="animation-delay:.46s;">t'attend</span>
      </h1>
      <p class="hero-sub" data-animate="fade-up" style="transition-delay:.55s;">
        Coaching privé, small group ou accès salle. Sans engagement, sans compromis.
        Disponible même à 4h du matin.
      </p>
      <div class="hero-proof" data-stagger data-animate="fade-up" aria-label="Les engagements SPORT+">
        <span><i class="ti ti-shield-check"></i> Coachs certifiés</span>
        <span><i class="ti ti-clock-24"></i> Salle 24h/24</span>
        <span><i class="ti ti-lock-open"></i> Sans engagement</span>
      </div>
      <div data-animate="fade-up" style="margin-bottom:32px;">
        <div class="brand-pioneers">À jamais les pionniers</div>
        <div class="brand-slogan">Pour le meilleur & pour le <span class="brand-plus">+</span></div>
      </div>
      <div class="hero-actions">
        {% if app.user %}
          <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-lg">
            <i class="ti ti-calendar-plus"></i> Réserver une séance
          </a>
          <a href="{{ path('app_coachs_list') }}" class="btn btn-secondary btn-lg">
            Voir les coachs
          </a>
        {% else %}
          <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">
            <i class="ti ti-bolt"></i> Commencer maintenant
          </a>
          <a href="{{ path('app_coachs_list') }}" class="btn btn-secondary btn-lg">
            Voir les coachs
          </a>
        {% endif %}
      </div>
      <div class="hero-stats" data-stagger data-animate="fade-up" style="transition-delay:.7s;">
        <div class="stat-item">
          <span class="stat-value" data-counter="{{ coaches|length > 0 ? coaches|length : 10 }}" {% if coaches|length == 0 %}data-suffix="+"{% endif %}>0</span>
          <span class="stat-label">Coachs certifiés</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">24/7</span>
          <span class="stat-label">Disponibilité</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">0€</span>
          <span class="stat-label">Engagement</span>
        </div>
      </div>
    </div>

    <div class="hero-performance" data-animate="fade-left" aria-hidden="true">
      <div class="hero-orbit hero-orbit-one"></div>
      <div class="hero-orbit hero-orbit-two"></div>
      <div class="hero-performance-card">
        <div class="hero-performance-head">
          <span class="hero-live-dot"></span>
          Night performance
          <span>Marseille</span>
        </div>
        <div class="hero-performance-time">24<span>/7</span></div>
        <div class="hero-heartbeat">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="hero-performance-copy">Ton rythme. Ton coach.<br>Même quand la ville dort.</div>
        <div class="hero-performance-tags">
          <span>Solo</span><span>Duo</span><span>Groupe</span>
        </div>
      </div>
    </div>
  </div>
  <a href="#night-coach" class="hero-scroll-cue" aria-label="Découvrir le Night Coach">
    <span>Découvrir</span><i class="ti ti-arrow-down"></i>
  </a>
</section>

{# ── Founding Member teaser ── #}
{% set fo = foundingOffer ?? current_founding_offer() %}
{% if fo and (fo.isStillRunning or (app.user and app.user.foundingClaim)) %}
  <section class="home-founding-section">
    <div class="container">
      {% if app.user and app.user.foundingClaim %}
        {# Variante compacte réservée à la home : valoriser le statut après paiement. #}
        {% set foundingClaim = app.user.foundingClaim %}
        <div class="home-founding-welcome" data-animate="fade-up">
          <div class="home-founding-welcome-glow" aria-hidden="true"></div>
          <div class="home-founding-emblem" aria-hidden="true">
            <i class="ti ti-crown"></i>
          </div>

          <div class="home-founding-copy">
            <div class="home-founding-kicker">
              <span class="home-founding-live-dot"></span>
              Statut membre activé
            </div>
            <div class="home-founding-title-row">
              <div>
                <span class="home-founding-greeting">Bienvenue dans l'histoire SPORT+</span>
                <h2>{{ foundingClaim.foundingLabel }}</h2>
              </div>
              <span class="home-founding-badge"><i class="ti ti-rosette-discount-check"></i> Fondateur</span>
            </div>
            <p>Ta place est confirmée. Tes avantages fondateur sont disponibles directement depuis ton espace membre.</p>

            <div class="home-founding-benefits" aria-label="Avantages Membre Fondateur">
              <div class="home-founding-benefit">
                <i class="ti ti-barbell"></i>
                <span><strong>{{ foundingClaim.sessionsRemaining }}/{{ fo.sessionsIncluded }}</strong> séances restantes</span>
              </div>
              <div class="home-founding-benefit {{ foundingClaim.isBilanDone ? 'is-complete' : '' }}">
                <i class="ti {{ foundingClaim.isBilanDone ? 'ti-circle-check' : 'ti-calendar-event' }}"></i>
                <span><strong>Bilan forme</strong> {{ foundingClaim.isBilanDone ? 'effectué' : 'à programmer' }}</span>
              </div>
              {% if fo.includesPriorityNight %}
                <div class="home-founding-benefit is-night">
                  <i class="ti ti-moon-stars"></i>
                  <span><strong>Priorité</strong> Night Coach</span>
                </div>
              {% endif %}
            </div>
          </div>

          <div class="home-founding-action">
            <span>Ton aventure commence maintenant</span>
            <a href="{{ path('app_espace_client') }}" class="btn btn-primary">
              <i class="ti ti-layout-dashboard"></i> Ouvrir mon espace
            </a>
          </div>
        </div>
      {% elseif fo.hasPlacesLeft %}
        {# Carte commerciale propre à la home, inspirée de la mise en scène de la page Tarifs. #}
        <article class="home-founding-offer" data-animate="fade-up">
          <a href="{{ path('app_founding_detail') }}" class="home-founding-offer-media" aria-label="Découvrir l'offre Membre Fondateur">
            <img
              src="{{ asset('img/club-photos/portrait-souriante.jpg') }}"
              alt="Un membre SPORT+ heureux après son entraînement"
              loading="lazy"
              decoding="async"
            >
            <span class="home-founding-offer-shade" aria-hidden="true"></span>
            <span class="home-founding-offer-badge"><i class="ti ti-crown"></i> Offre lancement</span>
            <span class="home-founding-offer-photo-caption">
              <strong>Une place à part.</strong>
              <small>Parmi les {{ fo.totalPlaces }} premiers membres SPORT+</small>
            </span>
          </a>

          <div class="home-founding-offer-content">
            <div class="home-founding-offer-kicker">
              <span></span>
              Série limitée · {{ fo.placesRemaining }} places restantes
            </div>
            <h2>Deviens membre<br><em>fondateur</em></h2>
            <p class="home-founding-offer-lead">
              Rejoins les premiers à écrire l'histoire de SPORT+ avec une expérience coaching complète à tarif privilégié.
            </p>

            <div class="home-founding-offer-price">
              <div>
                <strong>{{ fo.price }}<sup>€</sup></strong>
                <span>pour {{ fo.sessionsIncluded }} séances</span>
              </div>
              <span class="home-founding-offer-value">Valeur {{ fo.regularPrice }}€</span>
            </div>

            <div class="home-founding-offer-benefits" aria-label="Avantages de l'offre Membre Fondateur">
              <span><i class="ti ti-check"></i> Bilan forme offert</span>
              <span><i class="ti ti-check"></i> Coaching personnalisé</span>
              {% if fo.includesPriorityNight %}
                <span><i class="ti ti-moon-stars"></i> Priorité Night Coach</span>
              {% endif %}
            </div>

            <div class="home-founding-offer-progress">
              <div class="home-founding-offer-progress-label">
                <span><strong>{{ fo.placesTaken }}</strong> membres déjà inscrits</span>
                <span>{{ fo.placesRemaining }} places disponibles</span>
              </div>
              <div class="home-founding-offer-progress-track" role="progressbar" aria-valuenow="{{ fo.placesTaken }}" aria-valuemin="0" aria-valuemax="{{ fo.totalPlaces }}" aria-label="Places Membre Fondateur réservées">
                <span style="width: {{ fo.progressPercent }}%;"></span>
              </div>
            </div>

            <div class="home-founding-offer-actions">
              <a href="{{ path('app_founding_detail') }}" class="btn btn-primary">
                Découvrir l'offre <i class="ti ti-arrow-right"></i>
              </a>
              <small><i class="ti ti-lock"></i> Paiement sécurisé par Stripe</small>
            </div>
          </div>
        </article>
      {% else %}
        {# Variante : complet #}
        <div class="home-founding-soldout" data-animate="fade-up">
          <span class="home-founding-soldout-icon"><i class="ti ti-crown"></i></span>
          <div>
            <span>Les {{ fo.totalPlaces }} places ont été attribuées</span>
            <h2>La promotion fondatrice est complète</h2>
            <p>Merci aux premiers membres qui écrivent l'histoire de SPORT+ avec nous.</p>
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{# ── NIGHT COACH — Bannière signature SPORT+ ── #}
