{% extends 'base.html.twig' %}

{% block title %}SPORT+ — Coaching Premium Marseille{% endblock %}
{% block meta_description %}<meta name="description" content="Coaching premium à Marseille — Day Pass dès 40€, Night Coach dès 20h, accès salle 24h/24. 164 Chemin Saint-Jean du Désert, 13005.">{% endblock %}
{% block og_title %}SPORT+ — Coaching Premium Marseille{% endblock %}
{% block og_description %}Day Pass dès 40€ · Night Coach 60€ · Astreinte 80€. Accès salle 24h/24 à Marseille. Sans engagement.{% endblock %}

{% block body %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": "SPORT+",
  "description": "Club de coaching premium à Marseille. Day Pass dès 40€. Night Coach dès 20h. Accès salle 24h/24.",
  "url": "{{ app.request.schemeAndHttpHost }}",
  "telephone": "+33491422207",
  "openingHours": "Mo-Su 00:00-24:00",
  "priceRange": "40€ - 575€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "164 Chemin de Saint-Jean du Désert",
    "addressLocality": "Marseille",
    "postalCode": "13005",
    "addressCountry": "FR"
  },
  "sameAs": [
    "https://www.facebook.com/sportplusmarseille",
    "https://www.instagram.com/sportplus_marseille"
  ]
}
</script>

{# ── HERO ── #}
<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge">Marseille — Ouvert 24h/24</div>
      <h1 class="hero-title">
        Ton coach<br><span class="gold">premium</span><br>t'attend
      </h1>
      <p class="hero-sub">
        Coaching privé, small group ou accès salle. Sans engagement, sans compromis.
        Disponible même à 4h du matin.
      </p>
      <div class="brand-slogan" style="opacity:.6;font-size:13px;margin-bottom:32px;">Pour le meilleur & pour le <span class="brand-plus">+</span></div>
      <div class="hero-actions">
        {% if app.user %}
          <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-lg">
            <i class="ti ti-calendar-plus"></i> Réserver une séance
          </a>
          <a href="{{ path('app_coachs_list') }}" class="btn btn-secondary btn-lg">
            Voir les coachs
          </a>
        {% else %}
          <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">
            <i class="ti ti-bolt"></i> Commencer maintenant
          </a>
          <a href="{{ path('app_coachs_list') }}" class="btn btn-secondary btn-lg">
            Voir les coachs
          </a>
        {% endif %}
      </div>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-value">{{ coaches|length > 0 ? coaches|length : '10+' }}</span>
          <span class="stat-label">Coachs certifiés</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">24/7</span>
          <span class="stat-label">Disponibilité</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">0€</span>
          <span class="stat-label">Engagement</span>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── Founding Member teaser ── #}
{% set fo = foundingOffer ?? current_founding_offer() %}
{% if fo and fo.isStillRunning %}
  <section style="padding:40px 0 0;">
    <div class="container">
      {% if app.user and app.user.foundingClaim %}
        {# Variante : déjà membre fondateur #}
        <div class="founding-teaser" style="cursor:default;">
          <div class="founding-title">{{ app.user.foundingClaim.foundingLabel }}</div>
          <div class="founding-sub">
            {{ app.user.foundingClaim.sessionsRemaining }}/{{ fo.sessionsIncluded }} séances incluses restantes
            · Bilan {{ app.user.foundingClaim.isBilanDone ? '✓ effectué' : 'à programmer' }}
          </div>
          <a href="{{ path('app_espace_client') }}" class="btn btn-secondary btn-sm">Voir mon espace →</a>
        </div>
      {% elseif fo.hasPlacesLeft %}
        {# Variante : places disponibles #}
        <a href="{{ path('app_founding_detail') }}" class="founding-teaser">
          <span class="badge-launch">Offre Lancement</span>
          <div class="founding-title">Devenez Membre Fondateur</div>
          <div class="founding-sub">3 séances pour {{ fo.price }}€ · Bilan forme offert · Valeur {{ fo.regularPrice }}€</div>
          <div class="founding-progress-bar">
            <div class="founding-progress-fill" style="width:{{ fo.progressPercent }}%;"></div>
          </div>
          <div class="founding-progress-label">{{ fo.placesTaken }} / {{ fo.totalPlaces }} membres fondateurs</div>
          <div class="founding-teaser-footer">Voir l'offre complète →</div>
        </a>
      {% else %}
        {# Variante : complet #}
        <div class="founding-teaser" style="border-left-color:var(--border);cursor:default;">
          <div class="founding-title" style="color:var(--text-dim);">Offre lancement complète</div>
          <div class="founding-sub">Merci aux {{ fo.totalPlaces }} premiers fondateurs.</div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{# ── POURQUOI SPORT+ ── #}
<section class="section" style="background:var(--bg-2);">
  <div class="container">
    <div style="text-align:center;">
      <div class="section-badge">Notre différence</div>
    </div>
    <h2 class="section-title">Pourquoi <span style="color:var(--gold)">SPORT+</span></h2>
    <p class="section-sub">Une approche premium du coaching sportif, pensée pour les exigeants.</p>
    <div class="cards-grid">
      <div class="feature-card">
        <div class="feature-icon"><i class="ti ti-bolt"></i></div>
        <div class="feature-title">Performance sans compromis</div>
        <p class="feature-text">Des coachs certifiés, des programmes sur-mesure, des résultats mesurables. Chaque séance est conçue pour te faire progresser.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="ti ti-clock"></i></div>
        <div class="feature-title">Disponible 24h/24</div>
        <p class="feature-text">Night Coach dès 20h, accès salle à toute heure. Ton emploi du temps ne dicte plus ta progression.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><i class="ti ti-shield-check"></i></div>
        <div class="feature-title">Zéro engagement</div>
        <p class="feature-text">Réserve quand tu veux, annule jusqu'à 2h avant sans frais. Tu paies uniquement si le coach confirme.</p>
      </div>
    </div>
  </div>
</section>

{# ── NOS PRESTATIONS ── #}
<section class="section">
  <div class="container">
    <div style="text-align:center;">
      <div class="section-badge">Nos offres</div>
    </div>
    <h2 class="section-title">Nos <span style="color:var(--gold)">Prestations</span></h2>
    <p class="section-sub">Un Day Pass à l'unité ou des packs mensuels — sans engagement, sans compromis.</p>
    {# ── 3 Day Pass ── #}
    <div class="cards-grid" style="margin-bottom:20px;">

      <div class="service-card">
        <div class="service-icon"><i class="ti ti-sun"></i></div>
        <div class="service-name">Day Pass Journée</div>
        <div class="service-price">40 € / séance</div>
        <p class="service-desc">Coaching privé en journée, de 6h à 20h. Séance à l'unité, sans abonnement.</p>
        <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-outline">Réserver</a>
      </div>

      <div class="service-card" style="border-left:3px solid var(--green);position:relative;">
        <div style="position:absolute;top:-1px;right:16px;background:var(--green);color:var(--black);
                    font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;
                    letter-spacing:2px;text-transform:uppercase;padding:4px 10px;
                    border-radius:0 0 8px 8px;">Signature SPORT+</div>
        <div class="service-icon" style="background:rgba(61,255,20,.08);border-color:rgba(61,255,20,.2);color:var(--green);">
          <i class="ti ti-moon"></i>
        </div>
        <div class="service-name">Day Pass Night</div>
        <div class="service-price">60 € / séance</div>
        <p class="service-desc">Coaching privé dès 20h jusqu'à minuit. Pour ceux qui vivent la nuit.</p>
        <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-outline">Réserver</a>
      </div>

      <div class="service-card">
        <div class="service-icon"><i class="ti ti-moon-stars"></i></div>
        <div class="service-name">Day Pass Astreinte</div>
        <div class="service-price">80 € / séance</div>
        <p class="service-desc">Coaching de minuit à 6h du matin. La formule ultime pour les emplois du temps les plus décalés.</p>
        <a href="{{ app.user ? path('app_booking_new') : path('app_register') }}" class="btn btn-outline">Réserver</a>
      </div>

    </div>

    {# ── Packs mensuels — pleine largeur ── #}
    <div class="service-card" style="display:flex;align-items:center;justify-content:space-between;
                gap:32px;flex-wrap:wrap;border-left:3px solid var(--gold);">
      <div style="display:flex;align-items:center;gap:20px;flex:1;min-width:220px;">
        <div class="service-icon" style="flex-shrink:0;"><i class="ti ti-calendar-repeat"></i></div>
        <div>
          <div class="service-name" style="text-align:left;">Packs Mensuels</div>
          <div class="service-price" style="text-align:left;">dès 60 € / mois</div>
          <p class="service-desc" style="text-align:left;margin:8px 0 0;">
            Solo, Duo ou Groupe — 4, 8 ou 12 séances / mois. Jusqu'à <strong style="color:var(--gold);">30% de réduction</strong> sur le tarif à l'unité.
          </p>
        </div>
      </div>
      <a href="{{ path('app_tarifs') }}" class="btn btn-primary" style="flex-shrink:0;">
        <i class="ti ti-arrow-right"></i> Voir tous les tarifs
      </a>
    </div>
  </div>
</section>

{# ── NOS COACHS ── #}
<section class="section" style="background:var(--bg-2);">
  <div class="container">
    <div style="text-align:center;">
      <div class="section-badge">L'équipe</div>
    </div>
    <h2 class="section-title">Nos <span style="color:var(--gold)">Coachs</span></h2>
    <p class="section-sub">Des professionnels certifiés, passionnés, disponibles pour toi.</p>
    {% if coaches is empty %}
      <div class="empty-placeholder">Nos coachs arrivent bientôt.</div>
    {% else %}
      <div class="cards-grid">
        {% for coach in coaches %}
          <div class="coach-card">
            <div class="coach-avatar">
              {%- set words = coach.nomComplet|split(' ') -%}
              {{- words[0]|first|upper -}}{%- if words|length > 1 -%}{{- words[1]|first|upper -}}{%- endif -%}
            </div>
            <div class="coach-name">{{ coach.nomComplet }}</div>
            <div class="coach-specialty">{{ coach.specialtiesLabel }}</div>
            <div class="coach-price">{{ coach.prixFormatted }}</div>
            <a href="{{ app.user ? path('app_booking_new') : path('app_login') }}" class="btn btn-secondary btn-full coach-action">
              <i class="ti ti-calendar-plus"></i> Réserver
            </a>
          </div>
        {% endfor %}
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a href="{{ path('app_coachs_list') }}" class="btn btn-outline">Voir tous les coachs</a>
      </div>
    {% endif %}
  </div>
</section>

{# ── FAQ ── #}
<section class="section">
  <div class="container">
    <div style="text-align:center;">
      <div class="section-badge">Questions fréquentes</div>
    </div>
    <h2 class="section-title">Tout ce que tu veux <span style="color:var(--gold)">savoir</span></h2>
    <p class="section-sub">Les réponses aux questions qu'on nous pose le plus souvent.</p>
    <div style="max-width:720px;margin:0 auto;">
      <div class="faq-list">
        <details class="faq-item">
          <summary>Y a-t-il un engagement ?</summary>
          <div class="faq-answer">Non. Toutes nos formules sont sans engagement. Vous réservez quand vous voulez, annulez jusqu'à 2h avant sans frais.</div>
        </details>
        <details class="faq-item">
          <summary>Comment fonctionne le Night Coach ?</summary>
          <div class="faq-answer">Vous réservez votre créneau dès 20h. Un coach dédié vous attend en salle. Solo, duo ou groupe jusqu'à 6 personnes.</div>
        </details>
        <details class="faq-item">
          <summary>Je dois former mon groupe moi-même ?</summary>
          <div class="faq-answer">Oui. Vous constituez votre groupe (amis, collègues, famille). Nous ne mixons pas des inconnus pour garantir votre confort et votre progression.</div>
        </details>
        <details class="faq-item">
          <summary>Quand est-ce que je paye ?</summary>
          <div class="faq-answer">Uniquement si le coach confirme votre réservation. Aucun prélèvement tant que la séance n'est pas validée.</div>
        </details>
        <details class="faq-item">
          <summary>Puis-je changer de coach ?</summary>
          <div class="faq-answer">Absolument. Chaque réservation est indépendante, vous choisissez votre coach à chaque séance.</div>
        </details>
      </div>
      <div style="text-align:center;margin-top:32px;">
        <a href="{{ path('app_faq') }}" class="link-gold">Voir toutes les FAQ →</a>
      </div>
    </div>
  </div>
</section>

{# ── CTA BOTTOM ── #}
<section class="section" style="background:var(--bg-2);text-align:center;">
  <div class="container">
    <div class="hero-badge" style="margin-bottom:24px;">Prêt à commencer ?</div>
    <h2 class="section-title">Réserve ta<br><span style="color:var(--gold)">première séance</span></h2>
    <p class="section-sub">Sans engagement, sans risque. Juste toi et ton coach.</p>
    <div class="hero-actions">
      {% if app.user %}
        <a href="{{ path('app_booking_new') }}" class="btn btn-primary btn-lg">
          <i class="ti ti-calendar-plus"></i> Réserver maintenant
        </a>
      {% else %}
        <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">
          <i class="ti ti-bolt"></i> Créer mon compte
        </a>
        <a href="{{ path('app_login') }}" class="btn btn-secondary btn-lg">
          Se connecter
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% endblock %}
